<form method="post" id="deleteDocumentForm" action="/Vehicle/DeleteDocument/0" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="vehicleId" value="@Model.SelectedVehicleId" />
    <input type="hidden" name="activeTab" value="@activeTab" />
</form>

<form method="post" id="deleteTireForm" action="/Vehicle/DeleteTire/0" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="vehicleId" value="@Model.SelectedVehicleId" />
</form>

@section Styles {
<style>
    /* Yalnızca Araç Belgeleri sayfasına özel araç seçici Select2 kaydırma stili */
    .vdoc-vehicle-select-dropdown .select2-results > .select2-results__options,
    .vdoc-vehicle-select-dropdown .select2-results__options {
        max-height: 350px !important;
        overflow-y: auto !important;
        -webkit-overflow-scrolling: touch;
    }

    /* Dört sekmenin (Muayene, Trafik Sigortası, Kasko, Lastik) kayıt tabloları için dikey kaydırma ve sabit başlık */
    .vdoc-tab-table-scroll {
        max-height: 400px;
        overflow-y: auto;
        overflow-x: auto;
        position: relative;
        -webkit-overflow-scrolling: touch;
    }

    .vdoc-tab-table-scroll table thead th {
        position: sticky;
        top: 0;
        z-index: 5;
        background-color: #f8f9fa;
        box-shadow: inset 0 -1px 0 #dee2e6;
    }
</style>
}

@section Scripts {
<script>
    function openEditModal(id, vehicleId, docType, start, end, cost, policyNo, company, notes) {
        $('#editDocumentForm').attr('action', '/Vehicle/UpdateDocument/' + id);
        if (vehicleId) {
            $('#editDocVehicleId').val(vehicleId);
        }
        $('#editDocumentType').val(docType);
        $('#editStartDate').val(start);
        $('#editEndDate').val(end);
        $('#editCost').val(cost || 0);
        $('#editPolicyOrStationNumber').val(policyNo || '');
        $('#editCompanyName').val(company || '');
        $('#editNotes').val(notes || '');
        $('#editDocumentModal').modal('show');
    }

    function confirmDeleteDocument(id, desc) {
        if (confirm(desc + ' kaydını silmek istediğinize emin misiniz?')) {
            $('#deleteDocumentForm').attr('action', '/Vehicle/DeleteDocument/' + id);
            $('#deleteDocumentForm').submit();
        }
    }

    function openEditTireModal(id, vehicleId, brand, size, dot, season, installedDate, installedKm, recKm, recDate, cost, notes) {
        $('#editTireForm').attr('action', '/Vehicle/UpdateTire/' + id);
        if (vehicleId) {
            $('#editTireVehicleId').val(vehicleId);
        }
        $('#editTireBrand').val(brand || '');
        $('#editTireSize').val(size || '');
        $('#editTireDotDate').val(dot || '');
        if (season && $('#editTireSeason option[value="' + season + '"]').length === 0) {
            $('#editTireSeason').append(new Option(season + ' (Pasif)', season, true, true));
        }
        $('#editTireSeason').val(season || '');
        $('#editTireInstalledDate').val(installedDate || '');
        $('#editTireInstalledKm').val(installedKm || '');
        $('#editTireRecommendedReplaceKm').val(recKm || '');
        $('#editTireRecommendedReplaceDate').val(recDate || '');
        $('#editTireCost').val(cost || 0);
        $('#editTireNotes').val(notes || '');
        $('#editTireModal').modal('show');
    }

    function confirmDeleteTire(id, desc) {
        if (confirm(desc + ' lastik kaydını silmek istediğinize emin misiniz?')) {
            $('#deleteTireForm').attr('action', '/Vehicle/DeleteTire/' + id);
            $('#deleteTireForm').submit();
        }
    }

    $(document).ready(function () {
        // Araç seçme açılır listesi: Select2 ile aranabilir ve 350px max-height kaydırılabilir liste
        var $vehicleSelect = $('#vehicleDocumentSelect');
        if ($vehicleSelect.length && $.fn.select2) {
            $vehicleSelect.select2({
                width: '100%',
                dropdownCssClass: 'vdoc-vehicle-select-dropdown',
                language: {
                    noResults: function () {
                        return 'Eşleşen araç bulunamadı';
                    },
                    searching: function () {
                        return 'Aranıyor...';
                    }
                },
                matcher: function (params, data) {
                    if ($.trim(params.term) === '') {
                        return data;
                    }
                    if (typeof data.text === 'undefined') {
                        return null;
                    }
                    var term = params.term.toLocaleLowerCase('tr-TR');
                    var text = data.text.toLocaleLowerCase('tr-TR');
                    return text.indexOf(term) > -1 ? data : null;
                }
            }).on('select2:open', function () {
                setTimeout(function () {
                    var searchInput = document.querySelector('.vdoc-vehicle-select-dropdown .select2-search__field');
                    if (searchInput) {
                        searchInput.placeholder = 'Plaka veya marka/model ara...';
                        searchInput.focus();
                    }
                }, 0);
            });
        }

        $vehicleSelect.on('change', function () {
            $('#vehicleSelectForm').submit();
        });

        $(document).on('click', '.btn-edit-document', function () {
            var $btn = $(this);
            openEditModal(
                $btn.attr('data-id'),
                $btn.attr('data-vehicle-id'),
                $btn.attr('data-doc-type'),
                $btn.attr('data-start-date'),
                $btn.attr('data-end-date'),
                $btn.attr('data-cost'),
                $btn.attr('data-policy'),
                $btn.attr('data-company'),
                $btn.attr('data-notes')
            );
        });

        $(document).on('click', '.btn-delete-document', function () {
            var $btn = $(this);
            confirmDeleteDocument($btn.attr('data-id'), $btn.attr('data-desc'));
        });

        $(document).on('click', '.btn-edit-tire', function () {
            var $btn = $(this);
            openEditTireModal(
                $btn.attr('data-id'),
                $btn.attr('data-vehicle-id'),
                $btn.attr('data-brand'),
                $btn.attr('data-size'),
                $btn.attr('data-dot'),
                $btn.attr('data-season'),
                $btn.attr('data-installed-date'),
                $btn.attr('data-installed-km'),
                $btn.attr('data-rec-km'),
                $btn.attr('data-rec-date'),
                $btn.attr('data-cost'),
                $btn.attr('data-notes')
            );
        });

        $(document).on('click', '.btn-delete-tire', function () {
            var $btn = $(this);
            confirmDeleteTire($btn.attr('data-id'), $btn.attr('data-desc'));
        });
    });
</script>
}

