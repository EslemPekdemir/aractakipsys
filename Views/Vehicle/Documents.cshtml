@model aractakipsys.Models.ViewModels.Vehicle.VehicleDocumentsPageViewModel
@using aractakipsys.Models.Enums
@inject aractakipsys.Services.Interfaces.ISystemDefinitionService SystemDefinitionService
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Araç Belgeleri (Muayene, Trafik Sigortası, Kasko)";
    var activeTab = Model.ActiveTab;
    var activeSeasons = await SystemDefinitionService.GetActiveOptionNamesAsync(aractakipsys.Common.SystemDefinitionCategories.TireSeason);
}

<div class="row wrapper border-bottom white-bg page-heading mb-4">
    <div class="col-lg-8">
        <h2 class="font-weight-bold">Araç Belgeleri Takip ve Yönetim Paneli</h2>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/Vehicle">Araçlar</a></li>
            <li class="breadcrumb-item active"><strong>Araç Belgeleri</strong></li>
        </ol>
    </div>
    <div class="col-lg-4 text-right d-flex align-items-center justify-content-end">
        @if (Model.SelectedVehicle != null || (Model.IsAllVehicles && Model.TotalVehicleCount > 0))
        {
            <button type="button" class="btn btn-primary shadow-sm" data-toggle="modal" data-target="#addDocumentModal">
                <i class="fa fa-plus mr-1"></i> Yeni Belge Kaydı Ekle
            </button>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="fa fa-check-circle mr-1"></i> @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i class="fa fa-exclamation-triangle mr-1"></i> @TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<!-- ARAÇ SEÇİM KARTI -->
<div class="card shadow-sm border-0 mb-4" style="border-radius: 10px;">
    <div class="card-body p-3 bg-light" style="border-radius: 10px;">
        <form method="get" action="/Vehicle/Documents" id="vehicleSelectForm" class="row align-items-center">
            <input type="hidden" name="activeTab" value="@activeTab" id="hiddenActiveTab" />
            <div class="col-12 col-md-3 mb-2 mb-md-0 font-weight-bold text-dark">
                <i class="fa fa-car mr-1 text-primary"></i> İşlem Yapılacak Aracı Seçin:
            </div>
            <div class="col-12 col-md-6 mb-2 mb-md-0">
                <select name="vehicleId" id="vehicleDocumentSelect" class="form-control select2 vdoc-vehicle-select">
                    @foreach (var item in Model.VehicleSelectList)
                    {
                        <option value="@item.Value" selected="@(item.Selected ? "selected" : null)">@item.Text</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-3 text-right">
                @if (Model.SelectedVehicle != null)
                {
                    <a href="/Vehicle/Details/@Model.SelectedVehicle.Id" class="btn btn-outline-secondary btn-sm" title="Araç Detayını Gör">
                        <i class="fa fa-external-link mr-1"></i> Araç Kartı
                    </a>
                }
            </div>
        </form>
    </div>
</div>

@if (!Model.IsAllVehicles && Model.SelectedVehicle == null)
{
    <div class="card shadow-sm text-center py-5">
        <div class="card-body">
            <i class="fa fa-car text-muted mb-3" style="font-size: 3rem;"></i>
            <h5 class="text-secondary font-weight-bold">Kayıtlı Araç Bulunmuyor</h5>
            <p class="text-muted">Belge işlemlerini görüntülemek için önce araç kaydı oluşturunuz.</p>
        </div>
    </div>
}
else
{
    @if (Model.IsAllVehicles)
    {
        <!-- TÜM ARAÇLAR ÖZET KÜNYESİ -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card shadow-sm border-0" style="border-radius: 10px; border-left: 5px solid #1ab394 !important;">
                    <div class="card-body py-3 px-4 d-flex justify-content-between align-items-center flex-wrap" style="gap: 15px;">
                        <div>
                            <h4 class="font-weight-bold text-primary mb-1">
                                Tüm Araçlar
                                <span class="text-dark font-weight-normal ml-2" style="font-size: 1.05rem;">(@Model.TotalVehicleCount Aktif Araç)</span>
                            </h4>
                            <div class="text-muted small">
                                Filodaki tüm araçlara ait muayene, trafik sigortası, kasko ve lastik kayıtları birlikte listelenmektedir.
                            </div>
                        </div>
                        <div class="d-flex align-items-center flex-wrap" style="gap: 10px;">
                            <div class="text-center p-2 rounded bg-light border" style="min-width: 120px;">
                                <small class="text-muted d-block font-weight-bold">MUAYENE</small>
                                <span class="font-weight-bold text-primary">@Model.InspectionDocuments.Count Kayıt</span>
                            </div>
                            <div class="text-center p-2 rounded bg-light border" style="min-width: 120px;">
                                <small class="text-muted d-block font-weight-bold">SİGORTA</small>
                                <span class="font-weight-bold text-primary">@Model.InsuranceDocuments.Count Kayıt</span>
                            </div>
                            <div class="text-center p-2 rounded bg-light border" style="min-width: 120px;">
                                <small class="text-muted d-block font-weight-bold">KASKO</small>
                                <span class="font-weight-bold text-primary">@Model.KaskoDocuments.Count Kayıt</span>
                            </div>
                            <div class="text-center p-2 rounded bg-light border" style="min-width: 120px;">
                                <small class="text-muted d-block font-weight-bold">LASTİK</small>
                                <span class="font-weight-bold text-primary">@Model.TireDocuments.Count Kayıt</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (Model.SelectedVehicle != null)
    {
    <!-- SEÇİLİ ARAÇ ÖZET KÜNYESİ -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0" style="border-radius: 10px; border-left: 5px solid #1ab394 !important;">
                <div class="card-body py-3 px-4 d-flex justify-content-between align-items-center flex-wrap" style="gap: 15px;">
                    <div>
                        <h4 class="font-weight-bold text-primary mb-1">
                            @Model.SelectedVehicle.PlateNumber
                            <span class="text-dark font-weight-normal ml-2" style="font-size: 1.1rem;">@Model.SelectedVehicle.Brand @Model.SelectedVehicle.Model (@Model.SelectedVehicle.Year)</span>
                        </h4>
                        <div class="text-muted small">
                            <span class="mr-3"><i class="fa fa-tachometer mr-1"></i> Güncel KM: <strong>@Model.SelectedVehicle.CurrentKm.ToString("N0") km</strong></span>
                            <span class="mr-3"><i class="fa fa-tag mr-1"></i> Tür: <strong>@Model.SelectedVehicle.VehicleType</strong></span>
                            <span><i class="fa fa-info-circle mr-1"></i> Durum: <span class="badge @Model.SelectedVehicle.StatusBadgeClass">@Model.SelectedVehicle.StatusDisplayName</span></span>
                        </div>
                    </div>
                    <div class="d-flex align-items-center" style="gap: 10px;">
                        <!-- Güncel Muayene Özeti -->
                        <div class="text-center p-2 rounded bg-light border" style="min-width: 140px;">
                            <small class="text-muted d-block font-weight-bold">GÜNCEL MUAYENE</small>
                            @if (Model.CurrentInspection != null)
                            {
                                <span class="font-weight-bold @(Model.CurrentInspection.Status == VehicleDocumentStatus.Expired ? "text-danger" : Model.CurrentInspection.Status == VehicleDocumentStatus.ExpiringSoon ? "text-warning" : Model.CurrentInspection.Status == VehicleDocumentStatus.NotStarted ? "text-info" : "text-success")">
                                    @Model.CurrentInspection.EndDate.ToString("dd.MM.yyyy")
                                </span>
                                @if (Model.CurrentInspection.Status == VehicleDocumentStatus.Expired)
                                {
                                    <small class="text-danger d-block font-weight-bold">Süresi Dolmuş</small>
                                }
                                else if (Model.CurrentInspection.Status == VehicleDocumentStatus.ExpiringSoon)
                                {
                                    <small class="text-warning d-block font-weight-bold">@Model.CurrentInspection.DaysRemaining gün kaldı</small>
                                }
                                else if (Model.CurrentInspection.Status == VehicleDocumentStatus.NotStarted)
                                {
                                    <small class="text-info d-block font-weight-bold">Başlamadı</small>
                                }
                                else
                                {
                                    <small class="text-success d-block font-weight-bold">Geçerli</small>
                                }
                            }
                            else
                            {
                                <span class="text-muted small">Kayıt Yok</span>
                            }
                        </div>
                        <!-- Güncel Sigorta Özeti -->
                        <div class="text-center p-2 rounded bg-light border" style="min-width: 140px;">
                            <small class="text-muted d-block font-weight-bold">GÜNCEL SİGORTA</small>
                            @if (Model.CurrentInsurance != null)
                            {
                                <span class="font-weight-bold @(Model.CurrentInsurance.Status == VehicleDocumentStatus.Expired ? "text-danger" : Model.CurrentInsurance.Status == VehicleDocumentStatus.ExpiringSoon ? "text-warning" : Model.CurrentInsurance.Status == VehicleDocumentStatus.NotStarted ? "text-info" : "text-success")">
                                    @Model.CurrentInsurance.EndDate.ToString("dd.MM.yyyy")
                                </span>
                                @if (Model.CurrentInsurance.Status == VehicleDocumentStatus.Expired)
                                {
                                    <small class="text-danger d-block font-weight-bold">Süresi Dolmuş</small>
                                }
                                else if (Model.CurrentInsurance.Status == VehicleDocumentStatus.ExpiringSoon)
                                {
                                    <small class="text-warning d-block font-weight-bold">@Model.CurrentInsurance.DaysRemaining gün kaldı</small>
                                }
                                else if (Model.CurrentInsurance.Status == VehicleDocumentStatus.NotStarted)
                                {
                                    <small class="text-info d-block font-weight-bold">Başlamadı</small>
                                }
                                else
                                {
                                    <small class="text-success d-block font-weight-bold">Geçerli</small>
                                }
                            }
                            else
                            {
                                <span class="text-muted small">Kayıt Yok</span>
                            }
                        </div>
                        <!-- Güncel Kasko Özeti -->
                        <div class="text-center p-2 rounded bg-light border" style="min-width: 140px;">
                            <small class="text-muted d-block font-weight-bold">GÜNCEL KASKO</small>
                            @if (Model.CurrentKasko != null)
                            {
                                <span class="font-weight-bold @(Model.CurrentKasko.Status == VehicleDocumentStatus.Expired ? "text-danger" : Model.CurrentKasko.Status == VehicleDocumentStatus.ExpiringSoon ? "text-warning" : Model.CurrentKasko.Status == VehicleDocumentStatus.NotStarted ? "text-info" : "text-success")">
                                    @Model.CurrentKasko.EndDate.ToString("dd.MM.yyyy")
                                </span>
                                @if (Model.CurrentKasko.Status == VehicleDocumentStatus.Expired)
                                {
                                    <small class="text-danger d-block font-weight-bold">Süresi Dolmuş</small>
                                }
                                else if (Model.CurrentKasko.Status == VehicleDocumentStatus.ExpiringSoon)
                                {
                                    <small class="text-warning d-block font-weight-bold">@Model.CurrentKasko.DaysRemaining gün kaldı</small>
                                }
                                else if (Model.CurrentKasko.Status == VehicleDocumentStatus.NotStarted)
                                {
                                    <small class="text-info d-block font-weight-bold">Başlamadı</small>
                                }
                                else
                                {
                                    <small class="text-success d-block font-weight-bold">Geçerli</small>
                                }
                            }
                            else
                            {
                                <span class="text-muted small">Kayıt Yok</span>
                            }
                        </div>
                        <!-- Güncel Lastik Özeti -->
                        <div class="text-center p-2 rounded bg-light border" style="min-width: 140px;">
                            <small class="text-muted d-block font-weight-bold">GÜNCEL LASTİK</small>
                            @if (Model.CurrentTire != null)
                            {
                                <span class="font-weight-bold @(Model.CurrentTire.Status == aractakipsys.Models.Enums.TireStatus.Critical ? "text-danger" : Model.CurrentTire.Status == aractakipsys.Models.Enums.TireStatus.Approaching ? "text-warning" : Model.CurrentTire.Status == aractakipsys.Models.Enums.TireStatus.Normal ? "text-success" : "text-secondary")">
                                    @Model.CurrentTire.Brand (@Model.CurrentTire.SeasonDisplay)
                                </span>
                                <small class="text-muted d-block font-italic">@Model.CurrentTire.DotDateDisplay</small>
                            }
                            else
                            {
                                <span class="text-muted small">Kayıt Yok</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    }

    <!-- 4 SEKMELİ BELGE ALANI: Muayene | Trafik Sigortası | Kasko | Lastik -->
    <div class="card shadow-sm border-0" style="border-radius: 10px;">
        <div class="card-header bg-white border-bottom p-0" style="border-radius: 10px 10px 0 0;">
            <ul class="nav nav-tabs border-0" id="documentTabs" role="tablist">
                <li class="nav-item">
                    <a class="nav-link font-weight-bold py-3 px-4 @(activeTab == "Inspection" ? "active text-primary" : "text-secondary")" 
                       id="inspection-tab" data-toggle="tab" href="#inspectionTabPane" role="tab"
                       onclick="$('#hiddenActiveTab').val('Inspection'); $('#modalDocumentType').val('Inspection');">
                        <i class="fa fa-wrench mr-2"></i> Fenni Muayene
                        <span class="badge badge-pill @(Model.InspectionDocuments.Any(d => d.IsExpired) ? "badge-danger" : "badge-secondary") ml-1">
                            @Model.InspectionDocuments.Count
                        </span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link font-weight-bold py-3 px-4 @(activeTab == "Insurance" ? "active text-primary" : "text-secondary")" 
                       id="insurance-tab" data-toggle="tab" href="#insuranceTabPane" role="tab"
                       onclick="$('#hiddenActiveTab').val('Insurance'); $('#modalDocumentType').val('Insurance');">
                        <i class="fa fa-shield mr-2"></i> Trafik Sigortası
                        <span class="badge badge-pill @(Model.InsuranceDocuments.Any(d => d.IsExpired) ? "badge-danger" : "badge-secondary") ml-1">
                            @Model.InsuranceDocuments.Count
                        </span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link font-weight-bold py-3 px-4 @(activeTab == "Kasko" ? "active text-primary" : "text-secondary")" 
                       id="kasko-tab" data-toggle="tab" href="#kaskoTabPane" role="tab"
                       onclick="$('#hiddenActiveTab').val('Kasko'); $('#modalDocumentType').val('Kasko');">
                        <i class="fa fa-car mr-2"></i> Kasko
                        <span class="badge badge-pill @(Model.KaskoDocuments.Any(d => d.IsExpired) ? "badge-danger" : "badge-secondary") ml-1">
                            @Model.KaskoDocuments.Count
                        </span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link font-weight-bold py-3 px-4 @(activeTab == "Tire" ? "active text-primary" : "text-secondary")" 
                       id="tire-tab" data-toggle="tab" href="#tireTabPane" role="tab"
                       onclick="$('#hiddenActiveTab').val('Tire');">
                        <i class="fa fa-circle-o-notch mr-2"></i> Lastik
                        <span class="badge badge-pill @(Model.TireDocuments.Any(d => d.IsAlert) ? "badge-danger" : "badge-secondary") ml-1">
                            @Model.TireDocuments.Count
                        </span>
                    </a>
                </li>
            </ul>
        </div>
        <div class="card-body p-4">
            <div class="tab-content" id="documentTabsContent">

                <!-- 1. SEKME: FENNİ MUAYENE -->
                <div class="tab-pane fade @(activeTab == "Inspection" ? "show active" : "")" id="inspectionTabPane" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap" style="gap: 10px;">
                        <h5 class="font-weight-bold text-dark m-0">
                            <i class="fa fa-history mr-1 text-primary"></i> Muayene Geçmişi (Tüm Yıllar)
                        </h5>
                        <div class="d-flex" style="gap: 8px;">
                            <div class="btn-group">
                                <button type="button" class="btn btn-sm btn-outline-info" data-pdf-preview data-pdf-url="/Report/ExportInsuranceInspectionPdf?scope=Inspection&vehicleId=@(Model.SelectedVehicle?.Id)" title="Muayene Raporunu Önizle">
                                    <i class="fa fa-eye mr-1"></i> Önizle
                                </button>
                                <a href="/Report/ExportInsuranceInspectionPdf?scope=Inspection&vehicleId=@(Model.SelectedVehicle?.Id)" class="btn btn-sm btn-outline-danger" title="Muayene Raporunu İndir">
                                    <i class="fa fa-file-pdf-o mr-1"></i> İndir
                                </a>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-primary" data-toggle="modal" data-target="#addDocumentModal" onclick="$('#modalDocumentType').val('Inspection');">
                                <i class="fa fa-plus mr-1"></i> Yeni Muayene Kaydı Ekle
                            </button>
                        </div>
                    </div>

                    @if (Model.InspectionDocuments.Count == 0)
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="fa fa-folder-open-o mb-2" style="font-size: 2.5rem; opacity: 0.5;"></i>
                            <p class="mb-0">Bu araca ait henüz muayene geçmişi bulunmamaktadır.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive vdoc-tab-table-scroll">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light text-secondary font-weight-bold small">
                                    <tr>
                                        @if (Model.IsAllVehicles)
                                        {
                                            <th>ARAÇ</th>
                                        }
                                        <th>DURUM</th>
                                        <th>BAŞLANGIÇ</th>
                                        <th>BİTİŞ (GEÇERLİLİK)</th>
                                        <th>İSTASYON / NO</th>
                                        <th>ÖDENEN TUTAR</th>
                                        <th>NOT / AÇIKLAMA</th>
                                        <th class="text-right">İŞLEMLER</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var doc in Model.InspectionDocuments)
                                    {
                                        <tr class="@(doc.Status == VehicleDocumentStatus.Valid ? "table-success font-weight-normal" : doc.Status == VehicleDocumentStatus.Expired ? "table-danger" : doc.Status == VehicleDocumentStatus.ExpiringSoon ? "table-warning" : "")">
                                            @if (Model.IsAllVehicles)
                                            {
                                                <td class="text-nowrap">
                                                    <a href="/Vehicle/Documents?vehicleId=@doc.VehicleId&activeTab=Inspection" class="font-weight-bold text-primary">@doc.PlateNumber</a>
                                                    <small class="text-muted d-block">@doc.BrandModel</small>
                                                </td>
                                            }
                                            <td>
                                                <span class="badge @doc.StatusBadgeClass px-2 py-1">
                                                    @if (doc.Status == VehicleDocumentStatus.Valid)
                                                    {
                                                        <i class="fa fa-check-circle mr-1"></i>
                                                    }
                                                    else if (doc.Status == VehicleDocumentStatus.ExpiringSoon)
                                                    {
                                                        <i class="fa fa-clock-o mr-1"></i>
                                                    }
                                                    else if (doc.Status == VehicleDocumentStatus.Expired)
                                                    {
                                                        <i class="fa fa-times-circle mr-1"></i>
                                                    }
                                                    @doc.StatusDisplayName
                                                </span>
                                            </td>
                                            <td>@doc.StartDate.ToString("dd.MM.yyyy")</td>
                                            <td>
                                                <span class="@(doc.IsExpired ? "text-danger" : doc.IsExpiringSoon ? "text-warning" : "text-dark")">
                                                    @doc.EndDate.ToString("dd.MM.yyyy")
                                                </span>
                                                @if (doc.IsExpired)
                                                {
                                                    <small class="text-danger d-block font-italic">(@Math.Abs(doc.DaysRemaining) gün önce doldu)</small>
                                                }
                                                else if (doc.IsExpiringSoon)
                                                {
                                                    <small class="text-warning d-block font-italic">(@doc.DaysRemaining gün kaldı)</small>
                                                }
                                            </td>
                                            <td>@(string.IsNullOrWhiteSpace(doc.PolicyOrStationNumber) ? (doc.CompanyName ?? "-") : $"{doc.CompanyName} ({doc.PolicyOrStationNumber})")</td>
                                            <td>
                                                <span class="text-primary font-weight-bold">@(doc.Cost > 0 ? $"{doc.Cost:N2} ₺" : "Belirtilmedi")</span>
                                            </td>
                                            <td class="small text-muted" style="max-width: 250px;">@(doc.Notes ?? "-")</td>
                                            <td class="text-right text-nowrap">
                                                <button type="button" class="btn btn-xs btn-outline-primary mr-1 btn-action-mutate btn-edit-document" 
                                                        data-id="@doc.Id"
                                                        data-vehicle-id="@doc.VehicleId"
                                                        data-doc-type="@doc.DocumentType"
                                                        data-start-date="@doc.StartDate.ToString("yyyy-MM-dd")"
                                                        data-end-date="@doc.EndDate.ToString("yyyy-MM-dd")"
                                                        data-cost="@doc.Cost.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                                        data-policy="@(doc.PolicyOrStationNumber ?? "")"
                                                        data-company="@(doc.CompanyName ?? "")"
                                                        data-notes="@(doc.Notes ?? "")"
                                                        title="Düzenle">
                                                    <i class="fa fa-pencil"></i>
                                                </button>
                                                <button type="button" class="btn btn-xs btn-outline-danger btn-action-mutate btn-delete-document" 
                                                        data-id="@doc.Id"
                                                        data-desc="@doc.DocumentTypeName (@doc.EndDate.ToString("dd.MM.yyyy"))"
                                                        title="Sil">
                                                    <i class="fa fa-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <!-- 2. SEKME: TRAFİK SİGORTASI -->
                <div class="tab-pane fade @(activeTab == "Insurance" ? "show active" : "")" id="insuranceTabPane" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap" style="gap: 10px;">
                        <h5 class="font-weight-bold text-dark m-0">
                            <i class="fa fa-history mr-1 text-primary"></i> Trafik Sigortası Geçmişi (Tüm Yıllar)
                        </h5>
                        <div class="d-flex" style="gap: 8px;">
                            <div class="btn-group">
                                <button type="button" class="btn btn-sm btn-outline-info" data-pdf-preview data-pdf-url="/Report/ExportInsuranceInspectionPdf?scope=Insurance&vehicleId=@(Model.SelectedVehicle?.Id)" title="Trafik Sigortası Raporunu Önizle">
                                    <i class="fa fa-eye mr-1"></i> Önizle
                                </button>
                                <a href="/Report/ExportInsuranceInspectionPdf?scope=Insurance&vehicleId=@(Model.SelectedVehicle?.Id)" class="btn btn-sm btn-outline-danger" title="Trafik Sigortası Raporunu İndir">
                                    <i class="fa fa-file-pdf-o mr-1"></i> İndir
                                </a>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-primary" data-toggle="modal" data-target="#addDocumentModal" onclick="$('#modalDocumentType').val('Insurance');">
                                <i class="fa fa-plus mr-1"></i> Yeni Sigorta Kaydı Ekle
                            </button>
                        </div>
                    </div>

                    @if (Model.InsuranceDocuments.Count == 0)
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="fa fa-folder-open-o mb-2" style="font-size: 2.5rem; opacity: 0.5;"></i>
                            <p class="mb-0">Bu araca ait henüz trafik sigortası geçmişi bulunmamaktadır.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive vdoc-tab-table-scroll">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light text-secondary font-weight-bold small">
                                    <tr>
                                        @if (Model.IsAllVehicles)
                                        {
                                            <th>ARAÇ</th>
                                        }
                                        <th>DURUM</th>
                                        <th>BAŞLANGIÇ</th>
                                        <th>BİTİŞ (POLİÇE SONU)</th>
                                        <th>SİGORTA ŞİRKETİ / POLİÇE NO</th>
                                        <th>ÖDENEN PRİM</th>
                                        <th>NOT / AÇIKLAMA</th>
                                        <th class="text-right">İŞLEMLER</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var doc in Model.InsuranceDocuments)
                                    {
                                        <tr class="@(doc.Status == VehicleDocumentStatus.Valid ? "table-success font-weight-normal" : doc.Status == VehicleDocumentStatus.Expired ? "table-danger" : doc.Status == VehicleDocumentStatus.ExpiringSoon ? "table-warning" : "")">
                                            @if (Model.IsAllVehicles)
                                            {
                                                <td class="text-nowrap">
                                                    <a href="/Vehicle/Documents?vehicleId=@doc.VehicleId&activeTab=Insurance" class="font-weight-bold text-primary">@doc.PlateNumber</a>
                                                    <small class="text-muted d-block">@doc.BrandModel</small>
                                                </td>
                                            }
                                            <td>
                                                <span class="badge @doc.StatusBadgeClass px-2 py-1">
                                                    @if (doc.Status == VehicleDocumentStatus.Valid)
                                                    {
                                                        <i class="fa fa-check-circle mr-1"></i>
                                                    }
                                                    else if (doc.Status == VehicleDocumentStatus.ExpiringSoon)
                                                    {
                                                        <i class="fa fa-clock-o mr-1"></i>
                                                    }
                                                    else if (doc.Status == VehicleDocumentStatus.Expired)
                                                    {
                                                        <i class="fa fa-times-circle mr-1"></i>
                                                    }
                                                    @doc.StatusDisplayName
                                                </span>
                                            </td>
                                            <td>@doc.StartDate.ToString("dd.MM.yyyy")</td>
                                            <td>
                                                <span class="@(doc.IsExpired ? "text-danger" : doc.IsExpiringSoon ? "text-warning" : "text-dark")">
                                                    @doc.EndDate.ToString("dd.MM.yyyy")
                                                </span>
                                                @if (doc.IsExpired)
                                                {
                                                    <small class="text-danger d-block font-italic">(@Math.Abs(doc.DaysRemaining) gün önce doldu)</small>
                                                }
                                                else if (doc.IsExpiringSoon)
                                                {
                                                    <small class="text-warning d-block font-italic">(@doc.DaysRemaining gün kaldı)</small>
                                                }
                                            </td>
                                            <td>@(string.IsNullOrWhiteSpace(doc.PolicyOrStationNumber) ? (doc.CompanyName ?? "-") : $"{doc.CompanyName} (Poliçe: {doc.PolicyOrStationNumber})")</td>
                                            <td>
                                                <span class="text-primary font-weight-bold">@(doc.Cost > 0 ? $"{doc.Cost:N2} ₺" : "Belirtilmedi")</span>
                                            </td>
                                            <td class="small text-muted" style="max-width: 250px;">@(doc.Notes ?? "-")</td>
                                            <td class="text-right text-nowrap">
                                                <button type="button" class="btn btn-xs btn-outline-primary mr-1 btn-action-mutate btn-edit-document" 
                                                        data-id="@doc.Id"
                                                        data-vehicle-id="@doc.VehicleId"
                                                        data-doc-type="@doc.DocumentType"
                                                        data-start-date="@doc.StartDate.ToString("yyyy-MM-dd")"
                                                        data-end-date="@doc.EndDate.ToString("yyyy-MM-dd")"
                                                        data-cost="@doc.Cost.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                                        data-policy="@(doc.PolicyOrStationNumber ?? "")"
                                                        data-company="@(doc.CompanyName ?? "")"
                                                        data-notes="@(doc.Notes ?? "")"
                                                        title="Düzenle">
                                                    <i class="fa fa-pencil"></i>
                                                </button>
                                                <button type="button" class="btn btn-xs btn-outline-danger btn-action-mutate btn-delete-document" 
                                                        data-id="@doc.Id"
                                                        data-desc="@doc.DocumentTypeName (@doc.EndDate.ToString("dd.MM.yyyy"))"
                                                        title="Sil">
                                                    <i class="fa fa-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <!-- 3. SEKME: KASKO -->
                <div class="tab-pane fade @(activeTab == "Kasko" ? "show active" : "")" id="kaskoTabPane" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap" style="gap: 10px;">
                        <h5 class="font-weight-bold text-dark m-0">
                            <i class="fa fa-history mr-1 text-primary"></i> Kasko Poliçeleri Geçmişi (Tüm Yıllar)
                        </h5>
                        <div class="d-flex" style="gap: 8px;">
                            <div class="btn-group">
                                <button type="button" class="btn btn-sm btn-outline-info" data-pdf-preview data-pdf-url="/Report/ExportInsuranceInspectionPdf?scope=Kasko&vehicleId=@(Model.SelectedVehicle?.Id)" title="Kasko Raporunu Önizle">
                                    <i class="fa fa-eye mr-1"></i> Önizle
                                </button>
                                <a href="/Report/ExportInsuranceInspectionPdf?scope=Kasko&vehicleId=@(Model.SelectedVehicle?.Id)" class="btn btn-sm btn-outline-danger" title="Kasko Raporunu İndir">
                                    <i class="fa fa-file-pdf-o mr-1"></i> İndir
                                </a>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-primary" data-toggle="modal" data-target="#addDocumentModal" onclick="$('#modalDocumentType').val('Kasko');">
                                <i class="fa fa-plus mr-1"></i> Yeni Kasko Kaydı Ekle
                            </button>
                        </div>
                    </div>

                    @if (Model.KaskoDocuments.Count == 0)
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="fa fa-folder-open-o mb-2" style="font-size: 2.5rem; opacity: 0.5;"></i>
                            <p class="mb-0">Bu araca ait henüz kasko poliçesi kaydı bulunmamaktadır.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive vdoc-tab-table-scroll">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light text-secondary font-weight-bold small">
                                    <tr>
                                        @if (Model.IsAllVehicles)
                                        {
                                            <th>ARAÇ</th>
                                        }
                                        <th>DURUM</th>
                                        <th>BAŞLANGIÇ</th>
                                        <th>BİTİŞ (POLİÇE SONU)</th>
                                        <th>SİGORTA ŞİRKETİ / POLİÇE NO</th>
                                        <th>ÖDENEN PRİM</th>
                                        <th>NOT / AÇIKLAMA</th>
                                        <th class="text-right">İŞLEMLER</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var doc in Model.KaskoDocuments)
                                    {
                                        <tr class="@(doc.Status == VehicleDocumentStatus.Valid ? "table-success font-weight-normal" : doc.Status == VehicleDocumentStatus.Expired ? "table-danger" : doc.Status == VehicleDocumentStatus.ExpiringSoon ? "table-warning" : "")">
                                            @if (Model.IsAllVehicles)
                                            {
                                                <td class="text-nowrap">
                                                    <a href="/Vehicle/Documents?vehicleId=@doc.VehicleId&activeTab=Kasko" class="font-weight-bold text-primary">@doc.PlateNumber</a>
                                                    <small class="text-muted d-block">@doc.BrandModel</small>
                                                </td>
                                            }
                                            <td>
                                                <span class="badge @doc.StatusBadgeClass px-2 py-1">
                                                    @if (doc.Status == VehicleDocumentStatus.Valid)
                                                    {
                                                        <i class="fa fa-check-circle mr-1"></i>
                                                    }
                                                    else if (doc.Status == VehicleDocumentStatus.ExpiringSoon)
                                                    {
                                                        <i class="fa fa-clock-o mr-1"></i>
                                                    }
                                                    else if (doc.Status == VehicleDocumentStatus.Expired)
                                                    {
                                                        <i class="fa fa-times-circle mr-1"></i>
                                                    }
                                                    @doc.StatusDisplayName
                                                </span>
                                            </td>
                                            <td>@doc.StartDate.ToString("dd.MM.yyyy")</td>
                                            <td>
                                                <span class="@(doc.IsExpired ? "text-danger" : doc.IsExpiringSoon ? "text-warning" : "text-dark")">
                                                    @doc.EndDate.ToString("dd.MM.yyyy")
                                                </span>
                                                @if (doc.IsExpired)
                                                {
                                                    <small class="text-danger d-block font-italic">(@Math.Abs(doc.DaysRemaining) gün önce doldu)</small>
                                                }
                                                else if (doc.IsExpiringSoon)
                                                {
                                                    <small class="text-warning d-block font-italic">(@doc.DaysRemaining gün kaldı)</small>
                                                }
                                            </td>
                                            <td>@(string.IsNullOrWhiteSpace(doc.PolicyOrStationNumber) ? (doc.CompanyName ?? "-") : $"{doc.CompanyName} (Poliçe: {doc.PolicyOrStationNumber})")</td>
                                            <td>
                                                <span class="text-primary font-weight-bold">@(doc.Cost > 0 ? $"{doc.Cost:N2} ₺" : "Belirtilmedi")</span>
                                            </td>
                                            <td class="small text-muted" style="max-width: 250px;">@(doc.Notes ?? "-")</td>
                                            <td class="text-right text-nowrap">
                                                <button type="button" class="btn btn-xs btn-outline-primary mr-1 btn-action-mutate btn-edit-document" 
                                                        data-id="@doc.Id"
                                                        data-vehicle-id="@doc.VehicleId"
                                                        data-doc-type="@doc.DocumentType"
                                                        data-start-date="@doc.StartDate.ToString("yyyy-MM-dd")"
                                                        data-end-date="@doc.EndDate.ToString("yyyy-MM-dd")"
                                                        data-cost="@doc.Cost.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                                        data-policy="@(doc.PolicyOrStationNumber ?? "")"
                                                        data-company="@(doc.CompanyName ?? "")"
                                                        data-notes="@(doc.Notes ?? "")"
                                                        title="Düzenle">
                                                    <i class="fa fa-pencil"></i>
                                                </button>
                                                <button type="button" class="btn btn-xs btn-outline-danger btn-action-mutate btn-delete-document" 
                                                        data-id="@doc.Id"
                                                        data-desc="@doc.DocumentTypeName (@doc.EndDate.ToString("dd.MM.yyyy"))"
                                                        title="Sil">
                                                    <i class="fa fa-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <!-- 4. SEKME: LASTİK YÖNETİMİ -->
                <div class="tab-pane fade @(activeTab == "Tire" ? "show active" : "")" id="tireTabPane" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap" style="gap: 10px;">
                        <div>
                            <h5 class="font-weight-bold text-dark m-0">
                                <i class="fa fa-circle-o-notch mr-1 text-primary"></i> Lastik Geçmişi ve Değişim Takibi
                            </h5>
                            @if (Model.IsAllVehicles)
                            {
                                <small class="text-muted">Kullanım KM'si her aracın kendi güncel KM'sine göre anlık hesaplanmaktadır.</small>
                            }
                            else
                            {
                                <small class="text-muted">Kullanım KM'si aracın güncel KM'sine (@(Model.SelectedVehicle?.CurrentKm.ToString("N0") ?? "0") km) göre anlık hesaplanmaktadır.</small>
                            }
                        </div>
                        <div class="d-flex" style="gap: 8px;">
                            <div class="btn-group">
                                <a href="/Report/Tires?vehicleId=@(Model.SelectedVehicle?.Id)" class="btn btn-sm btn-outline-secondary" title="Detaylı Lastik Raporuna Git">
                                    <i class="fa fa-bar-chart mr-1"></i> Rapor
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-info" data-pdf-preview data-pdf-url="/Report/ExportTiresPdf?vehicleId=@(Model.SelectedVehicle?.Id)" title="Lastik Kullanım Raporunu Önizle">
                                    <i class="fa fa-eye mr-1"></i> Önizle
                                </button>
                                <a href="/Report/ExportTiresPdf?vehicleId=@(Model.SelectedVehicle?.Id)" class="btn btn-sm btn-outline-danger" title="Lastik Raporunu İndir">
                                    <i class="fa fa-file-pdf-o mr-1"></i> İndir
                                </a>
                            </div>
                            <button type="button" class="btn btn-sm btn-primary" data-toggle="modal" data-target="#addTireModal">
                                <i class="fa fa-plus mr-1"></i> Yeni Lastik Kaydı Ekle
                            </button>
                        </div>
                    </div>

                    @if (!Model.TireDocuments.Any())
                    {
                        <div class="text-center py-5 bg-light rounded border border-dashed">
                            <i class="fa fa-circle-o-notch text-muted mb-2" style="font-size: 2.5rem;"></i>
                            <p class="text-muted mb-0">Bu araca ait kayıtlı lastik geçmişi bulunmamaktadır.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive vdoc-tab-table-scroll">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="thead-light">
                                    <tr>
                                        @if (Model.IsAllVehicles)
                                        {
                                            <th>Araç</th>
                                        }
                                        <th style="width: 50px;">Durum</th>
                                        <th>Marka / Ebat</th>
                                        <th>DOT / Üretim</th>
                                        <th>Mevsim</th>
                                        <th>Takılma Tarihi</th>
                                        <th>Takılma KM</th>
                                        <th>Kullanım KM</th>
                                        <th>Değişim Eşiği (KM / Tarih)</th>
                                        <th>Maliyet</th>
                                        <th style="width: 120px;" class="text-right">İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var tire in Model.TireDocuments)
                                    {
                                        <tr class="@(tire.IsCurrentTire ? "table-success font-weight-normal" : "") @(tire.Status == aractakipsys.Models.Enums.TireStatus.Critical ? "table-danger" : tire.Status == aractakipsys.Models.Enums.TireStatus.Approaching ? "table-warning" : "")">
                                            @if (Model.IsAllVehicles)
                                            {
                                                <td class="text-nowrap">
                                                    <a href="/Vehicle/Documents?vehicleId=@tire.VehicleId&activeTab=Tire" class="font-weight-bold text-primary">@tire.PlateNumber</a>
                                                </td>
                                            }
                                            <td>
                                                @if (tire.IsCurrentTire)
                                                {
                                                    <span class="badge badge-success px-2 py-1"><i class="fa fa-check mr-1"></i> Güncel</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-light border text-muted px-2 py-1">Geçmiş</span>
                                                }
                                            </td>
                                            <td>
                                                <strong class="text-dark">@tire.Brand</strong>
                                                @if (!string.IsNullOrWhiteSpace(tire.Size))
                                                {
                                                    <span class="badge badge-secondary ml-1">@tire.Size</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="font-weight-bold text-dark">@tire.DotDateDisplay</span>
                                            </td>
                                            <td>
                                                <span class="badge badge-info">@tire.SeasonDisplay</span>
                                            </td>
                                            <td>
                                                @(tire.InstalledDate.HasValue ? tire.InstalledDate.Value.ToString("dd.MM.yyyy") : "-")
                                            </td>
                                            <td>
                                                @(tire.InstalledKm.HasValue ? $"{tire.InstalledKm.Value:N0} km" : "-")
                                            </td>
                                            <td>
                                                @if (tire.UsedKm.HasValue)
                                                {
                                                    <strong class="text-primary">@tire.UsedKm.Value.ToString("N0") km</strong>
                                                }
                                                else
                                                {
                                                    <span class="text-muted font-italic">Bilinmiyor</span>
                                                }
                                            </td>
                                            <td>
                                                @if (tire.Status == aractakipsys.Models.Enums.TireStatus.Critical)
                                                {
                                                    <span class="badge badge-danger p-1"><i class="fa fa-exclamation-triangle mr-1"></i> @tire.AlertReason</span>
                                                }
                                                else if (tire.Status == aractakipsys.Models.Enums.TireStatus.Approaching)
                                                {
                                                    <span class="badge badge-warning text-dark p-1"><i class="fa fa-clock-o mr-1"></i> @tire.AlertReason</span>
                                                }
                                                else if (tire.Status == aractakipsys.Models.Enums.TireStatus.MissingData)
                                                {
                                                    <span class="badge badge-secondary p-1" title="@tire.AlertReason"><i class="fa fa-question-circle mr-1"></i> Veri Eksik</span>
                                                }
                                                else
                                                {
                                                    var parts = new List<string>();
                                                    if (tire.RecommendedReplaceKm.HasValue)
                                                    {
                                                        parts.Add($"{tire.RecommendedReplaceKm.Value:N0} km (Kalan: {tire.RemainingKm:N0} km)");
                                                    }
                                                    if (tire.RecommendedReplaceDate.HasValue)
                                                    {
                                                        parts.Add($"{tire.RecommendedReplaceDate.Value:dd.MM.yyyy} (Kalan: {tire.RemainingDays} gün)");
                                                    }
                                                    if (parts.Count > 0)
                                                    {
                                                        <small class="text-dark d-block">@string.Join(" / ", parts)</small>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-success p-1"><i class="fa fa-check mr-1"></i> Normal</span>
                                                    }
                                                }
                                            </td>
                                            <td>
                                                @(tire.Cost > 0 ? $"{tire.Cost:N2} ₺" : "-")
                                            </td>
                                            <td class="text-right text-nowrap">
                                                <button type="button" class="btn btn-xs btn-outline-primary mr-1 btn-action-mutate btn-edit-tire" 
                                                        data-id="@tire.Id"
                                                        data-vehicle-id="@tire.VehicleId"
                                                        data-brand="@tire.Brand"
                                                        data-size="@(tire.Size ?? "")"
                                                        data-dot="@(tire.DotDate ?? "")"
                                                        data-season="@tire.Season"
                                                        data-installed-date="@(tire.InstalledDate?.ToString("yyyy-MM-dd") ?? "")"
                                                        data-installed-km="@(tire.InstalledKm?.ToString() ?? "")"
                                                        data-rec-km="@(tire.RecommendedReplaceKm?.ToString() ?? "")"
                                                        data-rec-date="@(tire.RecommendedReplaceDate?.ToString("yyyy-MM-dd") ?? "")"
                                                        data-cost="@((tire.Cost ?? 0).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))"
                                                        data-notes="@(tire.Notes ?? "")"
                                                        title="Düzenle">
                                                    <i class="fa fa-pencil"></i>
                                                </button>
                                                <button type="button" class="btn btn-xs btn-outline-danger btn-action-mutate btn-delete-tire" 
                                                        data-id="@tire.Id"
                                                        data-desc="@tire.Brand (@tire.SeasonDisplay)"
                                                        title="Sil">
                                                    <i class="fa fa-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>
}

<!-- YENİ BELGE EKLEME MODALI (Body Öncesinde Tanımlandı) -->
<div class="modal fade" id="addDocumentModal" tabindex="-1" role="dialog" aria-labelledby="addDocumentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow" style="border-radius: 12px;">
            <div class="modal-header bg-primary text-white" style="border-radius: 12px 12px 0 0;">
                <h5 class="modal-title font-weight-bold" id="addDocumentModalLabel">
                    <i class="fa fa-file-text-o mr-2"></i> Yeni Belge Kaydı Ekle
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form method="post" action="/Vehicle/AddDocument">
                @Html.AntiForgeryToken()
                @if (!Model.IsAllVehicles)
                {
                    <input type="hidden" name="VehicleId" value="@Model.SelectedVehicleId" />
                }
                <input type="hidden" name="activeTab" value="@activeTab" />

                <div class="modal-body p-4">
                    @if (Model.IsAllVehicles)
                    {
                        <div class="form-group mb-3">
                            <label class="font-weight-bold text-dark">Araç <span class="text-danger">*</span></label>
                            <select name="VehicleId" class="form-control" required>
                                <option value="">-- Araç Seçiniz --</option>
                                @foreach (var item in Model.VehicleSelectList.Where(v => v.Value != "0"))
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="form-group mb-3">
                        <label class="font-weight-bold text-dark">Belge Türü <span class="text-danger">*</span></label>
                        <select name="DocumentType" id="modalDocumentType" class="form-control" required>
                            <option value="Inspection">Fenni Muayene</option>
                            <option value="Insurance">Trafik Sigortası</option>
                            <option value="Kasko">Kasko</option>
                        </select>
                    </div>

                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="font-weight-bold text-dark">Başlangıç Tarihi <span class="text-danger">*</span></label>
                            <input type="date" name="StartDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="font-weight-bold text-dark">Bitiş Tarihi <span class="text-danger">*</span></label>
                            <input type="date" name="EndDate" class="form-control" value="@DateTime.Today.AddYears(1).ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label class="font-weight-bold text-dark">Ödenen Tutar (₺)</label>
                        <input type="number" step="0.01" min="0" name="Cost" class="form-control" placeholder="Örn: 2500.00" value="0.00" />
                    </div>

                    <div class="form-group mb-3">
                        <label class="font-weight-bold text-dark">Firma / Kurum Adı</label>
                        <input type="text" name="CompanyName" class="form-control" placeholder="Örn: TÜVTÜRK / Anadolu Sigorta / Sompo Kasko" />
                    </div>

                    <div class="form-group mb-3">
                        <label class="font-weight-bold text-dark">Poliçe No / İstasyon No</label>
                        <input type="text" name="PolicyOrStationNumber" class="form-control" placeholder="Örn: POL-998811 veya İST-81" />
                    </div>

                    <div class="form-group mb-0">
                        <label class="font-weight-bold text-dark">Açıklama / Not</label>
                        <textarea name="Notes" class="form-control" rows="2" placeholder="Varsa ek notlar..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light" style="border-radius: 0 0 12px 12px;">
                    <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary font-weight-bold px-4">
                        <i class="fa fa-save mr-1"></i> Kaydı Kaydet
                    </button>
                </div>
