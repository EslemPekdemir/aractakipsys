            <form method="post" action="/Vehicle/AddTire">
                @Html.AntiForgeryToken()
                @if (!Model.IsAllVehicles)
                {
                    <input type="hidden" name="VehicleId" value="@Model.SelectedVehicleId" />
                }

                <div class="modal-body p-4">
                    @if (Model.IsAllVehicles)
                    {
                        <div class="form-group mb-3">
                            <label class="font-weight-bold text-dark">Araç <span class="text-danger">*</span></label>
                            <select name="VehicleId" class="form-control" required>
                                <option value="">-- Araç Seçiniz --</option>
                                @foreach (var item in Model.VehicleSelectList.Where(v => v.Value != "0"))
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="font-weight-bold text-dark">Marka <span class="text-danger">*</span></label>
                            <input type="text" name="Brand" class="form-control" placeholder="Örn: Michelin / Continental / Lassa" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="font-weight-bold text-dark">Ebat <span class="text-danger">*</span></label>
                            <input type="text" name="Size" class="form-control" placeholder="Örn: 205/55 R16" required />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="font-weight-bold text-dark">Üretim DOT (Hafta/Yıl) <span class="text-danger">*</span></label>
                            <input type="text" name="DotDate" class="form-control" placeholder="Örn: 52/23 (01-53 hafta, iki hane yıl)" 
                                   pattern="^(0[1-9]|[1-4][0-9]|5[0-3])\/[0-9]{2}$" title="DOT formatı Hafta/Yıl şeklinde olmalıdır. Örn: 52/23" required />
                            <small class="text-muted">Format: 01-53 hafta / 2 haneli yıl (Örn: 52/23)</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="font-weight-bold text-dark">Mevsim <span class="text-danger">*</span></label>
                            <select name="Season" class="form-control" required>
                                <option value="">-- Lastik Mevsimi Seçiniz --</option>
                                @foreach (var s in activeSeasons)
                                {
                                    <option value="@s">@s</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="font-weight-bold text-dark">Takılma / Değişim Tarihi <span class="text-danger">*</span></label>
                            <input type="date" name="InstalledDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="font-weight-bold text-dark">Takıldığı Andaki Araç KM <span class="text-danger">*</span></label>
                            <input type="number" min="0" name="InstalledKm" class="form-control" value="@Model.SelectedVehicle?.CurrentKm" required />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="font-weight-bold text-dark">Değiştirilmesi Gereken KM <span class="text-muted font-weight-normal">(Opsiyonel)</span></label>
                            <input type="number" min="0" name="RecommendedReplaceKm" class="form-control" placeholder="Örn: 150000" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="font-weight-bold text-dark">Değiştirilmesi Gereken Tarih <span class="text-muted font-weight-normal">(Opsiyonel)</span></label>
                            <input type="date" name="RecommendedReplaceDate" class="form-control" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="font-weight-bold text-dark">Maliyet (₺)</label>
                            <input type="number" step="0.01" min="0" name="Cost" class="form-control" placeholder="Örn: 12000.00" value="0.00" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="font-weight-bold text-dark">Açıklama / Not</label>
                            <input type="text" name="Notes" class="form-control" placeholder="Varsa tedarikçi, fatura veya lastik durumu..." />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light" style="border-radius: 0 0 12px 12px;">
                    <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary font-weight-bold px-4">
                        <i class="fa fa-save mr-1"></i> Lastik Kaydını Ekle
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

