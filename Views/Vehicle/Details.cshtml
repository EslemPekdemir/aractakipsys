<!-- File: Views/Vehicle/Details.cshtml -->
@model aractakipsys.Models.ViewModels.Vehicle.VehicleDetailsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Araç Detayı: " + Model.PlateNumber;
}

<div class="row wrapper border-bottom white-bg page-heading mb-4">
    <div class="col-lg-9">
        <h2 class="font-weight-bold">Araç Detay Kartı</h2>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/Vehicle">Araçlar</a></li>
            <li class="breadcrumb-item active"><strong>@Model.PlateNumber</strong></li>
        </ol>
    </div>
    <div class="col-lg-3 text-right d-flex align-items-center justify-content-start justify-content-lg-end mt-2 mt-lg-0">
        <a href="/Vehicle/Edit/@Model.Id" class="btn btn-warning font-weight-bold mr-2">
            <i class="fa fa-pencil mr-1"></i> Düzenle
        </a>
        <a href="/Vehicle" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left mr-1"></i> Geri Dön
        </a>
    </div>
</div>

<div class="row">
    <!-- SOL KOLON: ARAÇ TEMEL VE TEKNİK BİLGİLERİ -->
    <div class="col-lg-4 mb-4">
        <div class="ibox float-e-margins">
            <div class="ibox-title bg-light d-flex justify-content-between align-items-center">
                <h5 class="m-0 font-weight-bold text-dark">Araç Künyesi</h5>
                <span class="badge text-white px-3 py-1 @Model.StatusBadgeClass" style="border-radius: 12px; font-size: 0.85rem;">
                    @Model.StatusDisplayName
                </span>
            </div>
            <div class="ibox-content p-4">
                <div class="text-center pb-3 border-bottom mb-3">
                    <div class="h1 font-weight-bold text-primary mb-1" style="letter-spacing: 1px;">
                        @Model.PlateNumber
                    </div>
                    <div class="h4 font-weight-bold text-dark mb-0">
                        @Model.Brand @Model.Model
                    </div>
                    <span class="text-muted small">@Model.Year Modeli</span>
                </div>

                <div class="list-group list-group-flush">
                    <div class="list-group-item d-flex justify-content-between px-0 py-2 border-0">
                        <span class="text-muted font-weight-bold">Güncel Kilometre:</span>
                        <span class="font-weight-bold text-dark">@Model.CurrentKm.ToString("N0") KM</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between px-0 py-2 border-0">
                        <span class="text-muted font-weight-bold">Araç Tipi:</span>
                        <span class="text-dark">@Model.VehicleType</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between px-0 py-2 border-0">
                        <span class="text-muted font-weight-bold">Yakıt Türü:</span>
                        <span class="text-dark">@Model.FuelType</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between px-0 py-2 border-0">
                        <span class="text-muted font-weight-bold">Renk:</span>
                        <span class="text-dark">@Model.Color</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between px-0 py-2 border-0">
                        <span class="text-muted font-weight-bold">Muayene Başlangıç:</span>
                        <span class="text-dark font-weight-bold">
                            @Model.InspectionStartDate.ToString("dd.MM.yyyy")
                        </span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between px-0 py-2 border-0">
                        <span class="text-muted font-weight-bold">Muayene Bitiş:</span>
                        <span class="text-dark font-weight-bold @(Model.InspectionExpiryDate < DateTime.Today ? "text-danger" : "")">
                            @Model.InspectionExpiryDate.ToString("dd.MM.yyyy")
                            @if (Model.InspectionExpiryDate < DateTime.Today)
                            {
                                <span class="badge badge-danger ml-1">Süresi Dolmuş</span>
                            }
                        </span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between px-0 py-2 border-0">
                        <span class="text-muted font-weight-bold">Sigorta Başlangıç:</span>
                        <span class="text-dark font-weight-bold">
                            @Model.InsuranceStartDate.ToString("dd.MM.yyyy")
                        </span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between px-0 py-2 border-0">
                        <span class="text-muted font-weight-bold">Sigorta Bitiş:</span>
                        <span class="text-dark font-weight-bold @(Model.InsuranceExpiryDate < DateTime.Today ? "text-danger" : "")">
                            @Model.InsuranceExpiryDate.ToString("dd.MM.yyyy")
                            @if (Model.InsuranceExpiryDate < DateTime.Today)
                            {
                                <span class="badge badge-danger ml-1">Süresi Dolmuş</span>
                            }
                        </span>
                    </div>
                    @if (Model.CurrentTire != null)
                    {
                        <div class="list-group-item d-flex justify-content-between px-0 py-2 border-0">
                            <span class="text-muted font-weight-bold">Güncel Lastik:</span>
                            <span class="text-dark font-weight-bold">
                                @Model.CurrentTire.Brand
                                @if (!string.IsNullOrWhiteSpace(Model.CurrentTire.Size))
                                {
                                    <span class="badge badge-secondary ml-1">@Model.CurrentTire.Size</span>
                                }
                                <span class="badge badge-info ml-1">@Model.CurrentTire.SeasonDisplay</span>
                            </span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between px-0 py-2 border-0">
                            <span class="text-muted font-weight-bold">DOT & Kullanım:</span>
                            <span class="text-dark small">
                                <strong>@Model.CurrentTire.DotDateDisplay</strong> | Kullanım: <strong>@Model.CurrentTire.UsedKmDisplay</strong>
                                @if (Model.CurrentTire.Status == aractakipsys.Models.Enums.TireStatus.Critical)
                                {
                                    <span class="badge badge-danger ml-1">@Model.CurrentTire.AlertReason</span>
                                }
                                else if (Model.CurrentTire.Status == aractakipsys.Models.Enums.TireStatus.Approaching)
                                {
                                    <span class="badge badge-warning text-dark ml-1">@Model.CurrentTire.AlertReason</span>
                                }
                                else if (Model.CurrentTire.Status == aractakipsys.Models.Enums.TireStatus.MissingData)
                                {
                                    <span class="badge badge-secondary ml-1" title="@Model.CurrentTire.AlertReason">Veri Eksik</span>
                                }
                                else
                                {
                                    <span class="badge badge-success ml-1">Normal</span>
                                }
                            </span>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(Model.TireBrand) || Model.TireYear.HasValue || !string.IsNullOrEmpty(Model.TireSeason))
                    {
                        <div class="list-group-item d-flex justify-content-between px-0 py-2 border-0">
                            <span class="text-muted font-weight-bold">Lastik Durumu:</span>
                            <span class="text-dark">
                                @(Model.TireBrand ?? "-")
                                @(Model.TireYear.HasValue ? $"({Model.TireYear})" : "")
                                @(!string.IsNullOrEmpty(Model.TireSeason) ? $"[{Model.TireSeason}]" : "")
                            </span>
                        </div>
                    }
                    <div class="list-group-item d-flex justify-content-between px-0 py-2 border-0">
                        <span class="text-muted font-weight-bold">Kayıt Tarihi:</span>
                        <span class="text-dark">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                    </div>
                    @if (Model.UpdatedAt.HasValue)
                    {
                        <div class="list-group-item d-flex justify-content-between px-0 py-2 border-0">
                            <span class="text-muted font-weight-bold">Son Güncelleme:</span>
                            <span class="text-dark">@Model.UpdatedAt.Value.ToString("dd.MM.yyyy HH:mm")</span>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(Model.FineNotes))
                {
                    <div class="mt-3 p-3 bg-light rounded border border-warning">
                        <small class="text-warning font-weight-bold d-block mb-1">
                            <i class="fa fa-exclamation-triangle mr-1"></i> TRAFİK CEZASI / ŞEF NOTU
                        </small>
                        <p class="mb-0 text-dark small font-weight-600">@Model.FineNotes</p>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="mt-3 p-3 bg-light rounded border">
                        <small class="text-muted font-weight-bold d-block mb-1">NOTLAR / AÇIKLAMA</small>
                        <p class="mb-0 text-dark small font-italic">@Model.Notes</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- SAĞ KOLON: SON GÖREVLER VE BAKIM GEÇMİŞİ -->
    <div class="col-lg-8">
        <!-- 1. SON 5 GÖREVLENDİRME -->
        <div class="ibox float-e-margins mb-4">
            <div class="ibox-title d-flex justify-content-between align-items-center">
                <h5 class="m-0 font-weight-bold text-dark">
                    <i class="fa fa-calendar-check-o text-primary mr-1"></i> Son Görevlendirmeler (Son 5)
                </h5>
            </div>
            <div class="ibox-content p-0">
                @if (Model.RecentAssignments.Count == 0)
                {
                    <div class="text-center py-4 text-muted">
                        <i class="fa fa-info-circle mr-1"></i> Bu araca ait henüz bir görev kaydı bulunmamaktadır.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th>Şoför</th>
                                    <th>Görev Amacı</th>
                                    <th>Planlanan Tarih</th>
                                    <th class="text-right">Mesafe</th>
                                    <th class="text-center">Durum</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var assignment in Model.RecentAssignments)
                                {
                                    <tr>
                                        <td class="font-weight-bold align-middle">@assignment.DriverFullName</td>
                                        <td class="align-middle text-truncate" style="max-width: 200px;" title="@assignment.Purpose">
                                            @assignment.Purpose
                                        </td>
                                        <td class="align-middle text-muted small">
                                            @assignment.PlannedStartTime.ToString("dd.MM.yyyy HH:mm")
                                        </td>
                                        <td class="align-middle text-right small">
                                            @if (assignment.StartKm.HasValue && assignment.EndKm.HasValue)
                                            {
                                                <span class="font-weight-bold">@(assignment.EndKm.Value - assignment.StartKm.Value) KM</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td class="align-middle text-center">
                                            <span class="badge text-white px-2 py-1 @assignment.StatusBadgeClass" style="border-radius: 8px; font-size: 0.75rem;">
                                                @assignment.StatusDisplayName
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- 2. BAKIM GEÇMİŞİ -->
        <div class="ibox float-e-margins">
            <div class="ibox-title d-flex justify-content-between align-items-center">
                <h5 class="m-0 font-weight-bold text-dark">
                    <i class="fa fa-wrench text-warning mr-1"></i> Bakım ve Servis Geçmişi
                </h5>
                @if (Model.MaintenanceHistory.Count > 0)
                {
                    var vehicleMaintenancePdfUrl = $"/Report/ExportMaintenancePdf?vehicleId={Model.Id}&hasSearched=true";
                    <div class="btn-group">
                        <button type="button" class="btn btn-outline-info btn-xs font-weight-bold shadow-sm"
                                data-pdf-preview data-pdf-url="@vehicleMaintenancePdfUrl"
                                data-pdf-title="@Model.PlateNumber - Araç Bakım ve Maliyet Raporu Önizleme">
                            <i class="fa fa-eye mr-1"></i> Önizle
                        </button>
                        <a href="@vehicleMaintenancePdfUrl" target="_blank"
                           class="btn btn-outline-danger btn-xs font-weight-bold shadow-sm"
                           title="@Model.PlateNumber İçin Bakım ve Maliyet Raporu PDF İndir">
                            <i class="fa fa-file-pdf-o mr-1"></i> PDF İndir
                        </a>
                    </div>
                }
            </div>
            <div class="ibox-content p-0">
                @if (Model.MaintenanceHistory.Count == 0)
                {
                    <div class="text-center py-4 text-muted">
                        <i class="fa fa-info-circle mr-1"></i> Bu araca ait kayıtlı bakım bulunmamaktadır.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th>Bakım Türü</th>
                                    <th>Açıklama</th>
                                    <th>Başlangıç</th>
                                    <th>Bitiş</th>
                                    <th>Servis / Atölye</th>
                                    <th class="text-center">Durum</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in Model.MaintenanceHistory)
                                {
                                    <tr>
                                        <td class="font-weight-bold align-middle">@m.MaintenanceType</td>
                                        <td class="align-middle small">@(m.Description ?? "-")</td>
                                        <td class="align-middle small">@m.StartDate.ToString("dd.MM.yyyy")</td>
                                        <td class="align-middle small">
                                            @(m.EndDate.HasValue ? m.EndDate.Value.ToString("dd.MM.yyyy") : "-")
                                        </td>
                                        <td class="align-middle small text-muted">@(m.PerformedBy ?? "-")</td>
                                        <td class="align-middle text-center">
                                            @if (m.IsOngoing)
                                            {
                                                <span class="badge bg-warning text-dark px-2 py-1" style="border-radius: 8px; font-size: 0.75rem;">
                                                    <i class="fa fa-spinner fa-spin mr-1"></i> Devam Ediyor
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success text-white px-2 py-1" style="border-radius: 8px; font-size: 0.75rem;">
                                                    <i class="fa fa-check mr-1"></i> Tamamlandı
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
