<!-- File: Views/Report/VehicleRequests.cshtml -->
@model aractakipsys.Models.ViewModels.Report.VehicleRequestReportViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Araç Talepleri İstatistiği Raporu";
    var exportPdfUrl = Url.Action("ExportVehicleRequestsPdf", new { 
        startDate = Model.Filter.StartDate?.ToString("yyyy-MM-dd"), 
        endDate = Model.Filter.EndDate?.ToString("yyyy-MM-dd"),
        hasSearched = true 
    });
}

<div class="row wrapper border-bottom white-bg page-heading mb-4">
    <div class="col-12">
        <h2 class="font-weight-bold">Araç Talepleri İstatistiği Raporu</h2>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/Report">Raporlar</a></li>
            <li class="breadcrumb-item active"><strong>Araç Talepleri</strong></li>
        </ol>
    </div>
</div>

<div class="wrapper wrapper-content animated fadeInRight p-0">
    <!-- ÜST MENÜ SEKMELERİ -->
    <div class="row mb-3">
        <div class="col-12">
            <ul class="nav nav-pills p-2 bg-white rounded shadow-sm font-weight-bold d-flex flex-wrap" style="border: 1px solid #e7eaec; gap: 4px;">
                <li class="nav-item mr-2 mb-1">
                    <a class="nav-link text-secondary py-2 px-3" href="/Report">
                        <i class="fa fa-road mr-1"></i> Sefer & Kullanım Raporu
                    </a>
                </li>
                <li class="nav-item mr-2 mb-1">
                    <a class="nav-link text-secondary py-2 px-3" href="/Report/Maintenance">
                        <i class="fa fa-wrench mr-1"></i> Araç Bakım & Tamir Dökümü
                    </a>
                </li>
                <li class="nav-item mr-2 mb-1">
                    <a class="nav-link text-secondary py-2 px-3" href="/Report/InsuranceInspection">
                        <i class="fa fa-shield mr-1"></i> Araç Belge Durum Raporu
                    </a>
                </li>
                <li class="nav-item mr-2 mb-1">
                    <a class="nav-link text-secondary py-2 px-3" href="/Report/Tires">
                        <i class="fa fa-circle-o-notch mr-1"></i> Araç Lastik Raporu
                    </a>
                </li>
                <li class="nav-item mb-1">
                    <a class="nav-link active bg-primary text-white py-2 px-3 shadow-sm" href="/Report/VehicleRequests">
                        <i class="fa fa-file-text-o mr-1"></i> Araç Talepleri Raporu
                    </a>
                </li>
            </ul>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa fa-exclamation-circle mr-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Kapat">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <!-- FİLTRE PANELİ -->
    <div class="ibox mb-3 shadow-sm">
        <div class="ibox-title bg-light py-2 px-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="font-weight-bold text-dark mb-0">
                <i class="fa fa-filter text-primary mr-1"></i> Rapor Filtreleme Seçenekleri (Talep Oluşturulma Tarihi)
            </h5>
        </div>
        <div class="ibox-content p-3">
            <form method="get" action="/Report/VehicleRequests" id="requestReportFilterForm">
                <input type="hidden" name="hasSearched" value="true" />
                <input type="hidden" name="PageSize" value="@Model.PageSize" />
                <div class="form-row align-items-end">
                    <div class="col-md-4 mb-2">
                        <label class="font-weight-bold small text-muted">Başlangıç Tarihi</label>
                        <input type="date" name="startDate" class="form-control form-control-sm"
                               value="@(Model.Filter.StartDate?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-4 mb-2">
                        <label class="font-weight-bold small text-muted">Bitiş Tarihi</label>
                        <input type="date" name="endDate" class="form-control form-control-sm"
                               value="@(Model.Filter.EndDate?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-4 mb-2 d-flex">
                        <button type="submit" class="btn btn-primary btn-sm mr-2 flex-grow-1 shadow-sm font-weight-bold">
                            <i class="fa fa-search mr-1"></i> Raporu Getir
                        </button>
                        <a href="/Report/VehicleRequests" class="btn btn-outline-secondary btn-sm shadow-sm" title="Filtreleri Temizle">
                            <i class="fa fa-refresh mr-1"></i> Sıfırla
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- KPI ÖZET KARTLARI -->
    <div class="row mb-3">
        <div class="col-md-3 col-sm-6 mb-2">
            <div class="ibox bg-white shadow-sm rounded border p-3">
                <div class="text-muted small font-weight-bold text-uppercase">Toplam Talep</div>
                <div class="h2 font-weight-bold text-dark my-1">@Model.GrandTotalRequests</div>
                <small class="text-muted"><i class="fa fa-list mr-1"></i>Tüm Birimler Toplamı</small>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-2">
            <div class="ibox bg-white shadow-sm rounded border p-3 border-left-success" style="border-left: 4px solid #1ab394 !important;">
                <div class="text-success small font-weight-bold text-uppercase">Karşılanan</div>
                <div class="h2 font-weight-bold text-success my-1">@Model.GrandTotalFulfilled</div>
                <small class="text-muted"><i class="fa fa-check mr-1"></i>Göreve Dönüştürülen</small>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-2">
            <div class="ibox bg-white shadow-sm rounded border p-3 border-left-danger" style="border-left: 4px solid #ed5565 !important;">
                <div class="text-danger small font-weight-bold text-uppercase">Reddedilen</div>
                <div class="h2 font-weight-bold text-danger my-1">@Model.GrandTotalRejected</div>
                <small class="text-muted"><i class="fa fa-times mr-1"></i>Gerekçeli Reddedilen</small>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-2">
            <div class="ibox bg-white shadow-sm rounded border p-3 border-left-warning" style="border-left: 4px solid #f8ac59 !important;">
                <div class="text-warning small font-weight-bold text-uppercase">Bekleyen / Diğer</div>
                <div class="h2 font-weight-bold text-warning my-1">@Model.GrandTotalPending</div>
                <small class="text-muted"><i class="fa fa-clock-o mr-1"></i>İşlem Bekleyenler</small>
            </div>
        </div>
    </div>

    <!-- RAPOR SONUÇ TABLOSU -->
    <div class="ibox shadow-sm">
        <div class="ibox-title bg-light py-2 px-3 border-bottom d-flex justify-content-between align-items-center">
            <div>
                <h5 class="font-weight-bold text-dark mb-0">
                    <i class="fa fa-table text-primary mr-1"></i> Talep Eden Birimler Bazında Talep İstatistiği
                </h5>
                <small class="text-muted">Dönem: <strong>@Model.DateRangeText</strong></small>
            </div>
            @if (Model.TotalCount > 0)
            {
                <div class="btn-group">
                    <button type="button" class="btn btn-sm btn-outline-info font-weight-bold shadow-sm d-inline-flex align-items-center"
                            data-pdf-preview data-pdf-url="@exportPdfUrl" title="Araç Talepleri Raporunu Önizle">
                        <i class="fa fa-eye mr-1"></i> Önizle
                    </button>
                    <a href="@exportPdfUrl" target="_blank" class="btn btn-sm btn-danger font-weight-bold shadow-sm d-inline-flex align-items-center">
                        <i class="fa fa-file-pdf-o mr-1"></i> PDF İndir
                    </a>
                </div>
            }
        </div>
        <div class="ibox-content p-0">
            @if (Model.TotalCount == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="fa fa-info-circle fa-2x mb-2 text-info"></i>
                    <div>Seçilen kriterlere uygun araç talebi bulunamadı.</div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0 font-13">
                        <thead class="bg-light">
                            <tr>
                                <th style="width: 50px;" class="text-center">No</th>
                                <th>Birim / Fakülte / Daire</th>
                                <th class="text-center" style="width: 140px;">Toplam Talep</th>
                                <th class="text-center" style="width: 140px;">Karşılanan</th>
                                <th class="text-center" style="width: 140px;">Reddedilen</th>
                                <th class="text-center" style="width: 160px;">Bekleyen / Diğer</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int no = ((Model.PageNumber - 1) * Model.PageSize) + 1;
                            }
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="text-center align-middle text-muted">@no</td>
                                    <td class="align-middle font-weight-bold text-dark">
                                        @item.DepartmentName
                                    </td>
                                    <td class="text-center align-middle font-weight-bold">
                                        <span class="badge badge-primary px-2 py-1">@item.TotalRequests</span>
                                    </td>
                                    <td class="text-center align-middle">
                                        <span class="badge badge-success px-2 py-1">@item.FulfilledCount</span>
                                    </td>
                                    <td class="text-center align-middle">
                                        @if (item.RejectedCount > 0)
                                        {
                                            <span class="badge badge-danger px-2 py-1">@item.RejectedCount</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">0</span>
                                        }
                                    </td>
                                    <td class="text-center align-middle">
                                        @if (item.PendingCount > 0)
                                        {
                                            <span class="badge badge-warning px-2 py-1">@item.PendingCount</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">0</span>
                                        }
                                    </td>
                                </tr>
                                no++;
                            }
                        </tbody>
                        <tfoot class="bg-light font-weight-bold">
                            <tr class="table-active">
                                <td colspan="2" class="text-right align-middle py-3">GENEL TOPLAM:</td>
                                <td class="text-center align-middle py-3 font-14 text-primary">@Model.GrandTotalRequests</td>
                                <td class="text-center align-middle py-3 font-14 text-success">@Model.GrandTotalFulfilled</td>
                                <td class="text-center align-middle py-3 font-14 text-danger">@Model.GrandTotalRejected</td>
                                <td class="text-center align-middle py-3 font-14 text-warning">@Model.GrandTotalPending</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <!-- SAYFALAMA (PAGINATION) BARI -->
                <div class="p-3 border-top d-flex flex-wrap justify-content-between align-items-center" style="gap: 10px;">
                    <span class="text-muted small">
                        Toplam <strong>@Model.TotalCount</strong> birimden 
                        <strong>@(((Model.PageNumber - 1) * Model.PageSize) + 1) - @Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount)</strong> arası gösteriliyor.
                    </span>

                    @if (Model.TotalPages > 1)
                    {
                        <ul class="pagination pagination-sm m-0">
                            @* Önceki Butonu *@
                            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("VehicleRequests", new { 
                                    PageNumber = Model.PageNumber - 1, 
                                    PageSize = Model.PageSize, 
                                    StartDate = Model.Filter.StartDate?.ToString("yyyy-MM-dd"), 
                                    EndDate = Model.Filter.EndDate?.ToString("yyyy-MM-dd"), 
                                    HasSearched = Model.Filter.HasSearched 
                                })">&laquo; Önceki</a>
                            </li>

                            @{
                                int curPage = Model.PageNumber;
                                int totPages = Model.TotalPages;
                                int maxButtons = 10;
                                
                                int startP = Math.Max(1, curPage - (maxButtons / 2));
                                int endP = Math.Min(totPages, startP + maxButtons - 1);
                                if (endP - startP + 1 < maxButtons)
                                {
                                    startP = Math.Max(1, endP - maxButtons + 1);
                                }
                            }

                            @if (startP > 1)
                            {
                                <li class="page-item @(curPage == 1 ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("VehicleRequests", new { PageNumber = 1, PageSize = Model.PageSize, StartDate = Model.Filter.StartDate?.ToString("yyyy-MM-dd"), EndDate = Model.Filter.EndDate?.ToString("yyyy-MM-dd"), HasSearched = Model.Filter.HasSearched })">1</a>
                                </li>
                                if (startP > 2)
                                {
                                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                                }
                            }

                            @for (int p = startP; p <= endP; p++)
                            {
                                <li class="page-item @(p == curPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("VehicleRequests", new { PageNumber = p, PageSize = Model.PageSize, StartDate = Model.Filter.StartDate?.ToString("yyyy-MM-dd"), EndDate = Model.Filter.EndDate?.ToString("yyyy-MM-dd"), HasSearched = Model.Filter.HasSearched })">@p</a>
                                </li>
                            }

                            @if (endP < totPages)
                            {
                                if (endP < totPages - 1)
                                {
                                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                                }
                                <li class="page-item @(curPage == totPages ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("VehicleRequests", new { PageNumber = totPages, PageSize = Model.PageSize, StartDate = Model.Filter.StartDate?.ToString("yyyy-MM-dd"), EndDate = Model.Filter.EndDate?.ToString("yyyy-MM-dd"), HasSearched = Model.Filter.HasSearched })">@totPages</a>
                                </li>
                            }

                            @* Sonraki Butonu *@
                            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("VehicleRequests", new { 
                                    PageNumber = Model.PageNumber + 1, 
                                    PageSize = Model.PageSize, 
                                    StartDate = Model.Filter.StartDate?.ToString("yyyy-MM-dd"), 
                                    EndDate = Model.Filter.EndDate?.ToString("yyyy-MM-dd"), 
                                    HasSearched = Model.Filter.HasSearched 
                                })">Sonraki &raquo;</a>
                            </li>
                        </ul>
                    }
                </div>
            }
        </div>
    </div>
</div>
