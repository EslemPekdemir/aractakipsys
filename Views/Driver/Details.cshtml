<!-- File: Views/Driver/Details.cshtml -->
@model aractakipsys.Models.ViewModels.Driver.DriverDetailsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Şoför Detayı: " + Model.FullName;
}

<div class="row wrapper border-bottom white-bg page-heading mb-4 align-items-center">
    <div class="col-md-6">
        <h2 class="font-weight-bold mb-1">Şoför Profil Kartı</h2>
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/Driver">Şoförler</a></li>
            <li class="breadcrumb-item active"><strong>@Model.FullName</strong></li>
        </ol>
    </div>
    <div class="col-md-6 text-right mt-3 mt-md-0 d-flex align-items-center justify-content-start justify-content-md-end flex-wrap" style="gap: 8px;">
        <button type="button" class="btn btn-outline-warning btn-sm font-weight-bold" data-toggle="modal" data-target="#resetPasswordModal" style="height: 32px; padding: 5px 12px; font-size: 0.85rem;">
            <i class="fa fa-key mr-1"></i> Şifre Sıfırla
        </button>
        <a href="/Driver/Edit/@Model.Id" class="btn btn-warning btn-sm font-weight-bold" style="height: 32px; padding: 5px 14px; font-size: 0.85rem; display: inline-flex; align-items: center;">
            <i class="fa fa-pencil mr-1"></i> Düzenle
        </a>
        <a href="/Driver" class="btn btn-outline-secondary btn-sm font-weight-bold" style="height: 32px; padding: 5px 14px; font-size: 0.85rem; display: inline-flex; align-items: center;">
            <i class="fa fa-arrow-left mr-1"></i> Geri Dön
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="fa fa-check-circle mr-1"></i> @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i class="fa fa-exclamation-circle mr-1"></i> @TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="row">
    <!-- SOL KOLON: ŞOFÖR VE EHLİYET BİLGİLERİ -->
    <div class="col-lg-4 mb-4">
        <div class="ibox float-e-margins">
            <div class="ibox-title bg-light d-flex justify-content-between align-items-center">
                <h5 class="m-0 font-weight-bold text-dark">Şoför Künyesi</h5>
                <span class="badge text-white px-3 py-1 @Model.StatusBadgeClass" style="border-radius: 12px; font-size: 0.85rem;">
                    @Model.StatusDisplayName
                </span>
            </div>
            <div class="ibox-content p-4">
                <div class="text-center pb-3 border-bottom mb-3">
                    <div class="rounded-circle bg-primary text-white d-inline-flex justify-content-center align-items-center mb-2" style="width: 70px; height: 70px; font-size: 1.8rem; font-weight: bold;">
                        @(Model.FullName.Length > 0 ? Model.FullName[0].ToString().ToUpper() : "Ş")
                    </div>
                    <div class="h3 font-weight-bold text-dark mb-0">
                        @Model.FullName
                    </div>
                    <span class="text-muted small">@Model.Department</span>
                </div>

                <div class="list-group list-group-flush">
                    <div class="list-group-item d-flex justify-content-between px-0 py-2 border-0">
                        <span class="text-muted font-weight-bold">E-posta:</span>
                        <span class="text-dark">@Model.Email</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between px-0 py-2 border-0">
                        <span class="text-muted font-weight-bold">Telefon:</span>
                        <span class="text-dark">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "-" : Model.PhoneNumber)</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between px-0 py-2 border-0">
                        <span class="text-muted font-weight-bold">Ehliyet Belge No:</span>
                        <span class="font-weight-bold text-primary">@Model.LicenseNumber</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between px-0 py-2 border-0">
                        <span class="text-muted font-weight-bold">Ehliyet Belge No:</span>
                        <span class="font-weight-bold text-primary">@Model.LicenseNumber</span>
                    </div>
                    <div class="list-group-item px-0 py-2 border-0">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted font-weight-bold">Ehliyet Sınıfları & Geçerlilik:</span>
                            <span class="badge badge-primary">@(Model.Licenses?.Count ?? 0) Sınıf</span>
                        </div>
                        @if (Model.Licenses != null && Model.Licenses.Any())
                        {
                            <div class="border rounded p-2 bg-light mt-1">
                                @foreach (var lic in Model.Licenses)
                                {
                                    <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                                        <span class="badge badge-info font-weight-bold mr-2" style="font-size: 0.85rem;">@lic.LicenseClass</span>
                                        <div class="text-right small">
                                            <span class="font-weight-bold @(lic.IsExpired ? "text-danger" : lic.RemainingDays <= 30 ? "text-warning" : "text-dark")">
                                                @lic.LicenseExpiryDate.ToString("dd.MM.yyyy")
                                            </span>
                                            @if (lic.IsExpired)
                                            {
                                                <span class="badge badge-danger ml-1">Süresi Doldu</span>
                                            }
                                            else if (lic.RemainingDays <= 30)
                                            {
                                                <span class="badge badge-warning ml-1">@lic.RemainingDays gün kaldı</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="badge bg-light text-dark border font-weight-bold">@Model.LicenseClass (@Model.LicenseExpiryDate.ToString("dd.MM.yyyy"))</span>
                        }
                    </div>
                    <div class="list-group-item d-flex justify-content-between px-0 py-2 border-0">
                        <span class="text-muted font-weight-bold">Kayıt Tarihi:</span>
                        <span class="text-dark">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                    </div>
                </div>

                <!-- TOPLAM İSTATİSTİKLER KUTUSU -->
                <div class="mt-3 p-3 bg-light rounded border">
                    <h6 class="font-weight-bold text-secondary mb-2">
                        <i class="fa fa-bar-chart mr-1"></i> Sürüş İstatistikleri
                    </h6>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="small text-muted">Tamamlanan Görev:</span>
                        <span class="font-weight-bold text-dark">@Model.TotalCompletedAssignments</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="small text-muted">Toplam Yapılan Yol:</span>
                        <span class="font-weight-bold text-success">@Model.TotalDrivenKm.ToString("N0") KM</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SAĞ KOLON: AKTİF GÖREV VE GEÇMİŞ GÖREVLER -->
    <div class="col-lg-8">
        <!-- 1. ANLIK AKTİF GÖREV (VARSA) -->
        @if (Model.CurrentActiveAssignment != null)
        {
            <div class="ibox float-e-margins mb-4 border-left border-primary" style="border-left-width: 5px !important;">
                <div class="ibox-title bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="m-0 font-weight-bold">
                        <i class="fa fa-location-arrow mr-1"></i> Şu Anda Devam Eden Aktif Görev
                    </h5>
                    <span class="badge font-weight-bold shadow-sm" style="background-color: #ffffff !important; color: #1e3c72 !important; border-radius: 12px; padding: 6px 14px; font-size: 0.85rem; letter-spacing: 0.5px; border: 1px solid rgba(0,0,0,0.08);">
                        <i class="fa fa-circle text-success mr-1" style="font-size: 0.65rem;"></i> GÖREVDE
                    </span>
                </div>
                <div class="ibox-content p-4">
                    <div class="row align-items-center">
                        <div class="col-md-7">
                            <div class="h4 font-weight-bold text-dark mb-1">
                                <i class="fa fa-car text-primary mr-1"></i> @Model.CurrentActiveAssignment.VehiclePlate
                                <span class="text-muted font-weight-normal h5">(@Model.CurrentActiveAssignment.VehicleBrandModel)</span>
                            </div>
                            <p class="text-dark mb-2">
                                <strong>Görev Amacı:</strong> @Model.CurrentActiveAssignment.Purpose
                            </p>
                            <span class="text-muted small">
                                <i class="fa fa-clock-o mr-1"></i> Başlangıç: @Model.CurrentActiveAssignment.ActualStartTime?.ToString("dd.MM.yyyy HH:mm")
                            </span>
                        </div>
                        <div class="col-md-5 text-md-right mt-3 mt-md-0">
                            <div class="p-3 bg-light rounded border text-center">
                                <span class="text-muted small d-block font-weight-bold">Çıkış Kilometresi</span>
                                <span class="h3 font-weight-bold text-primary mb-0">
                                    @(Model.CurrentActiveAssignment.StartKm.HasValue ? Model.CurrentActiveAssignment.StartKm.Value.ToString("N0") : "-") KM
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- 2. SON 5 GÖREVLENDİRME LİSTESİ -->
        <div class="ibox float-e-margins">
            <div class="ibox-title d-flex justify-content-between align-items-center">
                <h5 class="m-0 font-weight-bold text-dark">
                    <i class="fa fa-calendar-check-o text-primary mr-1"></i> Son Görevlendirmeler (Son 5)
                </h5>
            </div>
            <div class="ibox-content p-0">
                @if (Model.RecentAssignments.Count == 0)
                {
                    <div class="text-center py-4 text-muted">
                        <i class="fa fa-info-circle mr-1"></i> Bu şoföre ait kayıtlı görev bulunmamaktadır.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th>Araç</th>
                                    <th>Görev Amacı</th>
                                    <th>Tarih</th>
                                    <th class="text-right">Mesafe</th>
                                    <th class="text-center">Durum</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var assignment in Model.RecentAssignments)
                                {
                                    <tr>
                                        <td class="align-middle">
                                            <span class="font-weight-bold text-primary">@assignment.VehiclePlate</span>
                                            <span class="text-muted small d-block">@assignment.VehicleBrandModel</span>
                                        </td>
                                        <td class="align-middle text-truncate" style="max-width: 220px;" title="@assignment.Purpose">
                                            @assignment.Purpose
                                        </td>
                                        <td class="align-middle text-muted small">
                                            @assignment.PlannedStartTime.ToString("dd.MM.yyyy HH:mm")
                                        </td>
                                        <td class="align-middle text-right small">
                                            @if (assignment.StartKm.HasValue && assignment.EndKm.HasValue)
                                            {
                                                <span class="font-weight-bold text-success">@(assignment.EndKm.Value - assignment.StartKm.Value) KM</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td class="align-middle text-center">
                                            <span class="badge text-white px-2 py-1 @assignment.StatusBadgeClass" style="border-radius: 8px; font-size: 0.75rem;">
                                                @assignment.StatusDisplayName
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ŞİFRE SIFIRLAMA MODALI -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1" role="dialog" aria-labelledby="resetPasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title font-weight-bold" id="resetPasswordModalLabel">
                    <i class="fa fa-key text-warning mr-1"></i> Şoför Şifresini Sıfırla
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Kapat">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form method="post" action="/Driver/ResetPassword/@Model.Id">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="/Driver/Details/@Model.Id" />
                <div class="modal-body">
                    <div class="alert alert-info py-2 px-3 small">
                        <i class="fa fa-info-circle mr-1"></i>
                        <strong>@Model.FullName</strong> adlı şoför için yeni bir şifre tanımlayacaksınız. Varsa geçici hesap kilidi otomatik olarak kaldırılır.
                    </div>

                    <div class="form-group mb-0">
                        <label class="font-weight-bold text-secondary small text-uppercase">
                            Yeni Şifre <span class="text-danger">*</span>
                        </label>
                        <input type="text" name="newPassword" class="form-control font-weight-bold" 
                               placeholder="En az 10 karakter (örn. Sofor123!*)" required />
                        <small class="form-text text-muted">En az 10 karakter, büyük harf, küçük harf ve rakam içermelidir.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-warning font-weight-bold shadow-sm">
                        <i class="fa fa-refresh mr-1"></i> Şifreyi Güncelle
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
