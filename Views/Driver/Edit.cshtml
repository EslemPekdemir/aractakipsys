<!-- File: Views/Driver/Edit.cshtml -->
@model aractakipsys.Models.ViewModels.Driver.DriverEditViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Şoför Düzenle: " + Model.FullName;
}

<div class="row wrapper border-bottom white-bg page-heading mb-4">
    <div class="col-lg-10">
        <h2 class="font-weight-bold">Şoför Bilgilerini Düzenle</h2>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/Driver">Şoförler</a></li>
            <li class="breadcrumb-item active"><strong>@Model.FullName</strong></li>
        </ol>
    </div>
    <div class="col-lg-2 text-right d-flex align-items-center justify-content-end">
        <a href="/Driver" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left mr-1"></i> Listeye Dön
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="fa fa-check-circle mr-1"></i> @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i class="fa fa-exclamation-circle mr-1"></i> @TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="row">
    <div class="col-lg-12">
        <div class="ibox float-e-margins">
            <div class="ibox-title">
                <h5>Şoför Düzenleme Formu (@Model.FullName)</h5>
            </div>
            <div class="ibox-content p-4">
                <form method="post" action="/Driver/Edit/@Model.Id">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="UserId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                    <!-- İKİ KOLONLU FORM (ARAYUZ-SPESIFIKASYONU Bölüm 7) -->
                    <div class="row">
                        <!-- SOL KOLON: KULLANICI BİLGİLERİ -->
                        <div class="col-md-6 border-right">
                            <h5 class="font-weight-bold text-primary mb-3 border-bottom pb-2">
                                <i class="fa fa-user mr-1"></i> Temel Kullanıcı Bilgileri
                            </h5>

                            <div class="form-group mb-3">
                                <label asp-for="FullName" class="font-weight-bold">Ad Soyad <span class="text-danger">*</span></label>
                                <input asp-for="FullName" class="form-control font-weight-bold" />
                                <span asp-validation-for="FullName" class="text-danger small font-weight-bold"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Email" class="font-weight-bold">E-posta Adresi <span class="text-danger">*</span></label>
                                <input asp-for="Email" type="email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger small font-weight-bold"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="PhoneNumber" class="font-weight-bold">Telefon Numarası</label>
                                <input asp-for="PhoneNumber" class="form-control" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small font-weight-bold"></span>
                            </div>

                            <div class="form-group mb-3 p-3 bg-light rounded border">
                                <label class="font-weight-bold text-dark d-block mb-1">Hesap Durumu</label>
                                <div class="form-check">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveCheck" />
                                    <label class="form-check-label font-weight-bold text-dark" for="isActiveCheck">
                                        Şoför Hesabı Aktif
                                    </label>
                                </div>
                                <small class="text-muted d-block mt-1">
                                    <i class="fa fa-info-circle mr-1"></i> Pasife alınan şoför sisteme giriş yapamaz ve kendisine yeni görev atanamaz.
                                </small>
                            </div>
                        </div>

                        <!-- SAĞ KOLON: EHLİYET VE BİRİM -->
                        <div class="col-md-6 pl-md-4 mt-4 mt-md-0">
                            <h5 class="font-weight-bold text-primary mb-3 border-bottom pb-2">
                                <i class="fa fa-id-card mr-1"></i> Sürücü Belgesi ve Birim Bilgileri
                            </h5>

                            <div class="row mb-3">
                                <div class="col-12 col-sm-7 mb-3 mb-sm-0">
                                    <label asp-for="LicenseNumber" class="font-weight-bold">Ehliyet Belge No <span class="text-danger">*</span></label>
                                    <input asp-for="LicenseNumber" class="form-control text-uppercase font-weight-bold" />
                                    <span asp-validation-for="LicenseNumber" class="text-danger small font-weight-bold"></span>
                                </div>
                                <div class="col-12 col-sm-5">
                                    <label asp-for="LicenseClass" class="font-weight-bold">Ehliyet Sınıfı <span class="text-danger">*</span></label>
                                    <input asp-for="LicenseClass" class="form-control text-uppercase" />
                                    <span asp-validation-for="LicenseClass" class="text-danger small font-weight-bold"></span>
                                </div>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="LicenseExpiryDate" class="font-weight-bold">Ehliyet Son Geçerlilik Tarihi <span class="text-danger">*</span></label>
                                <input asp-for="LicenseExpiryDate" type="date" class="form-control" />
                                <span asp-validation-for="LicenseExpiryDate" class="text-danger small font-weight-bold"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Department" class="font-weight-bold">Bağlı Olunan Birim / Departman <span class="text-danger">*</span></label>
                                <input asp-for="Department" class="form-control" />
                                <span asp-validation-for="Department" class="text-danger small font-weight-bold"></span>
                            </div>
                        </div>
                    </div>

                    <!-- ALT BUTONLAR -->
                    <div class="hr-line-dashed mt-4"></div>
                    <div class="d-flex flex-column flex-sm-row justify-content-end align-items-stretch align-items-sm-center">
                        <a href="/Driver" class="btn btn-outline-secondary mb-2 mb-sm-0 mr-sm-2 px-4 font-weight-bold text-center">
                            <i class="fa fa-times mr-1"></i> İptal
                        </a>
                        <button type="submit" class="btn btn-primary mb-0 px-5 font-weight-bold shadow-sm">
                            <i class="fa fa-check mr-1"></i> Değişiklikleri Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- HESAP GÜVENLİĞİ VE ŞİFRE SIFIRLAMA KARTI -->
    <div class="col-lg-12 mt-3">
        <div class="ibox float-e-margins border" style="border-radius: 6px; overflow: hidden;">
            <div class="ibox-title bg-light border-bottom d-flex justify-content-between align-items-center py-2 px-3">
                <h5 class="text-dark font-weight-bold m-0" style="font-size: 0.95rem;">
                    <i class="fa fa-key text-warning mr-2"></i> Şoför Şifresini Sıfırla / Yeni Parola Belirle
                </h5>
            </div>
            <div class="ibox-content p-4">
                <div class="alert alert-info py-2 px-3 mb-3 small d-flex align-items-start" style="border-radius: 6px;">
                    <i class="fa fa-info-circle mr-2 mt-1 text-info" style="font-size: 0.95rem;"></i>
                    <div>
                        Şoför şifresini unuttuğunda buradan doğrudan yeni bir şifre tanımlayabilirsiniz. Belirlenen yeni şifre anında aktif olur ve varsa geçici hesap kilidi kaldırılır.
                    </div>
                </div>

                <form method="post" action="/Driver/ResetPassword/@Model.Id">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="/Driver/Edit/@Model.Id" />

                    <div class="form-group mb-0">
                        <label for="newDriverPassword" class="font-weight-bold text-dark small mb-1">
                            Yeni Şifre <span class="text-danger">*</span>
                        </label>
                        <div class="row">
                            <div class="col-12 col-md-7 col-lg-6 mb-2 mb-md-0">
                                <div class="input-group flex-nowrap">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-white border-right-0" style="border-radius: 6px 0 0 6px;">
                                            <i class="fa fa-lock text-muted"></i>
                                        </span>
                                    </div>
                                    <input type="text" id="newDriverPassword" name="newPassword" 
                                           class="form-control font-weight-bold border-left-0" 
                                           placeholder="En az 10 karakter (örn. Sofor123!*)" 
                                           style="border-radius: 0 6px 6px 0; height: 42px; font-size: 0.92rem;" required />
                                </div>
                                <small class="form-text text-muted mt-1">
                                    <i class="fa fa-shield text-muted mr-1"></i> En az 10 karakter; büyük harf, küçük harf ve rakam içermelidir.
                                </small>
                            </div>
                            <div class="col-12 col-md-5 col-lg-4">
                                <button type="submit" class="btn btn-warning font-weight-bold text-white shadow-sm w-100" 
                                        style="height: 42px; min-height: 42px; border-radius: 6px; font-size: 0.92rem; white-space: nowrap;"
                                        onclick="return confirm('@Model.FullName adlı şoförün şifresi güncellenecektir. Onaylıyor musunuz?');">
                                    <i class="fa fa-refresh mr-1"></i> Yeni Şifreyi Kaydet
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
