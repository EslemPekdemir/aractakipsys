<!-- File: Views/Driver/Create.cshtml -->
@model aractakipsys.Models.ViewModels.Driver.DriverCreateViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Yeni Şoför Ekle";
}

<div class="row wrapper border-bottom white-bg page-heading mb-4">
    <div class="col-lg-10">
        <h2 class="font-weight-bold">Yeni Şoför Ekle</h2>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/Driver">Şoförler</a></li>
            <li class="breadcrumb-item active"><strong>Yeni Ekle</strong></li>
        </ol>
    </div>
    <div class="col-lg-2 text-right d-flex align-items-center justify-content-end">
        <a href="/Driver" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left mr-1"></i> Listeye Dön
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="ibox float-e-margins">
            <div class="ibox-title">
                <h5>Şoför Kayıt ve Kullanıcı Tanım Formu</h5>
            </div>
            <div class="ibox-content p-4">
                <form method="post" action="/Driver/Create">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                    <!-- İKİ KOLONLU FORM (ARAYUZ-SPESIFIKASYONU Bölüm 7) -->
                    <div class="row">
                        <!-- SOL KOLON: KULLANICI VE GİRİŞ BİLGİLERİ -->
                        <div class="col-md-6 border-right">
                            <h5 class="font-weight-bold text-primary mb-3 border-bottom pb-2">
                                <i class="fa fa-user mr-1"></i> Kullanıcı ve Giriş Bilgileri
                            </h5>

                            <div class="form-group mb-3">
                                <label asp-for="FullName" class="font-weight-bold">Ad Soyad <span class="text-danger">*</span></label>
                                <input asp-for="FullName" class="form-control" placeholder="Örn: Ahmet Yılmaz" />
                                <span asp-validation-for="FullName" class="text-danger small font-weight-bold"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Email" class="font-weight-bold">Kurumsal E-posta Adresi <span class="text-danger">*</span></label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="Örn: ahmet.yilmaz@duzce.edu.tr" />
                                <span asp-validation-for="Email" class="text-danger small font-weight-bold"></span>
                                <small class="form-text text-muted">Şoför mobil panele bu e-posta adresiyle giriş yapacaktır.</small>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="PhoneNumber" class="font-weight-bold">Telefon Numarası</label>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="Örn: 0532 111 22 33" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small font-weight-bold"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Password" class="font-weight-bold">Geçici Giriş Parolası <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input asp-for="Password" id="passwordInput" type="text" class="form-control font-monospace" placeholder="En az 10 karakter, büyük/küçük harf, rakam, sembol" />
                                    <div class="input-group-append">
                                        <button type="button" class="btn btn-outline-secondary" onclick="generateRandomPassword()" title="Güçlü Şifre Üret">
                                            <i class="fa fa-magic mr-1"></i> Üret
                                        </button>
                                    </div>
                                </div>
                                <span asp-validation-for="Password" class="text-danger small font-weight-bold"></span>
                                <small class="form-text text-muted">Şoförün ilk girişte şifresini değiştirmesi önerilir.</small>
                            </div>
                        </div>

                        <!-- SAĞ KOLON: EHLİYET VE GÖREV BİLGİLERİ -->
                        <div class="col-md-6 pl-md-4 mt-4 mt-md-0">
                            <h5 class="font-weight-bold text-primary mb-3 border-bottom pb-2">
                                <i class="fa fa-id-card mr-1"></i> Sürücü Belgesi ve Birim Bilgileri
                            </h5>

                            <div class="row mb-3">
                                <div class="col-12 col-sm-7 mb-3 mb-sm-0">
                                    <label asp-for="LicenseNumber" class="font-weight-bold">Ehliyet Belge No <span class="text-danger">*</span></label>
                                    <input asp-for="LicenseNumber" class="form-control text-uppercase" placeholder="Örn: TR-81-99881" />
                                    <span asp-validation-for="LicenseNumber" class="text-danger small font-weight-bold"></span>
                                </div>
                                <div class="col-12 col-sm-5">
                                    <label asp-for="LicenseClass" class="font-weight-bold">Ehliyet Sınıfı <span class="text-danger">*</span></label>
                                    <input asp-for="LicenseClass" class="form-control text-uppercase" placeholder="Örn: B, D, E" />
                                    <span asp-validation-for="LicenseClass" class="text-danger small font-weight-bold"></span>
                                </div>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="LicenseExpiryDate" class="font-weight-bold">Ehliyet Son Geçerlilik Tarihi <span class="text-danger">*</span></label>
                                <input asp-for="LicenseExpiryDate" type="date" class="form-control" />
                                <span asp-validation-for="LicenseExpiryDate" class="text-danger small font-weight-bold"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Department" class="font-weight-bold">Bağlı Olunan Birim / Departman <span class="text-danger">*</span></label>
                                <input asp-for="Department" class="form-control" placeholder="Örn: Rektörlük Ulaştırma Birimi" />
                                <span asp-validation-for="Department" class="text-danger small font-weight-bold"></span>
                            </div>
                        </div>
                    </div>

                    <!-- ALT BUTONLAR (ARAYUZ-SPESIFIKASYONU Bölüm 7) -->
                    <div class="hr-line-dashed mt-4"></div>
                    <div class="d-flex flex-column flex-sm-row justify-content-end align-items-stretch align-items-sm-center">
                        <a href="/Driver" class="btn btn-outline-secondary mb-2 mb-sm-0 mr-sm-2 px-4 font-weight-bold text-center">
                            <i class="fa fa-times mr-1"></i> İptal
                        </a>
                        <button type="submit" class="btn btn-primary mb-0 px-5 font-weight-bold shadow-sm">
                            <i class="fa fa-check mr-1"></i> Şoförü Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function generateRandomPassword() {
        const lower = "abcdefghijkmnopqrstuvwxyz";
        const upper = "ABCDEFGHJKLMNOPQRSTUVWXYZ";
        const digits = "0123456789";
        const specials = "!@@$?_-*";

        let pwd = "";
        pwd += lower[Math.floor(Math.random() * lower.length)];
        pwd += upper[Math.floor(Math.random() * upper.length)];
        pwd += digits[Math.floor(Math.random() * digits.length)];
        pwd += specials[Math.floor(Math.random() * specials.length)];

        const all = lower + upper + digits + specials;
        while (pwd.length < 12) {
            pwd += all[Math.floor(Math.random() * all.length)];
        }

        // Shuffle
        const arr = pwd.split('');
        for (let i = arr.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [arr[i], arr[j]] = [arr[j], arr[i]];
        }
        $('#passwordInput').val(arr.join(''));
    }
</script>
}
