<!-- File: Views/Sef/Edit.cshtml -->
@model aractakipsys.Models.ViewModels.Sef.SefEditViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Ulaşım Şefi Bilgilerini Düzenle";
}

<div class="row wrapper border-bottom white-bg page-heading mb-4">
    <div class="col-lg-8">
        <h2 class="font-weight-bold">Ulaşım Şefi Bilgilerini Düzenle</h2>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/Sef">Ulaşım Şefleri</a></li>
            <li class="breadcrumb-item active"><strong>Düzenle</strong></li>
        </ol>
    </div>
    <div class="col-lg-4 text-right d-flex align-items-center justify-content-end">
        <a href="/Sef" class="btn btn-outline-secondary font-weight-bold">
            <i class="fa fa-arrow-left mr-1"></i> Listeye Geri Dön
        </a>
    </div>
</div>

<div class="wrapper wrapper-content animated fadeInRight p-0">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <div class="ibox shadow-sm">
                <div class="ibox-title bg-light d-flex justify-content-between align-items-center">
                    <h5 class="font-weight-bold text-dark mb-0">
                        <i class="fa fa-pencil text-primary mr-1"></i> @Model.FullName — Profil Düzenleme
                    </h5>
                    <small class="text-muted">ID: @Model.Id</small>
                </div>
                <div class="ibox-content p-4">
                    <form asp-action="Edit" method="post" id="sefEditForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="fa fa-exclamation-circle mr-2"></i>
                                @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                                {
                                    <div>@error.ErrorMessage</div>
                                }
                                <button type="button" class="close" data-dismiss="alert" aria-label="Kapat">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                        }

                        <!-- KULLANICI ADI & E-POSTA (SABİT / BİLGİ) -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="font-weight-bold text-muted small mb-1">Kullanıcı Adı</label>
                                <input type="text" class="form-control bg-light" value="@Model.UserName" readonly disabled />
                                <small class="text-muted">Kullanıcı adı sistem güvenliği gereği değiştirilemez.</small>
                            </div>
                            <div class="col-md-6">
                                <label class="font-weight-bold text-muted small mb-1">Kurumsal E-Posta</label>
                                <input type="text" class="form-control bg-light" value="@Model.Email" readonly disabled />
                                <small class="text-muted">Kurumsal e-posta adresi sabittir.</small>
                            </div>
                        </div>

                        <!-- ROL SEÇİMİ (Saf Admin için) -->
                        @if (User.IsInRole("Admin"))
                        {
                            <div class="form-group mb-3">
                                <label asp-for="Role" class="font-weight-bold text-dark small mb-1">
                                    Kullanıcı Rolü <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Role" class="form-control" required>
                                    <option value="Kullanici">Ulaşım / Birim Şefi (Kullanici)</option>
                                    <option value="DaireBaskani">Daire Başkanı (DaireBaskani)</option>
                                    <option value="GenelSekreter">Genel Sekreter (GenelSekreter)</option>
                                </select>
                                <span asp-validation-for="Role" class="text-danger small font-weight-bold"></span>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="Role" />
                        }

                        <div class="hr-line-dashed my-3"></div>

                        <!-- AD SOYAD -->
                        <div class="form-group mb-3">
                            <label asp-for="FullName" class="font-weight-bold text-dark small mb-1">
                                Ad Soyad <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text"><i class="fa fa-user"></i></span>
                                </div>
                                <input asp-for="FullName" class="form-control" placeholder="Ad Soyad" required />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small font-weight-bold"></span>
                        </div>

                        <!-- TELEFON -->
                        <div class="form-group mb-3">
                            <label asp-for="PhoneNumber" class="font-weight-bold text-dark small mb-1">
                                Telefon Numarası
                            </label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text"><i class="fa fa-phone"></i></span>
                                </div>
                                <input asp-for="PhoneNumber" type="tel" class="form-control" placeholder="05xx xxx xx xx" />
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-danger small font-weight-bold"></span>
                        </div>

                        <!-- HESAP DURUMU (Pasife Alma / Aktifleştirme) -->
                        <div class="form-group mb-4">
                            <div class="custom-control custom-checkbox">
                                <input type="checkbox" asp-for="IsActive" class="custom-control-input" id="checkIsActive" />
                                <label class="custom-control-label font-weight-bold text-dark" for="checkIsActive">
                                    Hesap Aktif (Şef sisteme giriş yapabilir ve işlem yürütebilir)
                                </label>
                            </div>
                            <small class="text-muted d-block mt-1">İşareti kaldırırsanız hesap dondurulur/pasife alınır ve şef oturum açamaz. Hesabı tamamen kaldırmak için "Hesabı Sil" butonunu kullanınız.</small>
                        </div>

                        <!-- SUBMIT & AKSİYON BUTONLARI -->
                        @{
                            var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                            var isSelf = !string.IsNullOrWhiteSpace(currentUserId) && Model.Id == currentUserId;
                        }
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <div>
                                <a href="/Sef" class="btn btn-outline-secondary font-weight-bold px-3">
                                    İptal
                                </a>
                                @if (!isSelf)
                                {
                                    <button type="button" class="btn btn-outline-danger font-weight-bold px-3 ml-2" data-toggle="modal" data-target="#deleteSefModal">
                                        <i class="fa fa-trash mr-1"></i> Hesabı Sil
                                    </button>
                                }
                            </div>
                            <button type="submit" class="btn btn-primary font-weight-bold px-4 shadow-sm">
                                <i class="fa fa-check mr-1"></i> Değişiklikleri Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <!-- SİLME ONAY MODALI (layout'ta </body> öncesine render edilir, backdrop kilitlenmesi kesinlikle yaşanmaz) -->
    <div class="modal fade" id="deleteSefModal" tabindex="-1" role="dialog" aria-labelledby="deleteSefModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title font-weight-bold" id="deleteSefModalLabel">
                        <i class="fa fa-exclamation-triangle mr-2"></i> Hesabı Silme Onayı
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Kapat">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body p-4">
                    <p class="font-weight-bold text-dark font-15 mb-2">
                        Bu hesabı silmek istediğinize emin misiniz?
                    </p>
                    <div class="alert alert-warning py-2 px-3 small mb-0">
                        <i class="fa fa-info-circle mr-1"></i>
                        <strong>@Model.FullName</strong> (<code>@Model.UserName</code>) hesabı sistemden kaldırılacaktır. Kullanıcı artık sisteme giriş yapamaz. Geçmiş görev, denetim (AuditLog) ve vekâlet kayıtları korunacaktır.
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary font-weight-bold" data-dismiss="modal">Vazgeç</button>
                    <form method="post" action="/Sef/Delete/@Model.Id" class="d-inline m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger font-weight-bold shadow-sm">
                            <i class="fa fa-trash mr-1"></i> Evet, Hesabı Sil
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            // Modal'ın doğrudan body altına taşınması (iç içe backdrop ve CSS transform kilitlenmelerini kesinlikle önler)
            $('#deleteSefModal').appendTo('body');
        });
    </script>
}
