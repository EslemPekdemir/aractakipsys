@model aractakipsys.Models.ViewModels.Assignment.SignedDocumentArchiveViewModel
@using aractakipsys.Models.ViewModels.Assignment
@using aractakipsys.Models.Enums
@{
    ViewData["Title"] = "İmzalı Evrak Arşivi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
}

<!-- BAŞLIK & BREADCRUMB -->
<div class="row wrapper border-bottom white-bg page-heading mb-4 align-items-center py-3">
    <div class="col-12 col-sm-8 mb-2 mb-sm-0">
        <h2 class="font-weight-bold mb-1"><i class="fa fa-file-text text-primary mr-2"></i> İmzalı Evrak Arşivi ve Takibi</h2>
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/Assignment">Görevler</a></li>
            <li class="breadcrumb-item active"><strong>İmzalı Evrak Arşivi</strong></li>
        </ol>
    </div>
    <div class="col-12 col-sm-4 text-left text-sm-right">
        <a href="/Assignment" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left mr-1"></i> Listeye Dön
        </a>
    </div>
</div>

<!-- ALERT BİLDİRİMLERİ -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fa fa-check-circle mr-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Kapat">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fa fa-exclamation-circle mr-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Kapat">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<!-- KPI KARTLARI (MOBİLDE 2x2, MASAÜSTÜNDE 4'LÜ TAŞMA KORUMALI DÜZEN) -->
<div class="row mb-3 signed-doc-kpi-row">
    <!-- KART 1: YÜKLENEN İMZALI BELGE -->
    <div class="col-6 col-md-6 col-lg-3 mb-2 px-1 px-sm-2">
        <div class="ibox mb-0 shadow-sm border-left border-success h-100" style="border-left-width: 4px !important; border-radius: 8px;">
            <div class="ibox-content">
                <div class="d-flex justify-content-between align-items-center" style="min-width: 0;">
                    <div class="kpi-text-col">
                        <span class="text-muted font-weight-bold text-uppercase d-block text-truncate kpi-title">Yüklenen İmzalı Belge</span>
                        <div class="font-weight-bold text-success my-1 kpi-num">@Model.TotalUploadedCount.ToString("N0")</div>
                        <small class="text-muted text-truncate d-block kpi-sub">Sistemde arşivlenen resmi evrak</small>
                    </div>
                    <div class="rounded-circle d-none d-sm-flex align-items-center justify-content-center ml-2 kpi-icon bg-success-light text-success">
                        <i class="fa fa-file-pdf-o"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- KART 2: BELGE BEKLEYEN GÖREVLER -->
    <div class="col-6 col-md-6 col-lg-3 mb-2 px-1 px-sm-2">
        <div class="ibox mb-0 shadow-sm border-left border-warning h-100" style="border-left-width: 4px !important; border-radius: 8px;">
            <div class="ibox-content">
                <div class="d-flex justify-content-between align-items-center" style="min-width: 0;">
                    <div class="kpi-text-col">
                        <span class="text-muted font-weight-bold text-uppercase d-block text-truncate kpi-title">Belge Bekleyen Görevler</span>
                        <div class="font-weight-bold text-warning my-1 kpi-num">@Model.TotalMissingCount.ToString("N0")</div>
                        <small class="text-muted text-truncate d-block kpi-sub">Tamamlanıp belgesi yüklenmeyenler</small>
                    </div>
                    <div class="rounded-circle d-none d-sm-flex align-items-center justify-content-center ml-2 kpi-icon bg-warning-light text-warning">
                        <i class="fa fa-clock-o"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- KART 3: ARŞİVLEME ORANI -->
    <div class="col-6 col-md-6 col-lg-3 mb-2 px-1 px-sm-2">
        <div class="ibox mb-0 shadow-sm border-left border-info h-100" style="border-left-width: 4px !important; border-radius: 8px;">
            <div class="ibox-content">
                <div class="d-flex justify-content-between align-items-center" style="min-width: 0;">
                    <div class="kpi-text-col">
                        <span class="text-muted font-weight-bold text-uppercase d-block text-truncate kpi-title">Arşivleme Oranı</span>
                        <div class="font-weight-bold text-info my-1 kpi-num">%@Model.UploadRatePercentage</div>
                        <small class="text-muted text-truncate d-block kpi-sub">Toplam @Model.TotalAssignmentsCount görev üzerinden</small>
                    </div>
                    <div class="rounded-circle d-none d-sm-flex align-items-center justify-content-center ml-2 kpi-icon bg-info-light text-info">
                        <i class="fa fa-pie-chart"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- KART 4: BU AY ARŞİVLENEN -->
    <div class="col-6 col-md-6 col-lg-3 mb-2 px-1 px-sm-2">
        <div class="ibox mb-0 shadow-sm border-left border-primary h-100" style="border-left-width: 4px !important; border-radius: 8px;">
            <div class="ibox-content">
                <div class="d-flex justify-content-between align-items-center" style="min-width: 0;">
                    <div class="kpi-text-col">
                        <span class="text-muted font-weight-bold text-uppercase d-block text-truncate kpi-title">Bu Ay Arşivlenen</span>
                        <div class="font-weight-bold text-primary my-1 kpi-num">@Model.UploadedThisMonthCount.ToString("N0")</div>
                        <small class="text-muted text-truncate d-block kpi-sub">İçinde bulunulan ay içinde</small>
                    </div>
                    <div class="rounded-circle d-none d-sm-flex align-items-center justify-content-center ml-2 kpi-icon bg-primary-light text-primary">
                        <i class="fa fa-calendar-check-o"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ÜST FİLTRE ÇUBUĞU (ARAYUZ-SPESIFIKASYONU & DİĞER SAYFALARLA BİREBİR AYNI KURUMSAL STİL) -->
<div class="ibox float-e-margins mb-3">
    <div class="ibox-content p-3 border-left border-primary" style="border-left-width: 4px !important;">
        <form method="get" action="/Assignment/SignedDocuments" class="row align-items-end">
            <!-- 1. EVRAK DURUMU -->
            <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6 mb-2">
                <label class="small font-weight-bold text-muted mb-1">Evrak Durumu</label>
                <select name="DocumentFilter" class="form-control select2-filter" id="filterDocumentStatus" onchange="this.form.submit()">
                    <option value="Uploaded" selected="@(Model.Filter.DocumentFilter == SignedDocumentFilterType.Uploaded ? "selected" : null)">Yüklenenler (Arşiv)</option>
                    <option value="Missing" selected="@(Model.Filter.DocumentFilter == SignedDocumentFilterType.Missing ? "selected" : null)">Belgesi Eksik (@Model.TotalMissingCount)</option>
                    <option value="All" selected="@(Model.Filter.DocumentFilter == SignedDocumentFilterType.All ? "selected" : null)">Tümü (@Model.TotalAssignmentsCount)</option>
                </select>
            </div>

            <!-- 2. ARAÇ -->
            <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6 mb-2">
                <label class="small font-weight-bold text-muted mb-1">Araç</label>
                <select name="VehicleId" class="form-control select2-filter" id="filterVehicle">
                    <option value="">Tüm Araçlar</option>
                    @foreach (var v in Model.VehicleList)
                    {
                        var isSelected = Model.Filter.VehicleId?.ToString() == v.Value;
                        <option value="@v.Value" selected="@(isSelected ? "selected" : null)">@v.Text</option>
                    }
                </select>
            </div>

            <!-- 3. ŞOFÖR -->
            <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6 mb-2">
                <label class="small font-weight-bold text-muted mb-1">Şoför</label>
                <select name="DriverId" class="form-control select2-filter" id="filterDriver">
                    <option value="">Tüm Şoförler</option>
                    @foreach (var d in Model.DriverList)
                    {
                        var isSelected = Model.Filter.DriverId?.ToString() == d.Value;
                        <option value="@d.Value" selected="@(isSelected ? "selected" : null)">@d.Text</option>
                    }
                </select>
            </div>

            <!-- 4. BAŞLANGIÇ & BİTİŞ TARİHİ -->
            <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6 mb-2">
                <label class="small font-weight-bold text-muted mb-1">Tarih Aralığı</label>
                <div class="d-flex align-items-center">
                    <input type="date" name="StartDate" class="form-control" style="height: 35px; font-size: 0.8rem; padding: 2px 6px; flex: 1 1 0%; min-width: 0;" value="@(Model.Filter.StartDate?.ToString("yyyy-MM-dd"))" title="Başlangıç Tarihi">
                    <span class="mx-1 text-muted">-</span>
                    <input type="date" name="EndDate" class="form-control" style="height: 35px; font-size: 0.8rem; padding: 2px 6px; flex: 1 1 0%; min-width: 0;" value="@(Model.Filter.EndDate?.ToString("yyyy-MM-dd"))" title="Bitiş Tarihi">
                </div>
            </div>

            <!-- 5. ARAMA METNİ -->
            <div class="col-xl-3 col-lg-8 col-md-6 col-sm-8 mb-2">
                <label class="small font-weight-bold text-muted mb-1">Arama</label>
                <div class="input-group">
                    <input type="text" name="SearchTerm" class="form-control" style="height: 35px;" placeholder="Plaka, şoför, birim, dosya..." value="@Model.Filter.SearchTerm">
                    <div class="input-group-append">
                        <button class="btn btn-primary d-flex align-items-center justify-content-center" type="submit" style="height: 35px; padding: 0 14px; margin-bottom: 0 !important;" title="Ara">
                            <i class="fa fa-search"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- 6. TEMİZLE BUTONU -->
            <div class="col-xl-1 col-lg-4 col-md-2 col-sm-4 mb-2 text-right">
                <a href="/Assignment/SignedDocuments" class="btn btn-outline-secondary btn-block d-inline-flex align-items-center justify-content-center" style="height: 35px; margin-bottom: 0;" title="Filtreleri Temizle">
                    <i class="fa fa-refresh mr-1"></i> Temizle
                </a>
            </div>
        </form>
    </div>
</div>

<!-- EVRAK LİSTESİ (MASAÜSTÜNDE DETAYLI TABLO, MOBİLDE DOKUNMATİK KARTLAR) -->
<div class="ibox shadow-sm" style="border-radius: 8px;">
    <div class="ibox-title bg-white d-flex justify-content-between align-items-center" style="border-radius: 8px 8px 0 0;">
        <h5 class="m-0 font-weight-bold text-dark">
            <i class="fa fa-archive text-primary mr-1"></i> İmzalı Evrak Kayıtları
            <span class="badge badge-primary ml-2">@Model.Filter.TotalCount Kayıt</span>
        </h5>
    </div>
    <div class="ibox-content p-0">
        @if (!Model.Items.Any())
        {
            <div class="text-center py-5">
                <div class="mb-3">
                    <i class="fa fa-folder-open-o text-muted" style="font-size: 4rem; opacity: 0.3;"></i>
                </div>
                <h4 class="font-weight-bold text-secondary">Kayıtlı İmzalı Belge Bulunamadı</h4>
                <p class="text-muted mb-3">Seçilen filtre kriterlerine uygun bir görevlendirme evrakı bulunamadı.</p>
                <a href="/Assignment/SignedDocuments" class="btn btn-outline-primary btn-sm">
                    <i class="fa fa-refresh mr-1"></i> Tüm Arşivi Göster
                </a>
            </div>
        }
        else
        {
            <!-- 1. MASAÜSTÜ & TABLET TABLO GÖRÜNÜMÜ -->
            <div class="table-responsive d-none d-md-block">
                <table class="table table-striped table-hover mb-0 align-middle">
                    <thead class="bg-light text-dark">
                        <tr>
                            <th style="min-width: 80px;">Görev #</th>
                            <th style="min-width: 130px;">Araç</th>
                            <th style="min-width: 140px;">Şoför</th>
                            <th style="min-width: 180px;">Talep Eden & Görev Amacı</th>
                            <th style="min-width: 130px;">Görev Zamanı</th>
                            <th style="min-width: 190px;">İmzalı Belge</th>
                            <th style="min-width: 160px;">Yükleyen & Tarih</th>
                            <th class="text-right" style="min-width: 170px;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="font-weight-bold text-dark align-middle">
                                    <a href="/Assignment/Details/@item.AssignmentId" title="Görev Detayına Git" class="text-primary font-weight-bold">
                                        #@item.AssignmentId
                                    </a>
                                    <div class="mt-1">
                                        <span class="badge @item.StatusBadgeClass text-white" style="font-size: 0.68rem;">
                                            @item.StatusDisplayName
                                        </span>
                                    </div>
                                </td>
                                <td class="align-middle">
                                    <span class="font-weight-bold text-dark font-14">@item.VehiclePlate</span>
                                    <div class="small text-muted">@item.VehicleBrandModel</div>
                                </td>
                                <td class="align-middle font-weight-bold text-dark">
                                    @item.DriverFullName
                                </td>
                                <td class="align-middle">
                                    <div class="font-weight-bold text-dark small">@item.RequestedByDepartment</div>
                                    <div class="text-muted small text-truncate" style="max-width: 220px;" title="@item.Purpose">
                                        @item.Purpose
                                    </div>
                                </td>
                                <td class="align-middle small">
                                    <div class="font-weight-bold text-dark">@item.PlannedStartTime.ToString("dd.MM.yyyy")</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">@item.PlannedStartTime.ToString("HH:mm") - @item.PlannedEndTime.ToString("HH:mm")</div>
                                </td>
                                <td class="align-middle">
                                    @if (item.HasDocument)
                                    {
                                        <div class="d-flex align-items-center">
                                            @if (item.IsPdf)
                                            {
                                                <i class="fa fa-file-pdf-o text-danger mr-2" style="font-size: 1.8rem;" title="PDF Belgesi"></i>
                                            }
                                            else if (item.IsImage)
                                            {
                                                <i class="fa fa-file-image-o text-success mr-2" style="font-size: 1.8rem;" title="Görsel Dosyası"></i>
                                            }
                                            else
                                            {
                                                <i class="fa fa-file-text-o text-primary mr-2" style="font-size: 1.8rem;" title="Belge"></i>
                                            }
                                            <div class="text-truncate" style="max-width: 160px;" title="@item.DocumentOriginalFileName">
                                                <span class="font-weight-bold text-dark small d-block text-truncate">@item.DocumentOriginalFileName</span>
                                                <span class="badge badge-success font-weight-normal" style="font-size: 0.68rem;">
                                                    <i class="fa fa-check mr-1"></i> Yüklendi
                                                </span>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning text-dark font-weight-bold px-2 py-1" style="font-size: 0.75rem;">
                                            <i class="fa fa-exclamation-triangle mr-1"></i> Belge Bekleniyor
                                        </span>
                                    }
                                </td>
                                <td class="align-middle small">
                                    @if (item.HasDocument)
                                    {
                                        <div class="font-weight-bold text-dark">@(item.UploadedByFullName ?? "Sistem Yetkilisi")</div>
                                        <div class="text-muted" style="font-size: 0.75rem;">
                                            <i class="fa fa-clock-o mr-1"></i> @(item.UploadedAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="align-middle text-right text-nowrap">
                                    @if (item.HasDocument)
                                    {
                                        <a href="/Assignment/ViewSignedDocument/@item.AssignmentId" target="_blank" class="btn btn-outline-info btn-xs mr-1" title="Yeni Sekmede Önizle">
                                            <i class="fa fa-eye"></i> Önizle
                                        </a>
                                        <a href="/Assignment/DownloadSignedDocument/@item.AssignmentId" class="btn btn-outline-success btn-xs mr-1" title="Belgeyi İndir">
                                            <i class="fa fa-download"></i> İndir
                                        </a>
                                        <button type="button" class="btn btn-outline-secondary btn-xs" title="Belgeyi Değiştir" onclick="openUploadModal(@item.AssignmentId, '@item.VehiclePlate', '@item.DriverFullName')">
                                            <i class="fa fa-refresh"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-warning btn-xs font-weight-bold mr-1" title="İmzalı Belgeyi Şimdi Yükle" onclick="openUploadModal(@item.AssignmentId, '@item.VehiclePlate', '@item.DriverFullName')">
                                            <i class="fa fa-upload mr-1"></i> Belge Yükle
                                        </button>
                                        <a href="/Assignment/Details/@item.AssignmentId" class="btn btn-outline-primary btn-xs" title="Görev Detayına Git">
                                            <i class="fa fa-arrow-right"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- 2. MOBİL KART GÖRÜNÜMÜ (< 768px İÇİN ÖZEL DOKUNMATİK DÜZEN) -->
            <div class="d-block d-md-none p-2 bg-light">
                @foreach (var item in Model.Items)
                {
                    <div class="card mb-3 shadow-sm border" style="border-radius: 10px; overflow: hidden; background: #ffffff;">
                        <div class="card-body p-3">
                            <!-- ÜST BAŞLIK: GÖREV NO, DURUM, TARİH -->
                            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2">
                                <div>
                                    <a href="/Assignment/Details/@item.AssignmentId" class="font-weight-bold text-primary font-14">
                                        #@item.AssignmentId
                                    </a>
                                    <span class="badge @item.StatusBadgeClass text-white ml-1" style="font-size: 0.70rem;">
                                        @item.StatusDisplayName
                                    </span>
                                </div>
                                <div class="small text-muted font-weight-bold">
                                    <i class="fa fa-calendar mr-1 text-primary"></i>@item.PlannedStartTime.ToString("dd.MM.yyyy")
                                </div>
                            </div>

                            <!-- ARAÇ VE ŞOFÖR BİLGİLERİ -->
                            <div class="row no-gutters mb-2">
                                <div class="col-6 pr-2 border-right">
                                    <span class="text-muted d-block small"><i class="fa fa-car mr-1"></i>Araç</span>
                                    <strong class="text-dark font-14">@item.VehiclePlate</strong>
                                    <div class="text-muted small text-truncate">@item.VehicleBrandModel</div>
                                </div>
                                <div class="col-6 pl-2">
                                    <span class="text-muted d-block small"><i class="fa fa-user mr-1"></i>Şoför</span>
                                    <strong class="text-dark font-14">@item.DriverFullName</strong>
                                    <div class="text-muted small">@item.PlannedStartTime.ToString("HH:mm") - @item.PlannedEndTime.ToString("HH:mm")</div>
                                </div>
                            </div>

                            <!-- TALEP EDEN BİRİM & GÖREV AMACI -->
                            @if (!string.IsNullOrWhiteSpace(item.RequestedByDepartment) || !string.IsNullOrWhiteSpace(item.Purpose))
                            {
                                <div class="p-2 rounded small mb-2" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                                    <div class="font-weight-bold text-dark text-truncate">
                                        <i class="fa fa-building-o mr-1 text-muted"></i>@item.RequestedByDepartment
                                    </div>
                                    <div class="text-muted text-truncate" title="@item.Purpose">@item.Purpose</div>
                                </div>
                            }

                            <!-- BELGE DURUMU VE İŞLEM BUTONLARI -->
                            <div class="border-top pt-2 mt-2">
                                @if (item.HasDocument)
                                {
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <div class="d-flex align-items-center overflow-hidden mr-2">
                                            @if (item.IsPdf)
                                            {
                                                <i class="fa fa-file-pdf-o text-danger mr-2 font-18 flex-shrink-0"></i>
                                            }
                                            else if (item.IsImage)
                                            {
                                                <i class="fa fa-file-image-o text-success mr-2 font-18 flex-shrink-0"></i>
                                            }
                                            else
                                            {
                                                <i class="fa fa-file-text-o text-primary mr-2 font-18 flex-shrink-0"></i>
                                            }
                                            <div class="text-truncate">
                                                <span class="font-weight-bold text-dark small d-block text-truncate">@item.DocumentOriginalFileName</span>
                                                <small class="text-muted">@(item.UploadedByFullName ?? "Sistem Yetkilisi") • @(item.UploadedAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</small>
                                            </div>
                                        </div>
                                        <span class="badge badge-success font-weight-normal flex-shrink-0" style="font-size: 0.68rem;">
                                            <i class="fa fa-check mr-1"></i> Yüklendi
                                        </span>
                                    </div>

                                    <div class="d-flex" style="gap: 6px;">
                                        <a href="/Assignment/ViewSignedDocument/@item.AssignmentId" target="_blank" class="btn btn-outline-info btn-sm flex-fill text-center font-weight-bold">
                                            <i class="fa fa-eye mr-1"></i> Önizle
                                        </a>
                                        <a href="/Assignment/DownloadSignedDocument/@item.AssignmentId" class="btn btn-outline-success btn-sm flex-fill text-center font-weight-bold">
                                            <i class="fa fa-download mr-1"></i> İndir
                                        </a>
                                        <button type="button" class="btn btn-outline-secondary btn-sm px-3" title="Belgeyi Değiştir" onclick="openUploadModal(@item.AssignmentId, '@item.VehiclePlate', '@item.DriverFullName')">
                                            <i class="fa fa-refresh"></i>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge badge-warning text-dark font-weight-bold px-2 py-1" style="font-size: 0.75rem;">
                                            <i class="fa fa-exclamation-triangle mr-1"></i> Belge Bekleniyor
                                        </span>
                                        <a href="/Assignment/Details/@item.AssignmentId" class="small text-primary font-weight-bold">
                                            Detaya Git <i class="fa fa-arrow-right ml-1"></i>
                                        </a>
                                    </div>
                                    <button type="button" class="btn btn-warning btn-sm btn-block font-weight-bold py-2 shadow-sm" onclick="openUploadModal(@item.AssignmentId, '@item.VehiclePlate', '@item.DriverFullName')">
                                        <i class="fa fa-upload mr-1"></i> İmzalı Belge Yükle
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- SAYFALAMA (PAGINATION) -->
            @if (Model.Filter.TotalPages > 1)
            {
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center p-3 border-top bg-light">
                    <div class="small text-muted font-weight-bold text-center text-sm-left mb-2 mb-sm-0">
                        Toplam <strong>@Model.Filter.TotalCount</strong> kayıttan 
                        <strong>@(((Model.Filter.PageNumber - 1) * Model.Filter.PageSize) + 1)</strong> - 
                        <strong>@(Math.Min(Model.Filter.PageNumber * Model.Filter.PageSize, Model.Filter.TotalCount))</strong> arası gösteriliyor
                    </div>
                    <ul class="pagination pagination-sm m-0 flex-wrap justify-content-center">
                        <li class="page-item @(!Model.Filter.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("SignedDocuments", new { 
                                DocumentFilter = Model.Filter.DocumentFilter,
                                VehicleId = Model.Filter.VehicleId,
                                DriverId = Model.Filter.DriverId,
                                StartDate = Model.Filter.StartDate?.ToString("yyyy-MM-dd"),
                                EndDate = Model.Filter.EndDate?.ToString("yyyy-MM-dd"),
                                SearchTerm = Model.Filter.SearchTerm,
                                PageNumber = Model.Filter.PageNumber - 1 
                            })">
                                <i class="fa fa-chevron-left"></i>
                            </a>
                        </li>

                        @{
                            int curPage = Model.Filter.PageNumber;
                            int totPages = Model.Filter.TotalPages;
                            int startP = Math.Max(1, curPage - 2);
                            int endP = Math.Min(totPages, curPage + 2);

                            if (curPage <= 3)
                            {
                                endP = Math.Min(totPages, 5);
                            }
                            if (curPage >= totPages - 2)
                            {
                                startP = Math.Max(1, totPages - 4);
                            }
                        }
                        @if (startP > 1)
                        {
                            <li class="page-item @(1 == curPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("SignedDocuments", new { 
                                    DocumentFilter = Model.Filter.DocumentFilter,
                                    VehicleId = Model.Filter.VehicleId,
                                    DriverId = Model.Filter.DriverId,
                                    StartDate = Model.Filter.StartDate?.ToString("yyyy-MM-dd"),
                                    EndDate = Model.Filter.EndDate?.ToString("yyyy-MM-dd"),
                                    SearchTerm = Model.Filter.SearchTerm,
                                    PageNumber = 1 
                                })">1</a>
                            </li>
                            if (startP > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                            }
                        }
                        @for (int p = startP; p <= endP; p++)
                        {
                            var isCurrent = p == curPage;
                            <li class="page-item @(isCurrent ? "active" : "")">
                                <a class="page-link" href="@Url.Action("SignedDocuments", new { 
                                    DocumentFilter = Model.Filter.DocumentFilter,
                                    VehicleId = Model.Filter.VehicleId,
                                    DriverId = Model.Filter.DriverId,
                                    StartDate = Model.Filter.StartDate?.ToString("yyyy-MM-dd"),
                                    EndDate = Model.Filter.EndDate?.ToString("yyyy-MM-dd"),
                                    SearchTerm = Model.Filter.SearchTerm,
                                    PageNumber = p 
                                })">@p</a>
                            </li>
                        }
                        @if (endP < totPages)
                        {
                            if (endP < totPages - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                            }
                            <li class="page-item @(totPages == curPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("SignedDocuments", new { 
                                    DocumentFilter = Model.Filter.DocumentFilter,
                                    VehicleId = Model.Filter.VehicleId,
                                    DriverId = Model.Filter.DriverId,
                                    StartDate = Model.Filter.StartDate?.ToString("yyyy-MM-dd"),
                                    EndDate = Model.Filter.EndDate?.ToString("yyyy-MM-dd"),
                                    SearchTerm = Model.Filter.SearchTerm,
                                    PageNumber = totPages 
                                })">@totPages</a>
                            </li>
                        }

                        <li class="page-item @(!Model.Filter.HasNextPage ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("SignedDocuments", new { 
                                DocumentFilter = Model.Filter.DocumentFilter,
                                VehicleId = Model.Filter.VehicleId,
                                DriverId = Model.Filter.DriverId,
                                StartDate = Model.Filter.StartDate?.ToString("yyyy-MM-dd"),
                                EndDate = Model.Filter.EndDate?.ToString("yyyy-MM-dd"),
                                SearchTerm = Model.Filter.SearchTerm,
                                PageNumber = Model.Filter.PageNumber + 1 
                            })">
                                <i class="fa fa-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </div>
            }
        }
    </div>
</div>

<!-- HIZLI BELGE YÜKLEME MODAL'I -->
<div class="modal fade" id="uploadModal" tabindex="-1" role="dialog" aria-labelledby="uploadModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content" style="border-radius: 12px; overflow: hidden;">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="uploadModalLabel">
                    <i class="fa fa-upload mr-1"></i> İmzalı Görevlendirme Belgesi Yükle
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Kapat">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="uploadModalForm" method="post" enctype="multipart/form-data" action="">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@currentUrl" />

                <div class="modal-body p-4">
                    <div class="alert alert-info py-2 px-3 small mb-3">
                        <i class="fa fa-info-circle mr-1"></i> Bu görev için imzalanmış resmi evrakı (PDF veya taranmış görsel) yükleyiniz.
                    </div>

                    <div class="bg-light p-3 rounded mb-3 border">
                        <div class="small text-muted">Görev No: <strong id="modalAssignmentId" class="text-dark">#</strong></div>
                        <div class="small text-muted">Araç: <strong id="modalPlate" class="text-dark">-</strong></div>
                        <div class="small text-muted">Şoför: <strong id="modalDriver" class="text-dark">-</strong></div>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold text-dark">Belge Dosyası Seçin <span class="text-danger">*</span></label>
                        <input type="file" name="signedDocument" class="form-control-file border p-2 rounded" accept=".pdf,.png,.jpg,.jpeg" required id="modalFileInput">
                        <small class="text-muted d-block mt-1">İzin verilen formatlar: <strong>PDF, PNG, JPG, JPEG</strong> (Maks. 10 MB)</small>
                    </div>
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary btn-sm font-weight-bold px-4" id="modalSubmitBtn">
                        <i class="fa fa-cloud-upload mr-1"></i> Sisteme Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
