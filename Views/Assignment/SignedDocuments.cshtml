@section Scripts {
    <script src="~/js/plugins/select2/select2.full.min.js"></script>
    <script>
        $(document).ready(function() {
            // Select2 Arama ve Dikey Scroll Edilebilir Dropdown Başlatma
            $('.select2-filter').select2({
                width: '100%',
                dropdownAutoWidth: true,
                language: {
                    noResults: function () {
                        return "Eşleşen kayıt bulunamadı";
                    }
                }
            });

            // Modal Form submit koruması
            $('#uploadModalForm').on('submit', function() {
                var fileInput = document.getElementById('modalFileInput');
                if (!fileInput.files || fileInput.files.length === 0) {
                    alert('Lütfen bir belge dosyası seçiniz.');
                    return false;
                }
                var submitBtn = $('#modalSubmitBtn');
                submitBtn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin mr-1"></i> Yükleniyor...');
                return true;
            });
        });

        function openUploadModal(assignmentId, plate, driver) {
            $('#modalAssignmentId').text('#' + assignmentId);
            $('#modalPlate').text(plate);
            $('#modalDriver').text(driver);
            $('#modalFileInput').val('');
            $('#uploadModalForm').attr('action', '/Assignment/UploadSignedDocument/' + assignmentId);
            $('#uploadModal').modal('show');
        }
    </script>
}
