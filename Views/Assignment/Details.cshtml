                        <div class="border rounded p-3 mb-0 bg-white">
                            <div class="form-group mb-0">
                                <label class="font-weight-bold text-dark small">
                                    <i class="fa fa-pencil text-danger mr-1"></i> 3. Revizyon Gerekçesi / Fatura Notu <span class="text-danger">*</span>
                                </label>
                                <input type="text" id="revisionReason" name="RevisionReason" class="form-control" placeholder="Örn: 1.200 TL tutarındaki otel faturası ibraz edildi..." required />
                                <small class="form-text text-muted">Denetim ve şeffaflık gereği revizyon gerekçesi zorunludur.</small>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer bg-light d-flex justify-content-between">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Vazgeç</button>
                        <button type="submit" class="btn btn-primary font-weight-bold px-4 shadow-sm">
                            <i class="fa fa-save mr-1"></i> Fatura & Harcırahı Güncelle
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- DOĞRUDAN BİTİRME MODALI (Yetkili Bitirme) -->
<div class="modal fade" id="endDirectModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title font-weight-bold">
                    <i class="fa fa-flag-checkered mr-2"></i> Görevi Bitir / Teslim Al
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Kapat">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="endDirectForm" method="post" action="">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <p class="text-dark mb-2">
                        <strong id="endDirectInfo" class="text-primary font-weight-bold"></strong> görevini sonlandırmak ve teslim almak üzeresiniz.
                    </p>
                    <div class="form-group mt-3">
                        <label class="font-weight-bold text-dark">Dönüş / Teslim Kilometresi <span class="text-danger">*</span></label>
                        <input type="number" id="endDirectKmInput" name="endKm" class="form-control" required placeholder="Aracın güncel bitiş kilometresini giriniz">
                        <small id="endDirectKmHelp" class="form-text text-muted"></small>
                    </div>

                    <!-- Kırmızı Hata: KM Küçükse -->
                    <div id="endDirectKmErrorAlert" class="alert alert-danger py-2 px-3 small d-none" style="border-left: 4px solid #ed5565;">
                        <i class="fa fa-times-circle mr-1"></i> <span id="endDirectKmErrorText"></span>
                    </div>

                    <!-- Belirgin KM Farkı Kırmızı Uyarı & Şef Onay Kutusu -->
                    <div id="endDirectKmWarningContainer" class="alert alert-danger py-3 px-3 d-none shadow-sm" style="background-color: #fff5f5; border: 1px solid #ed5565; border-radius: 8px;">
                        <div class="d-flex align-items-center mb-2 text-danger font-weight-bold">
                            <i class="fa fa-exclamation-triangle fa-lg mr-2"></i> Belirgin Kilometre Farkı Uyarısı
                        </div>
                        <p id="endDirectKmWarningText" class="small mb-2 text-dark font-weight-normal"></p>
                        <div class="custom-control custom-checkbox mt-2">
                            <input type="checkbox" class="custom-control-input" id="endDirectConfirmKmCheckbox" name="confirmKmDifference" value="true">
                            <label class="custom-control-label font-weight-bold text-danger small" for="endDirectConfirmKmCheckbox" style="cursor: pointer;">
                                Yüksek kilometre farkını onaylıyorum ve sorumluluğu kabul ediyorum.
                            </label>
                        </div>
                    </div>

                    <div class="form-group mt-2">
                        <label class="font-weight-bold text-dark">Teslim Notu (Opsiyonel)</label>
                        <textarea name="driverReturnNotes" class="form-control" rows="2" placeholder="Araç durumu veya görev notu..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Vazgeç</button>
                    <button type="submit" id="btnEndDirectSubmit" class="btn btn-primary font-weight-bold px-4">
                        <i class="fa fa-flag-checkered mr-1"></i> Görevi Bitir
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openCancelModal(assignmentId, plate, driverName) {
        $('#cancelAssignmentInfo').text(plate + ' / ' + driverName);
        $('#cancelAssignmentForm').attr('action', '/Assignment/Cancel/' + assignmentId + '?returnUrl=/Assignment/Details/' + assignmentId);
        $('#cancelAssignmentModal').modal('show');
    }

    const KM_THRESHOLD = @KmValidationService.GetDiscrepancyThreshold();

    function openStartDirectModal(assignmentId, plate, driverName) {
        $('#startDirectConfirmKmCheckbox').prop('checked', false);
        $('#startDirectKmErrorAlert').addClass('d-none');
        $('#startDirectKmWarningContainer').addClass('d-none');
        $('#btnStartDirectSubmit').prop('disabled', false);
        if (plate && driverName) {
            $('#startDirectInfo').text(plate + ' / ' + driverName);
        }
        $('#startDirectForm').attr('action', '/Assignment/StartDirect/' + assignmentId + '?returnUrl=/Assignment/Details/' + assignmentId);
        $('#startDirectModal').modal('show');
    }

    function checkStartDirectKm() {
        const currentKm = parseInt($('#startDirectKmInput').data('current-km') || 0, 10);
        const valStr = $('#startDirectKmInput').val();
        const $errorAlert = $('#startDirectKmErrorAlert');
        const $errorText = $('#startDirectKmErrorText');
        const $warnContainer = $('#startDirectKmWarningContainer');
        const $warnText = $('#startDirectKmWarningText');
        const $confirmCheckbox = $('#startDirectConfirmKmCheckbox');
        const $submitBtn = $('#btnStartDirectSubmit');

        if (!valStr || valStr.trim() === '') {
            $errorAlert.addClass('d-none');
            $warnContainer.addClass('d-none');
            $submitBtn.prop('disabled', false);
            return;
        }

        const val = parseInt(valStr, 10);
        if (isNaN(val)) return;

        if (val < currentKm) {
            $errorText.text('Başlangıç kilometresi (' + val.toLocaleString() + ' KM), aracın güncel kilometresinden (' + currentKm.toLocaleString() + ' KM) küçük olamaz!');
            $errorAlert.removeClass('d-none');
            $warnContainer.addClass('d-none');
            $submitBtn.prop('disabled', true);
        } else if (val > currentKm + KM_THRESHOLD) {
            const diff = val - currentKm;
            $errorAlert.addClass('d-none');
            $warnText.html('Girilen başlangıç kilometresi (<strong>' + val.toLocaleString() + ' KM</strong>), aracın mevcut kilometresinden (<strong>' + currentKm.toLocaleString() + ' KM</strong>) <strong>' + diff.toLocaleString() + ' KM</strong> daha fazladır (Eşik: ' + KM_THRESHOLD.toLocaleString() + ' KM). Devam etmek için aşağıdaki onay kutusunu işaretleyiniz.');
            $warnContainer.removeClass('d-none');
            $submitBtn.prop('disabled', !$confirmCheckbox.is(':checked'));
        } else {
            $errorAlert.addClass('d-none');
            $warnContainer.addClass('d-none');
            $submitBtn.prop('disabled', false);
        }
    }

    $('#startDirectKmInput').on('input change', checkStartDirectKm);
    $('#startDirectConfirmKmCheckbox').on('change', function () {
        $('#btnStartDirectSubmit').prop('disabled', !$(this).is(':checked'));
    });

    var _endDirectMinKm = 0;
    function openEndDirectModal(assignmentId, plate, driverName, startKm) {
        _endDirectMinKm = startKm || 0;
        $('#endDirectConfirmKmCheckbox').prop('checked', false);
        $('#endDirectKmErrorAlert').addClass('d-none');
        $('#endDirectKmWarningContainer').addClass('d-none');
        $('#btnEndDirectSubmit').prop('disabled', false);
        if (plate && driverName) {
            $('#endDirectInfo').text(plate + ' / ' + driverName);
        }
        $('#endDirectForm').attr('action', '/Assignment/EndDirect/' + assignmentId + '?returnUrl=/Assignment/Details/' + assignmentId);
        if (startKm > 0) {
            $('#endDirectKmInput').attr('min', startKm);
            $('#endDirectKmHelp').text('Başlangıç KM: ' + startKm.toLocaleString() + ' KM (Bitiş KM bundan küçük olamaz)');
        } else {
            $('#endDirectKmInput').removeAttr('min');
            $('#endDirectKmHelp').text('');
        }
        $('#endDirectModal').modal('show');
    }

    function checkEndDirectKm() {
        const valStr = $('#endDirectKmInput').val();
        const $errorAlert = $('#endDirectKmErrorAlert');
        const $errorText = $('#endDirectKmErrorText');
        const $warnContainer = $('#endDirectKmWarningContainer');
        const $warnText = $('#endDirectKmWarningText');
        const $confirmCheckbox = $('#endDirectConfirmKmCheckbox');
        const $submitBtn = $('#btnEndDirectSubmit');

        if (!valStr || valStr.trim() === '') {
            $errorAlert.addClass('d-none');
            $warnContainer.addClass('d-none');
            $submitBtn.prop('disabled', false);
            return;
        }

        const val = parseInt(valStr, 10);
        if (isNaN(val)) return;

        if (_endDirectMinKm > 0 && val < _endDirectMinKm) {
            $errorText.text('Bitiş kilometresi (' + val.toLocaleString() + ' KM), başlangıç kilometresinden (' + _endDirectMinKm.toLocaleString() + ' KM) küçük olamaz!');
            $errorAlert.removeClass('d-none');
            $warnContainer.addClass('d-none');
            $submitBtn.prop('disabled', true);
        } else if (_endDirectMinKm > 0 && val > _endDirectMinKm + KM_THRESHOLD) {
            const diff = val - _endDirectMinKm;
            $errorAlert.addClass('d-none');
            $warnText.html('Girilen bitiş kilometresi (<strong>' + val.toLocaleString() + ' KM</strong>), başlangıç kilometresinden (<strong>' + _endDirectMinKm.toLocaleString() + ' KM</strong>) <strong>' + diff.toLocaleString() + ' KM</strong> daha fazladır (Eşik: ' + KM_THRESHOLD.toLocaleString() + ' KM). Devam etmek için aşağıdaki onay kutusunu işaretleyiniz.');
            $warnContainer.removeClass('d-none');
            $submitBtn.prop('disabled', !$confirmCheckbox.is(':checked'));
        } else {
            $errorAlert.addClass('d-none');
            $warnContainer.addClass('d-none');
            $submitBtn.prop('disabled', false);
        }
    }

    $('#endDirectKmInput').on('input change', checkEndDirectKm);
    $('#endDirectConfirmKmCheckbox').on('change', function () {
        $('#btnEndDirectSubmit').prop('disabled', !$(this).is(':checked'));
    });

    var _currentPlannedHours = 0;
    var _initialPlannedNights = 0;
    var _driverStartTimeIso = '';
    var _driverEndTimeIso = '';
    var _isTimeEditActive = false;

    function formatDurationFromMinutes(totalMinutes) {
        if (!totalMinutes || totalMinutes <= 0) return '0 sa 0 dk';
        var h = Math.floor(totalMinutes / 60);
        var m = totalMinutes % 60;
        return h + ' sa ' + m + ' dk';
    }

    function formatDurationFromHours(hours) {
        if (!hours || hours <= 0) return '0 sa 0 dk';
        var totalMin = Math.round(hours * 60);
        return formatDurationFromMinutes(totalMin);
    }

    function checkApproveDistanceThreshold() {
        var startKm = parseInt($('#approveConfirmedStartKm').val()) || 0;
        var endKm = parseInt($('#approveConfirmedEndKm').val()) || 0;
        var distance = endKm - startKm;
        if (distance < 0) distance = 0;
        $('#approveCalculatedDistanceText').text(distance.toLocaleString('tr-TR') + ' KM');
        if (distance > 200) {
            $('#approveDistanceThresholdValue').text(distance.toLocaleString('tr-TR'));
            $('#approveDistanceThresholdAlert').removeClass('d-none');
        } else {
            $('#approveDistanceThresholdAlert').addClass('d-none');
        }
    }
    $('#approveConfirmedStartKm, #approveConfirmedEndKm').on('input change keyup', checkApproveDistanceThreshold);

    function openApproveEndModal(assignmentId, plate, driverName, startTimeIso, endTimeIso, startKm, endKm, accNights, accCost, perDiemType, perDiemHours, perDiemRate, perDiemDays, perDiemAmount, notes, plannedHours) {
        $('#approveEndCalculationForm').attr('action', '/Assignment/ApproveEnd/' + assignmentId);
        $('#approveEndVehiclePlate').text(plate);
        $('#approveEndDriverName').text(driverName);
        $('#approveEndStartKmText').text(startKm ? startKm.toLocaleString() + ' KM' : '-');
        $('#approveEndEndKmText').text(endKm ? endKm.toLocaleString() + ' KM' : '-');

        $('#approveConfirmedStartKm').val(startKm || 0);
        $('#approveConfirmedEndKm').val(endKm || 0);
        checkApproveDistanceThreshold();
        
        var totalKm = (endKm && startKm && endKm >= startKm) ? (endKm - startKm) : 0;
        $('#approveEndTotalKmBadge').text(totalKm.toLocaleString() + ' KM');

        _driverStartTimeIso = startTimeIso;
        _driverEndTimeIso = endTimeIso;
        _isTimeEditActive = false;

        $('#approveStartTime').val(startTimeIso);
        $('#approveEndTime').val(endTimeIso);
        $('#approveHourlyRate').val('').css({ 'border': '', 'background-color': '' });
        $('#approveTimeErrorAlert').addClass('d-none');
        $('#btnSubmitApproveEnd').prop('disabled', false).html('<i class="fa fa-check-circle mr-1"></i> Görevi & Tüm Maliyetleri Onayla');

        // Değişiklik arayüz durumunu sıfırla
        $('#approvePerDiemHours').data('user-edited', false);
        $('#badgeCustomHoursIndicator').addClass('d-none');
        $('#timeEditActiveAlert').addClass('d-none');
        $('#divQuickDurationButtons').addClass('d-none');
        $('#approveTimeCard').removeClass('border-warning shadow-sm').addClass('border');
        $('#btnToggleTimeEdit').removeClass('btn-warning').addClass('btn-outline-warning text-dark').html('<i class="fa fa-pencil mr-1"></i> Saatlerde / Sürede Değişiklik Yap');
        $('#badgeTimeEditStatus').html('<i class="fa fa-check-circle text-success mr-1"></i> Şoförün Bildirimi').removeClass('badge-warning text-dark font-weight-bold').addClass('badge-light text-muted');

        _initialPlannedNights = parseInt(accNights) || 0;
        _currentPlannedHours = parseFloat(plannedHours) || 0;
        $('#approvePlannedHoursBadge').text(formatDurationFromHours(_currentPlannedHours));

        $('#approveAccommodationNights').val(accNights && accNights > 0 ? accNights : '');
        $('#approveAccommodationCost').val(accCost && parseFloat(accCost) > 0 ? parseFloat(accCost).toFixed(2) : '');
        
        // Yevmiye tipi ve alanları
        setApprovePerDiemMode(perDiemType || 'Hourly');
        $('#approvePerDiemHours').val(perDiemHours && parseFloat(perDiemHours) > 0 ? parseFloat(perDiemHours).toFixed(1) : '');
        $('#approvePerDiemRate').val(perDiemRate && parseFloat(perDiemRate) > 0 ? parseFloat(perDiemRate).toFixed(2) : '');
        $('#approvePerDiemDays').val(perDiemDays && perDiemDays > 0 ? perDiemDays : '');
        $('#approvePerDiemAmount').val(perDiemAmount && parseFloat(perDiemAmount) > 0 ? parseFloat(perDiemAmount).toFixed(2) : '');
        $('#approveExpenseNotes').val(notes || '');
        
        recalculateApproveEndFee();
        $('#approveEndCalculationModal').modal('show');
    }

    function toggleApproveTimeEditMode() {
        _isTimeEditActive = !_isTimeEditActive;
        if (_isTimeEditActive) {
            $('#timeEditActiveAlert').removeClass('d-none');
            $('#divQuickDurationButtons').removeClass('d-none');
            $('#approveTimeCard').removeClass('border').addClass('border-warning shadow-sm');
            $('#btnToggleTimeEdit').removeClass('btn-outline-warning text-dark').addClass('btn-warning').html('<i class="fa fa-check mr-1"></i> Değişiklik Modu Açık');
            $('#badgeTimeEditStatus').html('<i class="fa fa-unlock-alt text-warning mr-1"></i> Şef Düzenleme Modu').removeClass('badge-light text-muted').addClass('badge-warning text-dark font-weight-bold');
            $('#approvePerDiemHours').focus();
        } else {
            $('#timeEditActiveAlert').addClass('d-none');
            $('#divQuickDurationButtons').addClass('d-none');
            $('#approveTimeCard').removeClass('border-warning shadow-sm').addClass('border');
            $('#btnToggleTimeEdit').removeClass('btn-warning').addClass('btn-outline-warning text-dark').html('<i class="fa fa-pencil mr-1"></i> Saatlerde / Sürede Değişiklik Yap');
            $('#badgeTimeEditStatus').html('<i class="fa fa-check-circle text-success mr-1"></i> Şoförün Bildirimi').removeClass('badge-warning text-dark font-weight-bold').addClass('badge-light text-muted');
        }
    }

    function setQuickDutyHours(hours) {
        if (!hours || hours <= 0) return;
        
        $('#approvePerDiemHours').val(hours.toFixed(1)).data('user-edited', true);
        $('#badgeCustomHoursIndicator').removeClass('d-none');

        // Başlangıç saati varsa dönüş saatini çıkış + hours olarak ayarla
        var startVal = $('#approveStartTime').val();
        if (startVal) {
            var sDate = new Date(startVal);
            var eDate = new Date(sDate.getTime() + (hours * 60 * 60 * 1000));
            var pad = function(n) { return n < 10 ? '0' + n : n; };
            var eIso = eDate.getFullYear() + '-' + pad(eDate.getMonth() + 1) + '-' + pad(eDate.getDate()) + 'T' + pad(eDate.getHours()) + ':' + pad(eDate.getMinutes());
            $('#approveEndTime').val(eIso);
        }

        if (!$('#approveExpenseNotes').val()) {
            $('#approveExpenseNotes').val('Şef tarafından fiili çalışma süresi ' + hours + ' saat olarak revize edildi.');
        }

        recalculateApprovePerDiemAmount();
        recalculateApproveEndFee();
        if (typeof toastr !== 'undefined') {
            toastr.success('Fiili çalışma süresi ' + hours + ' saat olarak belirlendi.', 'Süre Güncellendi');
        }
    }

    function resetToDriverOriginalTimes() {
        $('#approveStartTime').val(_driverStartTimeIso);
        $('#approveEndTime').val(_driverEndTimeIso);
        $('#approvePerDiemHours').val('').data('user-edited', false);
        $('#badgeCustomHoursIndicator').addClass('d-none');
        recalculateApproveEndFee();
        recalculateApprovePerDiemAmount();
        if (typeof toastr !== 'undefined') {
            toastr.info('Şoförün ilk bildirdiği orijinal saatlere ve süreye dönüldü.', 'Sıfırlandı');
        }
    }

    function setApprovePerDiemMode(mode) {
        $('#approvePerDiemType').val(mode);
        if (mode === 'Hourly') {
            $('#btnApprovePerDiemHourly').removeClass('btn-outline-primary').addClass('btn-primary');
            $('#btnApprovePerDiemDaily').removeClass('btn-secondary').addClass('btn-outline-secondary');
            $('#approvePerDiemHoursGroup').removeClass('d-none');
            $('#approvePerDiemDaysGroup').addClass('d-none');
            $('#approvePerDiemRateLabel').text('Saat Başına Ücret (₺)');
            $('#approvePerDiemRateUnit').text('₺/Saat');
        } else {
            $('#btnApprovePerDiemDaily').removeClass('btn-outline-secondary').addClass('btn-secondary');
            $('#btnApprovePerDiemHourly').removeClass('btn-primary').addClass('btn-outline-primary');
            $('#approvePerDiemHoursGroup').addClass('d-none');
            $('#approvePerDiemDaysGroup').removeClass('d-none');
            $('#approvePerDiemRateLabel').text('Gün Başına Ücret (₺)');
            $('#approvePerDiemRateUnit').text('₺/Gün');
        }
        recalculateApprovePerDiemAmount();
        recalculateApproveEndFee();
    }

    function setRevisionPerDiemMode(mode) {
        $('#revisionPerDiemType').val(mode);
        if (mode === 'Hourly') {
            $('#btnRevisionPerDiemHourly').removeClass('btn-outline-primary').addClass('btn-primary');
            $('#btnRevisionPerDiemDaily').removeClass('btn-secondary').addClass('btn-outline-secondary');
            $('#revisionPerDiemHoursGroup').removeClass('d-none');
            $('#revisionPerDiemDaysGroup').addClass('d-none');
            $('#revisionPerDiemRateLabel').html('<i class="fa fa-tag text-success mr-1"></i> Saat Başına Ücret (₺)');
            $('#revisionPerDiemRateUnit').text('₺/Saat');
        } else {
            $('#btnRevisionPerDiemDaily').removeClass('btn-outline-secondary').addClass('btn-secondary');
            $('#btnRevisionPerDiemHourly').removeClass('btn-primary').addClass('btn-outline-primary');
            $('#revisionPerDiemHoursGroup').addClass('d-none');
            $('#revisionPerDiemDaysGroup').removeClass('d-none');
            $('#revisionPerDiemRateLabel').html('<i class="fa fa-tag text-success mr-1"></i> Gün Başına Ücret (₺)');
            $('#revisionPerDiemRateUnit').text('₺/Gün');
        }
        recalculateRevisionPerDiemAmount();
    }

    function recalculateApprovePerDiemAmount() {
        var mode = $('#approvePerDiemType').val();
        var rateStr = ('' + ($('#approvePerDiemRate').val() || '')).trim().replace(',', '.');
        var rate = parseFloat(rateStr);
        if (!isNaN(rate) && rate > 0) {
            if (mode === 'Hourly') {
                var hours = parseFloat($('#approvePerDiemHours').val()) || parseFloat($('#calcCalculatedDutyHours').val()) || 0;
                $('#approvePerDiemAmount').val((hours * rate).toFixed(2));
            } else {
                var days = parseFloat($('#approvePerDiemDays').val()) || 0;
                $('#approvePerDiemAmount').val((days * rate).toFixed(2));
            }
        } else if (rateStr === '') {
            $('#approvePerDiemAmount').val('');
        }
    }

    function recalculateRevisionPerDiemAmount() {
        var mode = $('#revisionPerDiemType').val();
        var rateStr = ('' + ($('#revisionPerDiemRate').val() || '')).trim().replace(',', '.');
        var rate = parseFloat(rateStr);
        if (!isNaN(rate) && rate > 0) {
            if (mode === 'Hourly') {
                var hoursStr = ('' + ($('#revisionPerDiemHours').val() || '')).trim().replace(',', '.');
                var hours = parseFloat(hoursStr) || 0;
                $('#revisionPerDiemAmount').val((hours * rate).toFixed(2));
            } else {
                var days = parseFloat($('#revisionPerDiemDays').val()) || 0;
                $('#revisionPerDiemAmount').val((days * rate).toFixed(2));
            }
        } else if (rateStr === '') {
            $('#revisionPerDiemAmount').val('');
        }
    }

    function resetAccommodationFields() {
        $('#approveAccommodationNights').val('0');
        $('#approveAccommodationCost').val('0.00');
        $('#approveEarlyReturnAlert').addClass('d-none');
        recalculateApproveEndFee();
    }

    function openRevisionModal(assignmentId, hourlyRate, accNights, accCost, perDiemType, perDiemHours, perDiemRate, perDiemDays, perDiemAmount) {
        var effectiveRate = (perDiemRate && parseFloat(perDiemRate) > 0) ? perDiemRate : (hourlyRate && parseFloat(hourlyRate) > 0 ? hourlyRate : '');
        $('#revisionHourlyRate').val(effectiveRate);
        $('#revisionAccommodationNights').val(accNights && accNights > 0 ? accNights : '');
        $('#revisionAccommodationCost').val(accCost && parseFloat(accCost) > 0 ? parseFloat(accCost).toFixed(2) : '');
        
        setRevisionPerDiemMode(perDiemType || 'Hourly');
        $('#revisionPerDiemHours').val(perDiemHours && parseFloat(perDiemHours) > 0 ? parseFloat(perDiemHours).toFixed(1) : '');
        $('#revisionPerDiemRate').val(effectiveRate && parseFloat(effectiveRate) > 0 ? parseFloat(effectiveRate).toFixed(2) : '');
        $('#revisionPerDiemDays').val(perDiemDays && perDiemDays > 0 ? perDiemDays : '');
        $('#revisionPerDiemAmount').val(perDiemAmount && parseFloat(perDiemAmount) > 0 ? parseFloat(perDiemAmount).toFixed(2) : '');
        $('#revisionReason').val('');
        $('#updateFinancialRevisionModal').modal('show');
    }

    function recalculateApproveEndFee() {
        var startStr = $('#approveStartTime').val();
        var endStr = $('#approveEndTime').val();
        var rawRate = $('#approveHourlyRate').val();
        var hourlyRateStr = ('' + (rawRate || '')).trim().replace(',', '.');
        var hourlyRate = parseFloat(hourlyRateStr);
        var isHourlyRateValid = hourlyRateStr !== '' && !isNaN(hourlyRate) && hourlyRate > 0;

        var currentAccNights = parseInt($('#approveAccommodationNights').val()) || 0;
        var perDiemAmount = parseFloat($('#approvePerDiemAmount').val()) || 0;
        var accommodationCost = parseFloat($('#approveAccommodationCost').val()) || 0;

        if (!startStr || !endStr) {
            return;
        }

        var startDate = new Date(startStr);
        var endDate = new Date(endStr);
        var diffMs = endDate.getTime() - startDate.getTime();

        if (diffMs <= 0) {
            $('#approveTimeErrorAlert').removeClass('d-none');
            $('#approveTimeErrorText').text('Dönüş saati, çıkış saatinden önce veya çıkış saatiyle aynı olamaz.');
            $('#calcDutyDurationText').text('0 sa 0 dk');
            $('#calcDutyDecimalHoursText').text('');
            $('#approveActualHoursBadge').text('0 sa 0 dk');
            $('#calcDriverFeePreviewText').text('0,00 ₺');
            $('#summaryDriverFee').text('0,00 ₺');
            $('#summaryPerDiem').text(perDiemAmount.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺');
            $('#summaryAccommodation').text(accommodationCost.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺');
            $('#calcGrandTotalText').text((perDiemAmount + accommodationCost).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺');
            $('#calcCalculatedDutyHours').val(0);
            $('#calcTotalDriverFee').val(0);
            $('#calcTotalTripExpense').val((perDiemAmount + accommodationCost).toFixed(2));
            return;
        }

        // Zaman geçerliyse ve önceki hata zaman hatasıysa alert'i gizle
        if ($('#approveTimeErrorText').text().indexOf('Dönüş saati') !== -1) {
            $('#approveTimeErrorAlert').addClass('d-none');
        }

        var totalMinutes = Math.round(diffMs / (1000 * 60));
        var hours = Math.floor(totalMinutes / 60);
        var minutes = totalMinutes % 60;
        var decimalHours = Math.round((diffMs / (1000 * 60 * 60)) * 100) / 100;

        var isUserEditedHours = $('#approvePerDiemHours').data('user-edited');
        var manualHours = parseFloat($('#approvePerDiemHours').val()) || 0;

        if ($('#approvePerDiemType').val() === 'Hourly') {
            if (isUserEditedHours && manualHours > 0) {
                var h = Math.floor(manualHours);
                var m = Math.round((manualHours - h) * 60);
                var formatted = h + ' sa ' + m + ' dk';
                $('#calcDutyDurationText').text(formatted);
                $('#calcDutyDecimalHoursText').text('');
                $('#approveActualHoursBadge').text(formatted + ' (Şef)');
                $('#calcCalculatedDutyHours').val(manualHours);
                recalculateApprovePerDiemAmount();
                perDiemAmount = parseFloat($('#approvePerDiemAmount').val()) || 0;
            } else {
                var formatted = hours + ' sa ' + minutes + ' dk';
                $('#calcDutyDurationText').text(formatted);
                $('#calcDutyDecimalHoursText').text('');
                $('#approveActualHoursBadge').text(formatted);
                $('#calcCalculatedDutyHours').val(decimalHours);
                $('#approvePerDiemHours').val(decimalHours.toFixed(1));
                recalculateApprovePerDiemAmount();
                perDiemAmount = parseFloat($('#approvePerDiemAmount').val()) || 0;
            }
        } else {
            var formatted = hours + ' sa ' + minutes + ' dk';
            $('#calcDutyDurationText').text(formatted);
            $('#calcDutyDecimalHoursText').text('');
            $('#approveActualHoursBadge').text(formatted);
            $('#calcCalculatedDutyHours').val(decimalHours);
        }

        // Planlanan vs Fiili Süre Fark Göstergesi
        if (_currentPlannedHours > 0) {
            var compareHours = (isUserEditedHours && manualHours > 0) ? manualHours : decimalHours;
            var diff = compareHours - _currentPlannedHours;
            if (Math.abs(diff) < 0.1) {
                $('#approveDurationDeltaBadge').text('Tam Zamanında').attr('class', 'badge badge-success ml-1');
            } else if (diff < 0) {
                $('#approveDurationDeltaBadge').text(Math.abs(diff).toFixed(1) + ' Saat Erken').attr('class', 'badge badge-primary ml-1');
            } else {
                $('#approveDurationDeltaBadge').text(diff.toFixed(1) + ' Saat Gecikmeli').attr('class', 'badge badge-warning ml-1');
            }
        }

        // Akıllı Erken Dönüş / Konaklama Kontrolü
        if (_initialPlannedNights > 0 && decimalHours <= 24 && currentAccNights > 0) {
            $('#approveEarlyReturnText').html('Bu görev planlanırken <strong>' + _initialPlannedNights + ' Gece Konaklama</strong> öngörülmüş; ancak fiili görev aynı gün içinde (<strong>' + decimalHours.toFixed(2) + ' Saat</strong>) tamamlanmıştır. Şoför konaklama yapmadıysa sıfırlayınız.');
            $('#approveEarlyReturnAlert').removeClass('d-none');
        } else {
            $('#approveEarlyReturnAlert').addClass('d-none');
        }

        // İcmal Kartı (Görev Ücreti + Konaklama)
        var grandTotal = Math.round((perDiemAmount + accommodationCost) * 100) / 100;
        var displayHours = (isUserEditedHours && manualHours > 0) ? Math.floor(manualHours) : hours;
        var displayMins = (isUserEditedHours && manualHours > 0) ? Math.round((manualHours - displayHours) * 60) : minutes;
        $('#summaryDutyDuration').text(displayHours + ' sa ' + displayMins + ' dk');
        $('#summaryPerDiem').text(perDiemAmount.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺');
        $('#summaryAccommodation').text(accommodationCost.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺');
        $('#calcGrandTotalText').text(grandTotal.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺');

        $('#calcTotalDriverFee').val(0);
        $('#calcTotalTripExpense').val(grandTotal.toFixed(2));
    }

    $(document).on('input change', '#approveStartTime, #approveEndTime, #approvePerDiemRate, #approvePerDiemDays, #approvePerDiemAmount, #approveAccommodationCost, #approveAccommodationNights', function() {
        if ($(this).is('#approvePerDiemRate, #approvePerDiemDays')) {
            recalculateApprovePerDiemAmount();
        }
        recalculateApproveEndFee();
    });

    $(document).on('input', '#approvePerDiemHours', function() {
        var valStr = ('' + ($(this).val() || '')).trim().replace(',', '.');
        var val = parseFloat(valStr) || 0;
        if (val > 0) {
            $(this).data('user-edited', true);
            $('#badgeCustomHoursIndicator').removeClass('d-none');

            // Başlangıç saati varsa dönüş saatini süreye uyarla
            var startVal = $('#approveStartTime').val();
            if (startVal) {
                var sDate = new Date(startVal);
                var eDate = new Date(sDate.getTime() + (val * 60 * 60 * 1000));
                var pad = function(n) { return n < 10 ? '0' + n : n; };
                var eIso = eDate.getFullYear() + '-' + pad(eDate.getMonth() + 1) + '-' + pad(eDate.getDate()) + 'T' + pad(eDate.getHours()) + ':' + pad(eDate.getMinutes());
                $('#approveEndTime').val(eIso);
            }
        } else {
            $(this).data('user-edited', false);
            $('#badgeCustomHoursIndicator').addClass('d-none');
        }
        recalculateApprovePerDiemAmount();
        recalculateApproveEndFee();
    });

    $(document).on('input change', '#revisionPerDiemRate, #revisionPerDiemHours, #revisionPerDiemDays', function() {
        recalculateRevisionPerDiemAmount();
    });

    $('#approveEndCalculationForm').on('submit', function (e) {
        var startStr = $('#approveStartTime').val();
        var endStr = $('#approveEndTime').val();

        if (!startStr || !endStr) {
            e.preventDefault();
            $('#approveTimeErrorAlert').removeClass('d-none');
            $('#approveTimeErrorText').text('Lütfen başlangıç ve bitiş saatlerini eksiksiz giriniz.');
            $('#approveStartTime').focus();
            return false;
        }

        var startDate = new Date(startStr);
        var endDate = new Date(endStr);
        if (endDate.getTime() <= startDate.getTime()) {
            e.preventDefault();
            $('#approveTimeErrorAlert').removeClass('d-none');
            $('#approveTimeErrorText').text('Dönüş saati, çıkış saatinden sonra olmalıdır.');
            $('#approveEndTime').focus();
            return false;
        }

        $('#btnSubmitApproveEnd').prop('disabled', true).html('<i class="fa fa-spinner fa-spin mr-1"></i> Onaylanıyor...');
        return true;
    });

    function validateSignedDocForm(form) {
        var fileInput = form.querySelector('input[type="file"]');
        if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
            alert("Lütfen yüklenecek bir dosya seçiniz.");
            return false;
        }
        var file = fileInput.files[0];
        var maxSize = 10 * 1024 * 1024; // 10 MB
        if (file.size > maxSize) {
            alert("Dosya boyutu 10 MB sınırını aşıyor (" + (file.size / (1024 * 1024)).toFixed(2) + " MB). Lütfen daha küçük bir dosya seçiniz.");
            return false;
        }
        var validExtensions = [".pdf", ".jpg", ".jpeg", ".png"];
        var fileName = file.name.toLowerCase();
        var isValidExt = validExtensions.some(function (ext) { return fileName.endsWith(ext); });
        if (!isValidExt) {
            alert("Yalnızca .pdf, .jpg, .jpeg veya .png formatında dosya yükleyebilirsiniz.");
            return false;
        }
        return true;
    }

    function openExtendDurationModal(id, plate, driver, currentEndIso) {
        $('#extendDurationForm').attr('action', '/Assignment/ExtendDuration/' + id);
        if (plate && driver) {
            $('#extendModalVehicleDriver').val(plate + ' - ' + driver);
        }
        if (currentEndIso) {
            var now = new Date();
            now.setHours(now.getHours() + 2);
            now.setMinutes(0);
            var tzOffset = now.getTimezoneOffset() * 60000;
            var defaultIso = (new Date(now - tzOffset)).toISOString().slice(0, 16);
            $('#extendModalNewPlannedEndTime').val(currentEndIso > defaultIso ? currentEndIso : defaultIso);
        }
        $('#extendDurationModal').modal('show');
    }

    $(function () {
        $('#offRouteDispatchModal').appendTo('body');
    });
</script>
}
