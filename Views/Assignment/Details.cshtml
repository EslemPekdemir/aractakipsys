                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-danger font-weight-bold px-4">
                        <i class="fa fa-ban mr-1"></i> Görevi İptal Et
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- GÜZERGAH DIŞI SEVK MODALI (FAZ 3) -->
<div class="modal fade" id="offRouteDispatchModal" tabindex="-1" role="dialog" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title font-weight-bold">
                    <i class="fa fa-map-signs mr-2"></i> Güzergah Dışı Sevk Kaydı
                </h5>
                <button type="button" class="close text-dark" data-dismiss="modal" aria-label="Kapat">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form method="post" action="/Assignment/SaveOffRouteDispatch">
                @Html.AntiForgeryToken()
                <input type="hidden" name="AssignmentId" value="@Model.Id" />
                <div class="modal-body p-4">
                    <p class="small text-muted mb-3">
                        Matbu Taşıt Görev Emri belgesinde el yazısıyla doldurulan acil güzergah dışı sevk bilgilerini sisteme kaydediniz. Bu kayıt Şef ve Daire Başkanı tarafından görüntülenebilir.
                    </p>
                    <div class="form-group">
                        <label class="font-weight-bold text-dark">Sevk Edenin Adı Soyadı <span class="text-danger">*</span></label>
                        <input type="text" name="DispatcherName" class="form-control" required maxlength="150" value="@Model.OffRouteDispatcherName" placeholder="Örn: Prof. Dr. Ahmet Yılmaz">
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold text-dark">Sevk Edenin Unvanı</label>
                        <input type="text" name="DispatcherTitle" class="form-control" maxlength="150" value="@Model.OffRouteDispatcherTitle" placeholder="Örn: Rektör Yardımcısı / Genel Sekreter">
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold text-dark">Sevk Nedeni <span class="text-danger">*</span></label>
                        <textarea name="Reason" class="form-control" rows="3" required maxlength="1000" placeholder="Güzergah dışına çıkış gerekçesini ayrıntılı olarak yazınız...">@Model.OffRouteReason</textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-warning font-weight-bold px-4 text-dark">
                        <i class="fa fa-save mr-1"></i> Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- DOĞRUDAN BAŞLATMA MODALI (Yetkili Başlatma) -->
<div class="modal fade" id="startDirectModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title font-weight-bold">
                    <i class="fa fa-play mr-2"></i> Göreve Başla (Seferi Başlat)
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Kapat">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="startDirectForm" method="post" action="/Assignment/StartDirect/@Model.Id?returnUrl=@Url.Action("Details", new { id = Model.Id })">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <p class="text-dark mb-2">
                        <strong id="startDirectInfo" class="text-primary font-weight-bold">@Model.VehiclePlate / @Model.DriverFullName</strong> görevini doğrudan başlatmak ve aracı sefere çıkarmak üzeresiniz.
                    </p>
                    <div class="form-group mt-3">
                        <label class="font-weight-bold text-dark">Başlangıç Kilometresi (Opsiyonel)</label>
                        <input type="number" id="startDirectKmInput" name="startKm" class="form-control" data-current-km="@Model.VehicleCurrentKm" placeholder="Boş bırakılırsa aracın güncel kilometresi (@Model.VehicleCurrentKm.ToString("N0") KM) alınır">
                        <small class="form-text text-muted">Şoför bildirmeden yetkili olarak aracı sefere çıkarıyorsunuz.</small>
                    </div>

                    <!-- Kırmızı Hata: KM Küçükse -->
                    <div id="startDirectKmErrorAlert" class="alert alert-danger py-2 px-3 small d-none" style="border-left: 4px solid #ed5565;">
                        <i class="fa fa-times-circle mr-1"></i> <span id="startDirectKmErrorText"></span>
                    </div>

                    <!-- Belirgin KM Farkı Kırmızı Uyarı & Şef Onay Kutusu -->
                    <div id="startDirectKmWarningContainer" class="alert alert-danger py-3 px-3 d-none shadow-sm" style="background-color: #fff5f5; border: 1px solid #ed5565; border-radius: 8px;">
                        <div class="d-flex align-items-center mb-2 text-danger font-weight-bold">
                            <i class="fa fa-exclamation-triangle fa-lg mr-2"></i> Belirgin Kilometre Farkı Uyarısı
                        </div>
                        <p id="startDirectKmWarningText" class="small mb-2 text-dark font-weight-normal"></p>
                        <div class="custom-control custom-checkbox mt-2">
                            <input type="checkbox" class="custom-control-input" id="startDirectConfirmKmCheckbox" name="confirmKmDifference" value="true">
                            <label class="custom-control-label font-weight-bold text-danger small" for="startDirectConfirmKmCheckbox" style="cursor: pointer;">
                                Yüksek kilometre farkını onaylıyorum ve sorumluluğu kabul ediyorum.
                            </label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Vazgeç</button>
                    <button type="submit" id="btnStartDirectSubmit" class="btn btn-success font-weight-bold px-4">
                        <i class="fa fa-play mr-1"></i> Göreve Başla
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- DOĞRUDAN BİTİRME MODALI (Yetkili Bitirme) -->
<div class="modal fade" id="endDirectModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title font-weight-bold">
                    <i class="fa fa-flag-checkered mr-2"></i> Görevi Doğrudan Bitir ve Teslim Al
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Kapat">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="endDirectForm" method="post" action="">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <p class="text-dark mb-2">
                        <strong id="endDirectInfo" class="text-primary font-weight-bold">@Model.VehiclePlate / @Model.DriverFullName</strong> görevini sonlandırmak üzeresiniz.
                    </p>
                    <div class="form-group mt-3">
                        <label class="font-weight-bold text-dark">Bitiş Kilometresi <span class="text-danger">*</span></label>
                        <input type="number" id="endDirectKmInput" name="endKm" class="form-control" required placeholder="Aracın güncel bitiş kilometresini giriniz">
                        <small id="endDirectKmHelp" class="form-text text-muted"></small>
                    </div>

                    <!-- HATA UYARISI: Bitiş KM < Başlangıç KM -->
                    <div id="endDirectKmErrorAlert" class="alert alert-danger py-2 px-3 small d-none" style="border-left: 4px solid #ed5565;">
                        <i class="fa fa-times-circle mr-1"></i> <span id="endDirectKmErrorText"></span>
                    </div>

                    <!-- KIRMIZI UYARI: Bitiş KM > Başlangıç KM + Eşik -->
                    <div id="endDirectKmWarningContainer" class="alert alert-danger py-3 px-3 d-none shadow-sm" style="background-color: #fff5f5; border: 1px solid #ed5565; border-radius: 8px;">
                        <div class="d-flex align-items-center mb-2">
                            <i class="fa fa-exclamation-triangle text-danger mr-2" style="font-size: 1.3rem;"></i>
                            <strong class="text-danger">DİKKAT: Belirgin Kilometre Farkı!</strong>
                        </div>
                        <p id="endDirectKmWarningText" class="small mb-2 text-dark font-weight-normal"></p>
                        <div class="custom-control custom-checkbox mt-2">
                            <input type="checkbox" class="custom-control-input" id="endDirectConfirmKmCheckbox" name="confirmKmDifference" value="true">
                            <label class="custom-control-label font-weight-bold text-danger small" for="endDirectConfirmKmCheckbox" style="cursor: pointer;">
                                Yüksek kilometre farkını onaylıyorum ve sorumluluğu kabul ediyorum.
                            </label>
                        </div>
                    </div>

                    <div class="form-group mt-3">
                        <label class="font-weight-bold text-dark">Teslim Notu (Opsiyonel)</label>
                        <textarea name="driverReturnNotes" class="form-control" rows="2" placeholder="Varsa teslim alma veya aracın durumu hakkında not..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Vazgeç</button>
                    <button type="submit" id="btnEndDirectSubmit" class="btn btn-primary font-weight-bold px-4">
                        <i class="fa fa-check mr-1"></i> Görevi Bitir
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- SÜRE UZATMA MODALI (SEYİR HALİNDEKİ GÖREVLER İÇİN) -->
<div class="modal fade" id="extendDurationModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title font-weight-bold">
                    <i class="fa fa-clock-o mr-2"></i> Görev Süresini / Dönüş Tarihini Uzat
                </h5>
                <button type="button" class="close text-dark" data-dismiss="modal" aria-label="Kapat">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="extendDurationForm" method="post" action="/Assignment/ExtendDuration/@Model.Id">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="alert alert-info py-2 px-3 small mb-3">
                        <i class="fa fa-info-circle mr-1"></i> Görev seyir halindeyken planlanan dönüş tarihini ileri bir saate/güne uzatabilirsiniz. Araç ve şoför bilgileri sabit kalacaktır.
                    </div>
                    <div class="form-group mb-3">
