                        <input type="text" class="form-control bg-light" id="extendModalVehicleDriver" value="@Model.VehiclePlate (@Model.VehicleBrandModel) - @Model.DriverFullName" readonly />
                    </div>
                    <div class="form-group mb-3">
                        <label class="font-weight-bold small text-muted text-uppercase mb-1">Mevcut Planlanan Bitiş</label>
                        <input type="text" class="form-control bg-light" value="@Model.PlannedEndTime.ToString("dd.MM.yyyy HH:mm")" readonly />
                    </div>
                    <div class="form-group mb-3">
                        <label class="font-weight-bold text-dark">Yeni Planlanan Dönüş Tarihi & Saati <span class="text-danger">*</span></label>
                        <input type="datetime-local" name="newPlannedEndTime" id="extendModalNewPlannedEndTime" class="form-control font-weight-bold" required />
                    </div>
                    <div class="form-group mb-0">
                        <label class="font-weight-bold text-dark">Uzatma Gerekçesi / Not (İsteğe Bağlı)</label>
                        <textarea name="reason" class="form-control" rows="2" placeholder="Örn: Ankara toplantısı uzadı, dönüş ertesi gün olarak revize edildi."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-warning font-weight-bold text-dark px-4 shadow-sm">
                        <i class="fa fa-clock-o mr-1"></i> Süreyi Uzat ve Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- BİTİŞ ONAYI, HARCIRAH VE MALİYET HESAPLAMA MODALI -->
<div class="modal fade" id="approveEndCalculationModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" style="border-radius: 12px; overflow: hidden; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.2);">
            <div class="modal-header bg-success text-white py-3">
                <h5 class="modal-title font-weight-bold mb-0">
                    <i class="fa fa-calculator mr-2"></i> Görev Bitiş Onayı, Harcırah ve Maliyet Hesaplama
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Kapat">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="approveEndCalculationForm" method="post" action="">
                @Html.AntiForgeryToken()
                <input type="hidden" id="calcCalculatedDutyHours" name="CalculatedDutyHours" value="0" />
                <input type="hidden" id="calcTotalDriverFee" name="TotalDriverFee" value="0" />
                <input type="hidden" id="calcTotalTripExpense" name="TotalTripExpense" value="0" />

                <div class="modal-body p-4">
                    <!-- Araç ve Şoför Özet Başlığı -->
                    <div class="p-3 bg-light rounded border mb-3">
                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center">
                            <div>
                                <strong id="approveEndVehiclePlate" class="text-primary font-16"></strong>
                                <span class="text-muted mx-2">|</span>
                                <span id="approveEndDriverName" class="font-weight-bold text-dark"></span>
                            </div>
                            <div class="mt-2 mt-sm-0">
                                <span class="small text-muted">Başlangıç: <strong id="approveEndStartKmText" class="text-dark"></strong></span>
                                <span class="text-muted mx-1">→</span>
                                <span class="small text-muted">Bitiş: <strong id="approveEndEndKmText" class="text-dark"></strong></span>
                                <span class="badge badge-success font-weight-bold ml-2" id="approveEndTotalKmBadge">0 KM</span>
                            </div>
                        </div>
                    </div>

                    <!-- KM ONAYI VE ŞEF DÜZELTMESİ (FAZ 2 - B) -->
                    <div class="border rounded p-3 mb-3 bg-white">
                        <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                            <h6 class="font-weight-bold text-dark mb-0">
                                <i class="fa fa-tachometer text-primary mr-1"></i> Görev Kilometresi ve Şef Düzeltmesi
                            </h6>
                            <span class="badge badge-light border text-muted">
                                <i class="fa fa-edit text-info mr-1"></i> Şef Düzenleyebilir
                            </span>
                        </div>
                        <div class="row">
                            <div class="col-md-6 form-group">
                                <label class="font-weight-bold text-dark small">
                                    <i class="fa fa-tachometer text-primary mr-1"></i> Onaylanan Başlangıç KM
                                </label>
                                <input type="number" id="approveConfirmedStartKm" name="ConfirmedStartKm" class="form-control font-weight-bold" min="0" />
                                <small class="form-text text-muted">Şoförün bildirdiği başlangıç kilometresini gerekirse düzeltebilirsiniz.</small>
                            </div>
                            <div class="col-md-6 form-group">
                                <label class="font-weight-bold text-dark small">
                                    <i class="fa fa-flag-checkered text-success mr-1"></i> Onaylanan Bitiş KM <span class="text-danger">*</span>
                                </label>
                                <input type="number" id="approveConfirmedEndKm" name="ConfirmedEndKm" class="form-control font-weight-bold" min="0" required />
                                <small class="form-text text-muted">Şoförün bildirdiği bitiş kilometresini gerekirse düzeltebilirsiniz.</small>
                            </div>
                        </div>
                        <div class="p-2 rounded bg-light border d-flex justify-content-between align-items-center">
                            <span class="small text-muted font-weight-bold">Hesaplanan Toplam Mesafe:</span>
                            <strong id="approveCalculatedDistanceText" class="text-dark font-15">0 KM</strong>
                        </div>

                        <!-- 200 KM Eşik Aşım Uyarısı (Kırmızı Ünlem İkonlu) -->
                        <div id="approveDistanceThresholdAlert" class="alert alert-danger py-2 px-3 mt-2 mb-0 d-none" style="border-radius: 8px; font-size: 0.85rem; border-left: 4px solid #dc3545;">
                            <i class="fa fa-exclamation-circle text-danger mr-1 font-16"></i>
                            <strong>Mesafe Uyarısı:</strong> Yapılan mesafe (<span id="approveDistanceThresholdValue" class="font-weight-bold">0</span> KM), belirlenen 200 KM eşiğini aşmaktadır! Girdiğiniz kilometre değerlerini teyit ediniz.
                        </div>
                    </div>

                    <!-- Şefe Onay Sorusu Banner'ı -->
                    <div class="alert alert-warning border-left border-warning p-3 mb-3" style="border-left-width: 4px !important;">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                            <div class="d-flex align-items-center mb-2 mb-md-0">
                                <i class="fa fa-clock-o text-warning mr-3" style="font-size: 2rem;"></i>
