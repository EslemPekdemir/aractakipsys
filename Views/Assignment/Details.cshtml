                                </div>
                            </div>
                            <button type="button" id="btnToggleTimeEdit" class="btn btn-sm btn-outline-warning text-dark font-weight-bold shadow-sm text-nowrap ml-md-3" onclick="toggleApproveTimeEditMode()">
                                <i class="fa fa-pencil mr-1"></i> Saatlerde / Sürede Değişiklik Yap
                            </button>
                        </div>
                    </div>

                    <!-- Planlanan vs Fiili Süre Göstergesi -->
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center bg-white border rounded px-3 py-2 mb-3 small">
                        <div class="mb-1 mb-sm-0">
                            <span class="text-muted mr-1"><i class="fa fa-calendar-check-o text-info mr-1"></i> Planlanan Süre:</span>
                            <strong id="approvePlannedHoursBadge" class="text-info font-14">0.00 Saat</strong>
                        </div>
                        <div>
                            <span class="text-muted mr-1"><i class="fa fa-clock-o text-success mr-1"></i> Fiili Sefer:</span>
                            <strong id="approveActualHoursBadge" class="text-success font-14">0.00 Saat</strong>
                            <span id="approveDurationDeltaBadge" class="badge badge-light border ml-1"></span>
                        </div>
                    </div>

                    <!-- Erken Dönüş & Konaklama Akıllı Uyarı Kutusu -->
                    <div id="approveEarlyReturnAlert" class="alert alert-danger border-left border-danger p-3 mb-3 d-none" style="border-left-width: 4px !important; background-color: #fdf2f2;">
                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center">
                            <div class="mb-2 mb-sm-0 mr-sm-2">
                                <strong class="text-danger d-block">
                                    <i class="fa fa-exclamation-triangle mr-1"></i> Erken Dönüş & Konaklama Kontrolü
                                </strong>
                                <small class="text-dark" id="approveEarlyReturnText">
                                    Bu görev planlanırken konaklama öngörülmüştü; ancak sefer aynı gün içinde tamamlanmıştır. Şoför otelde kalmadıysa sıfırlayabilirsiniz.
                                </small>
                            </div>
                            <button type="button" class="btn btn-sm btn-danger font-weight-bold text-nowrap shadow-sm" onclick="resetAccommodationFields()">
                                <i class="fa fa-times-circle mr-1"></i> Konaklama Yapılmadı (Sıfırla)
                            </button>
                        </div>
                    </div>

                    <!-- ÇALIŞMA SAATLERİ ONAYI -->
                    <div id="approveTimeCard" class="border rounded p-3 mb-3 bg-white" style="transition: all 0.3s ease;">
                        <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                            <h6 class="font-weight-bold text-dark mb-0">
                                <i class="fa fa-clock-o text-success mr-1"></i> Fiili Sefer Saatleri Onayı
                            </h6>
                            <span id="badgeTimeEditStatus" class="badge badge-light border text-muted">
                                <i class="fa fa-check-circle text-success mr-1"></i> Şoförün Bildirimi
                            </span>
                        </div>

                        <!-- Şef Değişiklik Modu Bilgilendirme ve Hızlı Sıfırlama Çubuğu -->
                        <div id="timeEditActiveAlert" class="alert alert-warning py-2 px-3 mb-3 small d-none" style="border-radius: 6px;">
                            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center">
                                <div>
                                    <i class="fa fa-info-circle mr-1 text-warning"></i>
                                    <strong>Saat / Süre Düzenleme Modu Açık:</strong> Tarih-saatleri değiştirebilir veya aşağıdan doğrudan <strong>Fiili Görev Süresi (Saat)</strong> kutusunu artırıp azaltabilirsiniz.
                                </div>
                                <button type="button" class="btn btn-xs btn-outline-dark font-weight-bold mt-2 mt-sm-0 text-nowrap" onclick="resetToDriverOriginalTimes()">
                                    <i class="fa fa-undo mr-1"></i> Şoförün İlk Saatine Dön
                                </button>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 form-group">
                                <label class="font-weight-bold text-dark small">
                                    <i class="fa fa-sign-out text-success mr-1"></i> Onaylanan Sefer Çıkış Saati <span class="text-danger">*</span>
                                </label>
                                <input type="datetime-local" id="approveStartTime" name="ConfirmedStartTime" class="form-control font-weight-bold" required />
                                <small class="form-text text-muted">Şoförün sefere fiilen çıktığı saat</small>
                            </div>
                            <div class="col-md-6 form-group">
                                <label class="font-weight-bold text-dark small">
                                    <i class="fa fa-sign-in text-primary mr-1"></i> Onaylanan Sefer Dönüş Saati <span class="text-danger">*</span>
                                </label>
                                <input type="datetime-local" id="approveEndTime" name="ConfirmedEndTime" class="form-control font-weight-bold" required />
                                <small class="form-text text-muted">Şoförün sefere fiilen döndüğü saat</small>
                            </div>
                        </div>
                        <div class="p-3 rounded bg-light border d-flex flex-column flex-sm-row justify-content-between align-items-sm-center">
                            <div>
                                <small class="text-muted font-weight-bold d-block"><i class="fa fa-hourglass-half text-info mr-1"></i> Onaylanan Fiili Görev Süresi:</small>
                                <span class="font-weight-bold text-dark font-15" id="calcDutyDurationText">0 Saat 0 Dakika</span>
                                <span class="text-muted small" id="calcDutyDecimalHoursText">(0.00 Saat)</span>
                            </div>
                            <div id="divQuickDurationButtons" class="mt-2 mt-sm-0 d-none">
                                <span class="small text-muted font-weight-bold mr-1">Hızlı Süre Belirle:</span>
                                <div class="btn-group btn-group-xs">
                                    <button type="button" class="btn btn-outline-secondary btn-xs font-weight-bold" onclick="setQuickDutyHours(1)">1 Sa</button>
                                    <button type="button" class="btn btn-outline-secondary btn-xs font-weight-bold" onclick="setQuickDutyHours(2)">2 Sa</button>
                                    <button type="button" class="btn btn-outline-secondary btn-xs font-weight-bold" onclick="setQuickDutyHours(4)">4 Sa</button>
                                    <button type="button" class="btn btn-outline-secondary btn-xs font-weight-bold" onclick="setQuickDutyHours(8)">8 Sa</button>
                                </div>
                            </div>
                        </div>
                        <input type="hidden" id="approveHourlyRate" name="HourlyRate" value="" />
                    </div>

                    <!-- BLOK 1: GÖREV ÜCRETİ HESAPLAMA (OPSİYONEL) -->
                    <div class="border rounded p-3 mb-3 bg-white">
                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center border-bottom pb-2 mb-3">
                            <div>
                                <h6 class="font-weight-bold text-dark mb-0">
                                    <i class="fa fa-money text-warning mr-1"></i> 1. Görev Ücreti (Opsiyonel)
                                </h6>
                                <small class="text-muted">Saatlik veya günlük ücret belirleyebilirsiniz. Boş bırakılırsa 0 ₺ olarak kaydedilir.</small>
                            </div>
                            <div class="btn-group btn-group-sm mt-2 mt-sm-0">
                                <button type="button" class="btn btn-xs btn-primary font-weight-bold" id="btnApprovePerDiemHourly" onclick="setApprovePerDiemMode('Hourly')">
                                    <i class="fa fa-clock-o mr-1"></i> Saatlik Ücret
                                </button>
                                <button type="button" class="btn btn-xs btn-outline-secondary font-weight-bold" id="btnApprovePerDiemDaily" onclick="setApprovePerDiemMode('Daily')">
                                    <i class="fa fa-calendar mr-1"></i> Günlük Ücret
                                </button>
                            </div>
                        </div>
                        <input type="hidden" id="approvePerDiemType" name="PerDiemType" value="Hourly" />
                        <div class="row">
                            <!-- Saatlik Süre (Hourly) -->
                            <div class="col-md-4 col-12 form-group" id="approvePerDiemHoursGroup">
                                <label class="font-weight-bold text-dark small d-flex justify-content-between align-items-center">
                                    <span>Fiili Görev Süresi (Saat)</span>
                                    <span id="badgeCustomHoursIndicator" class="badge badge-warning font-weight-bold py-1 px-2 d-none">
                                        <i class="fa fa-pencil mr-1"></i> Şef Revizesi
                                    </span>
                                </label>
                                <div class="input-group">
                                    <input type="number" id="approvePerDiemHours" name="PerDiemHours" min="0" step="0.1" placeholder="0.0" class="form-control font-weight-bold text-primary" />
                                    <div class="input-group-append"><span class="input-group-text">Saat</span></div>
                                </div>
                                <small class="form-text text-muted" id="approvePerDiemHoursHint">Fiili süreden otomatik aktarılır (Elle artırıp azaltabilirsiniz)</small>
                            </div>
                            <!-- Günlük Süre (Daily) -->
                            <div class="col-md-4 col-12 form-group d-none" id="approvePerDiemDaysGroup">
                                <label class="font-weight-bold text-dark small">Ücretli Gün Sayısı</label>
                                <input type="number" id="approvePerDiemDays" name="PerDiemDays" min="0" step="1" placeholder="0 Gün" class="form-control font-weight-bold" />
                                <small class="form-text text-muted">Gün sayısı</small>
                            </div>
                            <!-- Birim Ücret -->
                            <div class="col-md-4 col-6 form-group">
                                <label class="font-weight-bold text-dark small" id="approvePerDiemRateLabel">Saat Başına Ücret (₺)</label>
                                <div class="input-group">
                                    <input type="number" id="approvePerDiemRate" name="PerDiemRate" min="0" step="0.01" placeholder="0.00" class="form-control font-weight-bold text-success" />
                                    <div class="input-group-append">
                                        <span class="input-group-text" id="approvePerDiemRateUnit">₺/Saat</span>
                                    </div>
                                </div>
                                <small class="form-text text-muted">Opsiyonel birim ücret</small>
                            </div>
                            <!-- Toplam Görev Ücreti -->
                            <div class="col-md-4 col-6 form-group">
                                <label class="font-weight-bold text-dark small">Toplam Ücret (₺)</label>
                                <div class="input-group">
                                    <input type="number" id="approvePerDiemAmount" name="PerDiemAmount" min="0" step="0.01" placeholder="0.00" class="form-control font-weight-bold text-warning" />
                                    <div class="input-group-append">
                                        <span class="input-group-text">₺</span>
                                    </div>
                                </div>
                                <small class="form-text text-muted">Otomatik hesaplanır</small>
                            </div>
                        </div>
                    </div>

                    <!-- BLOK 2: KONAKLAMA MASRAFI -->
                    <div class="border rounded p-3 mb-3 bg-white">
                        <div class="border-bottom pb-2 mb-3">
                            <h6 class="font-weight-bold text-dark mb-0">
                                <i class="fa fa-bed text-primary mr-1"></i> 2. Konaklama Masrafı (Opsiyonel)
                            </h6>
                        </div>
                        <div class="row">
                            <div class="col-md-6 form-group">
                                <label class="font-weight-bold text-dark small">Konaklanan Gece Sayısı</label>
                                <input type="number" id="approveAccommodationNights" name="AccommodationNights" min="0" step="1" placeholder="0 Gece" class="form-control" />
                                <small class="form-text text-muted">Varsa konaklanan gece</small>
                            </div>
                            <div class="col-md-6 form-group">
                                <label class="font-weight-bold text-dark small">Konaklama Masrafı Tutarı (₺)</label>
                                <div class="input-group">
                                    <input type="number" id="approveAccommodationCost" name="AccommodationCost" min="0" step="0.01" placeholder="0.00" class="form-control font-weight-bold text-primary" />
                                    <div class="input-group-append">
                                        <span class="input-group-text">₺</span>
                                    </div>
                                </div>
                                <small class="form-text text-muted">İbraz edilen otel faturası tutarı</small>
                            </div>
                        </div>
                    </div>

                    <!-- BLOK 3: ONAY NOTU & AÇIKLAMA -->
                    <div class="border rounded p-3 mb-3 bg-white">
                        <div class="form-group mb-0">
                            <label class="font-weight-bold text-dark small">
                                <i class="fa fa-comment-o text-muted mr-1"></i> 3. Onay Notu & Açıklama
                            </label>
                            <input type="text" id="approveExpenseNotes" name="ExpenseNotes" class="form-control" placeholder="Varsa onay, mesai veya görev açıklaması..." />
                        </div>
                    </div>

                    <!-- CANLI GENEL TOPLAM VE İCMAL KARTI -->
                    <div class="card border-0 shadow-sm mt-3" style="background: linear-gradient(135deg, #1ab394 0%, #0e6251 100%); color: #ffffff; border-radius: 10px;">
                        <div class="card-body p-3">
                            <div class="row align-items-center">
                                <div class="col-md-7 border-right border-white-50 mb-3 mb-md-0">
                                    <span class="text-white-50 small text-uppercase font-weight-bold d-block mb-1">Maliyet Dağılımı İcmali</span>
                                    <div class="d-flex justify-content-between text-white-50 small mb-1">
                                        <span>Onaylanan Sefer Süresi:</span>
                                        <strong class="text-white" id="summaryDutyDuration">0 Saat 0 Dk</strong>
                                    </div>
                                    <div class="d-flex justify-content-between text-white-50 small mb-1">
                                        <span>Görev Ücreti:</span>
                                        <strong class="text-white" id="summaryPerDiem">0,00 ₺</strong>
                                    </div>
                                    <div class="d-flex justify-content-between text-white-50 small">
                                        <span>Konaklama Masrafı:</span>
                                        <strong class="text-white" id="summaryAccommodation">0,00 ₺</strong>
                                    </div>
                                </div>
                                <div class="col-md-5 text-center text-md-right">
                                    <span class="text-white-50 small text-uppercase font-weight-bold d-block">TOPLAM SEYAHAT GİDERİ</span>
                                    <h2 class="font-weight-bold text-white mb-0" id="calcGrandTotalText" style="font-size: 2.1rem; text-shadow: 0 2px 4px rgba(0,0,0,0.3);">
                                        0,00 ₺
                                    </h2>
                                    <small class="text-white-50 d-block mt-1">(Ücret + Konaklama)</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="approveTimeErrorAlert" class="alert alert-danger mt-3 py-2 px-3 d-none" style="border-radius: 6px;">
                        <i class="fa fa-exclamation-triangle mr-2"></i>
                        <span id="approveTimeErrorText">Dönüş saati, çıkış saatinden sonra olmalıdır.</span>
                    </div>

                    <div class="text-muted small mt-3">
                        <i class="fa fa-lock text-secondary mr-1"></i>
                        <strong>Gizlilik Notu:</strong> Bu saat onayı ve görev maliyeti hesaplama verileri yalnızca Yönetici ve Şef yetkililerine açıktır, şoför ekranında gösterilmez.
                    </div>
                </div>

                <div class="modal-footer bg-light d-flex flex-column-reverse flex-sm-row justify-content-end align-items-stretch align-items-sm-center">
                    <button type="button" class="btn btn-secondary mt-2 mt-sm-0" data-dismiss="modal">Vazgeç</button>
                    <button type="submit" id="btnSubmitApproveEnd" class="btn btn-success font-weight-bold px-4 shadow-sm">
                        <i class="fa fa-check-circle mr-1"></i> Görevi & Tüm Maliyetleri Onayla
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (User.IsInRole("Admin") || User.IsInRole("Kullanici") || User.IsInRole("DaireBaskani"))
