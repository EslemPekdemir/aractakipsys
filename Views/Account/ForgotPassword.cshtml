<!-- File: Views/Account/ForgotPassword.cshtml -->
@model aractakipsys.Models.ViewModels.Account.ForgotPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Şifremi Unuttum - Araç Takip Sistemi";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Düzce Üniversitesi</title>

    <link href="~/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/font-awesome/css/font-awesome.css" rel="stylesheet">
    <link href="~/css/animate.css" rel="stylesheet">
    <link href="~/css/style.css" rel="stylesheet">

    <style>
        body {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            margin: 0;
            padding: 20px;
        }
        .login-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.25);
            width: 100%;
            max-width: 440px;
            padding: 40px 35px;
            border: none;
        }
        .brand-icon {
            width: 68px;
            height: 68px;
            background: rgba(30, 60, 114, 0.08);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px auto;
            color: #1e3c72;
            font-size: 2rem;
        }
        .form-control {
            border-radius: 8px;
            height: 46px;
            padding-left: 14px;
            font-size: 0.95rem;
            border: 1px solid #d1d5db;
        }
        .form-control:focus {
            border-color: #2a5298;
            box-shadow: 0 0 0 3px rgba(42, 82, 152, 0.15);
        }
        .btn-submit {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            border: none;
            color: #ffffff;
            height: 48px;
            border-radius: 8px;
            font-size: 1.05rem;
            font-weight: 700;
            transition: all 0.2s ease;
        }
        .btn-submit:hover {
            background: linear-gradient(135deg, #162c55 0%, #1f3f75 100%);
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 5px 15px rgba(30, 60, 114, 0.3);
        }
    </style>
</head>
<body>

    <div class="login-card animated fadeInDown">
        <div class="text-center mb-4">
            <div class="brand-icon">
                <i class="fa fa-key"></i>
            </div>
            <h4 class="font-weight-bold text-dark mb-1">Şifre Sıfırlama</h4>
            <div class="text-muted small">
                Kayıtlı e-posta adresinizi giriniz, şifre sıfırlama bağlantısı gönderilecektir.
            </div>
        </div>

        <form method="post" action="/Account/ForgotPassword">
            @Html.AntiForgeryToken()

            <div class="form-group mb-3">
                <label for="emailInput" class="font-weight-bold text-secondary small text-uppercase">
                    Kullanıcı Adı veya E-Posta Adresi
                </label>
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text bg-light border-right-0" style="border-radius: 8px 0 0 8px;">
                            <i class="fa fa-user-circle text-muted"></i>
                        </span>
                    </div>
                    <input type="text" id="emailInput" name="EmailOrUsername" class="form-control border-left-0" 
                           placeholder="Kullanıcı adı veya e-posta" value="@Model.EmailOrUsername" required autofocus />
                </div>
                <span asp-validation-for="EmailOrUsername" class="text-danger small font-weight-bold"></span>
            </div>

            <button type="submit" class="btn btn-submit btn-block shadow-sm">
                <i class="fa fa-paper-plane mr-2"></i> Sıfırlama Bağlantısı Gönder
            </button>
        </form>

        <div class="alert alert-info mt-3 p-3 rounded" style="font-size: 0.85rem;">
            <i class="fa fa-info-circle mr-1"></i>
            <strong>Şoför ve Saha Personeli İçin:</strong> E-postanıza erişiminiz yoksa doğrudan Ulaşım Şefliği veya Bilgi İşlem ile iletişime geçerek şifrenizi anında güncelletebilirsiniz.
        </div>

        <div class="text-center mt-3 pt-2">
            <a href="/Account/Login" class="text-primary small font-weight-bold" style="text-decoration: none;">
                <i class="fa fa-arrow-left mr-1"></i> Giriş Ekranına Dön
            </a>
        </div>
    </div>

    <script src="~/js/jquery-3.1.1.min.js"></script>
    <script src="~/js/bootstrap.js"></script>
</body>
</html>
