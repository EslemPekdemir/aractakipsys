<!-- File: Views/Account/ForgotPasswordConfirmation.cshtml -->
@{
    Layout = null;
    ViewData["Title"] = "Şifre Sıfırlama Bağlantısı Gönderildi";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Düzce Üniversitesi</title>

    <link href="~/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/font-awesome/css/font-awesome.css" rel="stylesheet">
    <link href="~/css/animate.css" rel="stylesheet">
    <link href="~/css/style.css" rel="stylesheet">

    <style>
        body {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            margin: 0;
            padding: 20px;
        }
        .login-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.25);
            width: 100%;
            max-width: 440px;
            padding: 40px 35px;
            border: none;
            text-align: center;
        }
        .icon-box {
            width: 72px;
            height: 72px;
            background: #ecfdf5;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px auto;
            color: #10b981;
            font-size: 2.5rem;
        }
    </style>
</head>
<body>

    <div class="login-card animated fadeInDown">
        <div class="icon-box">
            <i class="fa fa-envelope-o"></i>
        </div>
        <h4 class="font-weight-bold text-dark mb-2">E-Postanızı Kontrol Ediniz</h4>
        <p class="text-muted" style="font-size: 0.95rem; line-height: 1.5;">
            @(ViewBag.SuccessMessage ?? "Eğer sistemde kayıtlı bir e-posta adresi girdiyseniz, şifre sıfırlama bağlantısı gönderilmiştir.")
        </p>

        <div class="alert alert-light border text-left mt-3 p-3 rounded" style="font-size: 0.85rem;">
            <i class="fa fa-info-circle text-primary mr-1"></i>
            E-posta birkaç dakika içinde gelen kutunuza ulaşmazsa lütfen <strong>Spam / İstenmeyen</strong> klasörünü de kontrol ediniz.
        </div>

        <div class="mt-4">
            <a href="/Account/Login" class="btn btn-primary btn-block font-weight-bold py-2 shadow-sm">
                <i class="fa fa-sign-in mr-1"></i> Giriş Ekranına Dön
            </a>
        </div>
    </div>

    <script src="~/js/jquery-3.1.1.min.js"></script>
    <script src="~/js/bootstrap.js"></script>
</body>
</html>
