@model aractakipsys.Models.ViewModels.Account.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Giriş Yap - Araç Takip Sistemi";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Düzce Üniversitesi</title>

    <link href="~/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/font-awesome/css/font-awesome.css" rel="stylesheet">
    <link href="~/css/animate.css" rel="stylesheet">
    <link href="~/css/style.css" rel="stylesheet">

    <style>
        html, 
        body, 
        body:not(.mini-navbar) {
            background-color: #1e3c72 !important;
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%) !important;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            margin: 0;
            padding: 25px 15px;
            box-sizing: border-box;
            width: 100%;
            overflow-x: hidden;
        }

        @@media (max-width: 768px) {
            body, 
            body:not(.mini-navbar) {
                background-color: #1e3c72 !important;
                background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%) !important;
            }
        }
        .login-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.25);
            width: 100%;
            max-width: 420px;
            padding: 32px 28px;
            border: none;
            margin: auto;
            transition: all 0.3s ease;
        }
        .login-logo-wrap {
            display: inline-block;
            margin: 0 auto 10px auto;
            text-align: center;
        }
        .login-univ-logo {
            max-height: 82px;
            width: auto;
            max-width: 155px;
            object-fit: contain;
            display: block;
            margin: 0 auto;
            filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.04));
            transition: transform 0.25s ease;
        }
        .login-univ-logo:hover {
            transform: scale(1.02);
        }
        .form-control {
            border-radius: 8px;
            height: 44px;
            padding-left: 14px;
            font-size: 0.95rem;
            border: 1px solid #d1d5db;
        }
        .form-control:focus {
            border-color: #2a5298;
            box-shadow: 0 0 0 3px rgba(42, 82, 152, 0.15);
        }
        .btn-login {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            border: none;
            color: #ffffff;
            height: 46px;
            border-radius: 8px;
            font-size: 1.02rem;
            font-weight: 700;
            letter-spacing: 0.5px;
            transition: all 0.2s ease;
        }
        .btn-login:hover {
            background: linear-gradient(135deg, #162c55 0%, #1f3f75 100%);
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 5px 15px rgba(30, 60, 114, 0.3);
        }
        .btn-login:active {
            transform: translateY(0);
        }

        /* Captcha giriş alanı ve küçük, standart placeholder stili */
        #captchaCodeInput {
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 2px;
            font-size: 0.95rem;
        }
        #captchaCodeInput::placeholder {
            text-transform: none !important;
            font-weight: 400 !important;
            letter-spacing: normal !important;
            font-size: 0.82rem !important;
            color: #9ca3af !important;
        }

        /* Mobil ve küçük ekranlar için responsive uyumluluk */
        @@media (max-width: 576px) {
            body {
                padding: 15px 12px;
            }
            .login-card {
                padding: 22px 18px;
                border-radius: 14px;
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
            }
            .login-univ-logo {
                max-height: 68px;
                max-width: 135px;
            }
            .login-title {
                font-size: 1.15rem !important;
            }
            .login-subtitle {
                font-size: 0.72rem !important;
            }
            .form-group.mb-3 {
                margin-bottom: 0.75rem !important;
            }
            .form-group.mb-4 {
                margin-bottom: 0.85rem !important;
            }
            .form-control {
                height: 42px;
                font-size: 0.9rem;
            }
            .btn-login {
                height: 44px;
                font-size: 0.96rem;
            }
            .captcha-box-img {
                height: 42px !important;
            }
            .btn-refresh-captcha {
                height: 42px !important;
                width: 42px !important;
            }
        }

        /* Düşük dikey yükseklikli ekranlar için responsive daraltma */
        @@media (max-height: 720px) {
            body {
                padding: 10px;
            }
            .login-card {
                padding: 18px 20px;
            }
            .login-univ-logo {
                max-height: 58px;
                max-width: 120px;
                margin-bottom: 4px;
            }
            .login-header-block {
                margin-bottom: 12px !important;
            }
            .form-group.mb-3 {
                margin-bottom: 0.6rem !important;
            }
            .form-group.mb-4 {
                margin-bottom: 0.75rem !important;
            }
        }
    </style>
</head>
<body>

    <div class="login-card animated fadeInDown">
        <!-- KURUM BAŞLIĞI VE LOGO ALANI -->
        <div class="text-center mb-4 login-header-block">
            <div class="login-logo-wrap">
                <img src="~/img/duzce_logo.png" alt="Düzce Üniversitesi" class="login-univ-logo" />
            </div>
            <div class="text-muted font-weight-bold small text-uppercase login-subtitle" style="letter-spacing: 0.8px; font-size: 0.8rem; color: #4b5563;">
                Araç Takip ve Görevlendirme Sistemi
            </div>
        </div>

        <!-- BAŞARI / BİLGİ BİLDİRİMİ -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success p-3 mb-4 rounded" role="alert" style="font-size: 0.9rem;">
                <i class="fa fa-check-circle mr-1"></i> @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger p-3 mb-4 rounded" role="alert" style="font-size: 0.9rem;">
                <i class="fa fa-exclamation-circle mr-1"></i> @TempData["ErrorMessage"]
            </div>
        }

        <!-- HATA BİLDİRİMİ -->
        @if (!ViewData.ModelState.IsValid)
        {
            var modelErrors = ViewData.ModelState.Values
                .SelectMany(v => v.Errors)
                .Select(e => e.ErrorMessage)
                .Where(m => !string.IsNullOrWhiteSpace(m))
                .Distinct()
                .ToList();

            if (modelErrors.Any())
            {
                <div class="alert alert-danger p-3 mb-4 rounded" role="alert" style="font-size: 0.9rem;">
                    <i class="fa fa-exclamation-circle mr-1"></i>
                    @foreach (var error in modelErrors)
                    {
                        <div>@error</div>
                    }
                </div>
            }
        }

        <!-- GİRİŞ FORMU -->
        <form method="post" action="/Account/Login">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
            <input type="hidden" id="captchaToken" name="CaptchaToken" value="@Model.CaptchaToken" />

            <div class="form-group mb-3">
                <label for="usernameInput" class="font-weight-bold text-secondary small text-uppercase">
                    Kullanıcı Adı veya E-Posta
                </label>
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text bg-light border-right-0" style="border-radius: 8px 0 0 8px;">
                            <i class="fa fa-user text-muted"></i>
                        </span>
                    </div>
                    <input type="text" id="usernameInput" name="Username" class="form-control border-left-0" 
                           placeholder="Kullanıcı adı veya e-posta" value="@Model.Username" required autofocus />
                </div>
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label for="passwordInput" class="font-weight-bold text-secondary small text-uppercase">
                    Şifre
                </label>
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text bg-light border-right-0" style="border-radius: 8px 0 0 8px;">
                            <i class="fa fa-lock text-muted"></i>
                        </span>
                    </div>
                    <input type="password" id="passwordInput" name="Password" class="form-control border-left-0 border-right-0" 
                           placeholder="••••••••" required style="border-radius: 0;" />
                    <div class="input-group-append">
                        <button class="btn btn-light border border-left-0 text-muted" type="button" id="togglePasswordBtn" 
                                style="border-radius: 0 8px 8px 0; border-color: #d1d5db; padding: 0 14px;" 
                                title="Şifreyi Göster / Gizle" aria-label="Şifreyi Göster / Gizle">
                            <i class="fa fa-eye" id="togglePasswordIcon"></i>
                        </button>
                    </div>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <!-- GÜVENLİK KODU (CAPTCHA) ALANI -->
            <div class="form-group mb-3">
                <label for="captchaCodeInput" class="font-weight-bold text-secondary small text-uppercase">
                    Güvenlik Kodu
                </label>
                <div class="d-flex align-items-center mb-2">
                    <div id="captchaImageContainer" class="border rounded p-1 bg-light d-flex align-items-center justify-content-center mr-2 shadow-sm captcha-box-img" 
                         style="height: 46px; flex: 1; background-color: #f8fafc; border-color: #d1d5db; cursor: default; overflow: hidden; user-select: none;">
                        <img id="captchaImage" src="@Html.Raw(Model.CaptchaSvgImage)" alt="Güvenlik Kodu" style="height: 100%; max-width: 100%; display: block;" />
                    </div>
                    <button class="btn btn-light border d-flex align-items-center justify-content-center text-secondary btn-refresh-captcha" 
                            type="button" id="btnRefreshCaptcha" 
                            style="height: 46px; width: 46px; border-radius: 8px; border-color: #d1d5db;" 
                            title="Güvenlik Kodunu Yenile" aria-label="Güvenlik Kodunu Yenile">
                        <i class="fa fa-refresh" id="captchaRefreshIcon"></i>
                    </button>
                </div>
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text bg-light border-right-0" style="border-radius: 8px 0 0 8px;">
                            <i class="fa fa-shield text-muted"></i>
                        </span>
                    </div>
                    <input type="text" id="captchaCodeInput" name="CaptchaCode" class="form-control border-left-0" 
                           placeholder="Resimdeki kodu giriniz" maxlength="6" autocomplete="off" required />
                </div>
                <span asp-validation-for="CaptchaCode" class="text-danger small font-weight-bold mt-1 d-block"></span>
            </div>

            <div class="form-group d-flex justify-content-between align-items-center mb-4">
                <div class="custom-control custom-checkbox">
                    <input type="checkbox" class="custom-control-input" id="rememberMe" name="RememberMe" value="true" @(Model.RememberMe ? "checked" : "")>
                    <label class="custom-control-label text-muted small" for="rememberMe">Beni Hatırla</label>
                </div>
                <div>
                    <a href="/Account/ForgotPassword" class="text-primary small font-weight-bold" style="text-decoration: none;">
                        Şifremi Unuttum?
                    </a>
                </div>
            </div>

            <button type="submit" class="btn btn-login btn-block shadow-sm">
                <i class="fa fa-sign-in mr-2"></i> Giriş Yap
            </button>
        </form>

        <div class="text-center mt-3 pt-2">
            <a href="/AracTalebi" class="text-primary small font-weight-bold" style="text-decoration: none;">
                <i class="fa fa-calendar-plus-o mr-1"></i> Personel Araç Talebi Gönder &rarr;
            </a>
        </div>

        <div class="text-center text-muted small mt-3 pt-3 border-top">
            &copy; 2026 Düzce Üniversitesi — Bilgi İşlem Daire Başkanlığı
        </div>
    </div>

    <script src="~/js/jquery-3.1.1.min.js"></script>
    <script src="~/js/bootstrap.js"></script>
    <script>
        $(document).ready(function () {
            // Eski oturumdan kalan toast hafızasını temizle
            try {
                sessionStorage.removeItem('dashboard_toast_shown_sig');
                sessionStorage.removeItem('dashboard_toast_dismissed_sig');
            } catch (e) { }

            // Şifre Göster / Gizle
            $('#togglePasswordBtn').on('click', function (e) {
                e.preventDefault();
                var passwordInput = $('#passwordInput');
                var icon = $('#togglePasswordIcon');
                
                if (passwordInput.attr('type') === 'password') {
                    passwordInput.attr('type', 'text');
                    icon.removeClass('fa-eye').addClass('fa-eye-slash text-primary');
                } else {
                    passwordInput.attr('type', 'password');
                    icon.removeClass('fa-eye-slash text-primary').addClass('fa-eye');
                }
                passwordInput.focus();
            });

            // Captcha Yenileme (Yalnızca Dönen Yenileme Butonuna Tıklandığında)
            $('#btnRefreshCaptcha').on('click', function (e) {
                e.preventDefault();
                var icon = $('#captchaRefreshIcon');
                icon.addClass('fa-spin');

                $.ajax({
                    url: '/Account/GetNewCaptcha',
                    type: 'GET',
                    cache: false,
                    success: function (data) {
                        if (data && data.success) {
                            $('#captchaImage').attr('src', data.svg);
                            $('#captchaToken').val(data.token);
                            $('#captchaCodeInput').val('').focus();
                        }
                    },
                    error: function () {
                        console.error('Güvenlik kodu yenilenemedi.');
                    },
                    complete: function () {
                        setTimeout(function () {
                            icon.removeClass('fa-spin');
                        }, 350);
                    }
                });
            });
        });
    </script>
</body>
</html>
