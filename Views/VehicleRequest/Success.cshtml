@model aractakipsys.Models.Entities.VehicleRequest
@{
    Layout = null;
    ViewData["Title"] = "Talep Alındı - Düzce Üniversitesi";
    var successMsg = ViewBag.SuccessMessage as string ?? "Talebiniz alındı, Şef tarafından değerlendirilecek";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <link href="~/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/font-awesome/css/font-awesome.css" rel="stylesheet">
    <link href="~/css/animate.css" rel="stylesheet">
    <link href="~/css/style.css" rel="stylesheet">

    <style>
        html {
            background-color: #1e3c72;
            min-height: 100%;
        }
        body {
            background-color: #1e3c72;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            margin: 0;
            padding: 30px 15px;
            box-sizing: border-box;
            width: 100%;
            overflow-x: hidden;
        }
        .success-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.25);
            width: 100%;
            max-width: 540px;
            padding: 40px 35px;
            border: none;
        }
        .success-icon-wrap {
            width: 70px;
            height: 70px;
            background: rgba(16, 185, 129, 0.12);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px auto;
            color: #10b981;
            font-size: 2.4rem;
        }
        .detail-row {
            padding: 10px 12px;
            border-bottom: 1px solid #f1f5f9;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.9rem;
        }
        .detail-row:last-child {
            border-bottom: none;
        }
        .detail-label {
            color: #64748b;
            font-weight: 500;
        }
        .detail-value {
            color: #1e293b;
            font-weight: 600;
            text-align: right;
            max-width: 60%;
            word-break: break-word;
        }
        .btn-new-request {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            border: none;
            color: #ffffff;
            height: 46px;
            border-radius: 8px;
            font-weight: 700;
            transition: all 0.2s;
        }
        .btn-new-request:hover {
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 5px 15px rgba(30, 60, 114, 0.3);
        }
        .success-alert {
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            color: #166534;
            border-radius: 8px;
            padding: 14px 16px;
            font-size: 0.95rem;
            font-weight: 600;
        }
    </style>
</head>
<body>

    <div class="success-card animated fadeInDown text-center">
        <!-- ONAY İKONU -->
        <div class="success-icon-wrap">
            <i class="fa fa-check-circle"></i>
        </div>

        <div class="success-alert mb-3">
            <i class="fa fa-check mr-2"></i> @successMsg
        </div>

        <p class="text-muted small mb-3">
            Talebiniz sisteme iletilmiş olup Ulaşım ve Görevlendirme Şefi tarafından incelenerek sonuçlandırılacaktır.
        </p>

        <div class="badge badge-light border px-3 py-2 font-weight-bold mb-3" style="font-size: 0.9rem; color: #1e3c72;">
            Talep Kayıt No: #TALEP-@Model.Id.ToString("D5")
        </div>

        <!-- DETAY TABLOSU -->
        <div class="card mb-4 text-left border" style="border-radius: 10px; background: #fafafa;">
            <div class="detail-row">
                <span class="detail-label"><i class="fa fa-user mr-1 text-muted"></i> Ad Soyad</span>
                <span class="detail-value">@Model.RequesterFullName</span>
            </div>
            <div class="detail-row">
                <span class="detail-label"><i class="fa fa-envelope mr-1 text-muted"></i> E-Posta</span>
                <span class="detail-value">@Model.RequesterEmail</span>
            </div>
            <div class="detail-row">
                <span class="detail-label"><i class="fa fa-phone mr-1 text-muted"></i> Telefon</span>
                <span class="detail-value">@Model.RequesterPhone</span>
            </div>
            <div class="detail-row">
                <span class="detail-label"><i class="fa fa-bullseye mr-1 text-muted"></i> Görev Amacı</span>
                <span class="detail-value text-truncate" title="@Model.Purpose">@Model.Purpose</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Route))
            {
                <div class="detail-row">
                    <span class="detail-label"><i class="fa fa-map-marker mr-1 text-muted"></i> Güzergah</span>
                    <span class="detail-value text-truncate" title="@Model.Route">@Model.Route</span>
                </div>
            }
            <div class="detail-row">
                <span class="detail-label"><i class="fa fa-info-circle mr-1 text-muted"></i> Durum</span>
                <span class="detail-value">
                    <span class="badge badge-warning px-2 py-1 font-weight-bold">Beklemede</span>
                </span>
            </div>
        </div>

        <!-- BUTONLAR -->
        <div class="row">
            <div class="col-sm-6 mb-2">
                <a href="/AracTalebi" class="btn btn-new-request btn-block d-flex align-items-center justify-content-center">
                    <i class="fa fa-plus-circle mr-2"></i> Yeni Talep Gönder
                </a>
            </div>
            <div class="col-sm-6 mb-2">
                <a href="/Account/Login" class="btn btn-outline-secondary btn-block font-weight-bold d-flex align-items-center justify-content-center" style="height: 46px; border-radius: 8px;">
                    <i class="fa fa-sign-in mr-2"></i> Yetkili Girişi
                </a>
            </div>
        </div>

        <div class="text-muted small mt-3 pt-3 border-top">
            &copy; 2026 Düzce Üniversitesi — Bilgi İşlem Daire Başkanlığı
        </div>
    </div>

    <script src="~/js/jquery-3.1.1.min.js"></script>
    <script src="~/js/bootstrap.js"></script>
</body>
</html>
