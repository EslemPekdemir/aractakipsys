@model aractakipsys.Models.ViewModels.SystemDefinition.SystemDefinitionPageViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Sistem Tanımları";
    var isReadOnly = User.IsInRole("GenelSekreter");
    var activeCategory = Model.SelectedCategory;
}

<div class="row wrapper border-bottom white-bg page-heading mb-4">
    <div class="col-lg-9">
        <h2 class="font-weight-bold">
            <i class="fa fa-sliders text-primary mr-2"></i>Sistem Tanımları (Dinamik Seçenek Listeleri)
        </h2>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
            <li class="breadcrumb-item active"><strong>Sistem Tanımları</strong></li>
            @if (activeCategory != null)
            {
                <li class="breadcrumb-item active"><strong>@activeCategory.DisplayName</strong></li>
            }
        </ol>
    </div>
    <div class="col-lg-3 text-right d-flex align-items-center justify-content-end">
        @if (!isReadOnly)
        {
            <button type="button" class="btn btn-primary font-weight-bold shadow-sm" data-toggle="modal" data-target="#createOptionModal">
                <i class="fa fa-plus mr-1"></i> Yeni Seçenek Ekle
            </button>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <i class="fa fa-check-circle mr-1"></i> @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Kapat">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <i class="fa fa-exclamation-triangle mr-1"></i> @TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Kapat">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (isReadOnly)
{
    <div class="alert alert-info border-info mb-4 shadow-sm" role="alert">
        <i class="fa fa-info-circle mr-2"></i>
        <strong>Bilgilendirme:</strong> Genel Sekreter yetkisiyle salt okunur (izleme) modundasınız. Sistem tanımlarını inceleyebilir ancak yeni seçenek ekleyemez veya mevcut kayıtları değiştiremezsiniz.
    </div>
}

<div class="row">
    <!-- SOL KOLON: KATEGORİ LİSTESİ VE TALEP SEÇENEKLERİ KÖPRÜSÜ -->
    <div class="col-lg-3 col-md-4 mb-4">
        <div class="ibox shadow-sm" style="border-radius: 8px;">
            <div class="ibox-title bg-light py-2 px-3 border-bottom" style="border-radius: 8px 8px 0 0;">
                <h5 class="font-weight-bold mb-0 text-dark">
                    <i class="fa fa-folder-open-o mr-1 text-primary"></i> Tanım Kategorileri
                </h5>
            </div>
            <div class="ibox-content p-0" style="border-radius: 0 0 8px 8px;">
                <div class="list-group list-group-flush">
                    @foreach (var cat in Model.AllCategories)
                    {
                        var isSelected = cat.Key == Model.SelectedCategory.Key;
                        <a href="/SystemDefinition?category=@cat.Key"
                           class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(isSelected ? "active font-weight-bold" : "text-dark")"
                           style="@(isSelected ? "background-color: #1ab394; border-color: #1ab394; color: #ffffff !important;" : "")">
                            <div>
                                <i class="fa @cat.Icon mr-2 @(isSelected ? "text-white" : "text-muted")"></i>
                                <span>@cat.DisplayName</span>
                            </div>
                            <span class="badge @(isSelected ? "badge-light text-dark font-weight-bold" : "badge-secondary")">
                                <i class="fa fa-chevron-right"></i>
                            </span>
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- TALEP SEÇENEKLERİ BAĞLANTISI (BİRİM & ARAÇ TÜRÜ) -->
        <div class="card border-0 shadow-sm mt-3" style="border-radius: 8px; background: linear-gradient(145deg, #f8fafc 0%, #edf2f7 100%); border-left: 4px solid #f8ac59 !important;">
            <div class="card-body p-3">
                <div class="d-flex align-items-center mb-2">
                    <i class="fa fa-external-link text-warning font-16 mr-2"></i>
                    <strong class="text-dark font-14">Talep Seçenekleri</strong>
                </div>
                <p class="small text-muted mb-2">
                    Talep formu birimleri ve talep edilen araç türleri, talep modülü üzerinden yönetilmektedir.
                </p>
                <a href="/VehicleRequest/Options" class="btn btn-outline-warning btn-sm btn-block font-weight-bold text-dark">
                    <i class="fa fa-arrow-circle-right mr-1"></i> Talep Seçeneklerine Git
                </a>
            </div>
        </div>
    </div>

    <!-- SAĞ KOLON: SEÇENEKLER TABLOSU -->
    <div class="col-lg-9 col-md-8">
        <div class="ibox shadow-sm" style="border-radius: 8px;">
            <div class="ibox-title bg-light py-2 px-3 border-bottom d-flex justify-content-between align-items-center" style="border-radius: 8px 8px 0 0;">
                <div>
                    <h5 class="font-weight-bold mb-0 text-dark">
                        <i class="fa fa-list mr-1 text-primary"></i> @(activeCategory?.DisplayName ?? "Kategori Seçenekleri")
                    </h5>
                    <small class="text-muted">@(activeCategory?.Description ?? "Kategoriye ait seçenek listesi")</small>
                </div>
                <div class="text-right">
                    <span class="badge badge-info px-2 py-1 font-weight-bold">
                        Aktif: @Model.ActiveCount / Toplam: @Model.Items.Count
                    </span>
                </div>
            </div>

            <div class="ibox-content p-0" style="border-radius: 0 0 8px 8px;">
                @if (Model.Items.Count == 0)
                {
                    <div class="p-4 text-center text-muted">
                        <i class="fa fa-folder-open-o fa-3x mb-2 text-muted"></i>
                        <p class="mb-0">Bu kategoride henüz tanımlı bir seçenek bulunmamaktadır.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0 align-middle">
                            <thead class="thead-light">
                                <tr>
                                    <th style="width: 50px;" class="text-center">#</th>
                                    <th>Seçenek Adı</th>
                                    <th style="width: 170px;" class="text-center">Kullanım Durumu</th>
                                    <th style="width: 140px;" class="text-center">Kayıt Türü</th>
                                    <th style="width: 100px;" class="text-center">Durum</th>
                                    <th style="width: 70px;" class="text-center">Sıra</th>
                                    @if (!isReadOnly)
                                    {
                                        <th style="width: 260px;" class="text-right pr-3">İşlemler</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Items.Count; i++)
                                {
                                    var item = Model.Items[i];
                                    var isLockedRename = item.IsSystemDefault || item.UsageCount > 0;
                                    var isLastActive = item.IsActive && Model.ActiveCount <= 1;

                                    <tr class="@(!item.IsActive ? "text-muted bg-light" : "")">
                                        <td class="text-center font-weight-bold">@(i + 1)</td>
                                        <td>
                                            <span class="font-weight-bold @(item.IsActive ? "text-dark" : "text-muted text-decoration-line-through")">
                                                @item.Name
                                            </span>
                                            @if (!item.IsActive)
                                            {
                                                <span class="badge badge-secondary ml-1 font-weight-normal">Pasif</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (item.UsageCount > 0)
                                            {
                                                <span class="badge badge-info px-2 py-1" title="@item.UsageCount kayıtta aktif olarak kullanılmaktadır.">
                                                    <i class="fa fa-database mr-1"></i>@item.UsageCount kayıtta kullanımda
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-light border px-2 py-1 text-muted" title="Herhangi bir kayıtta henüz kullanılmamıştır.">
                                                    0 kayıt
                                                </span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (item.IsSystemDefault)
                                            {
                                                <span class="badge badge-warning text-dark font-weight-bold" title="Sistem varsayılan çekirdek seçenektir; adı değiştirilemez, yalnızca pasife alınabilir.">
                                                    <i class="fa fa-lock mr-1"></i>Varsayılan
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-light border text-secondary font-weight-normal">
                                                    Özel Tanım
                                                </span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (item.IsActive)
                                            {
                                                <span class="badge badge-primary px-2 py-1">Aktif</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-danger px-2 py-1">Pasif</span>
                                            }
                                        </td>
                                        <td class="text-center text-muted font-12">@item.DisplayOrder</td>
                                        @if (!isReadOnly)
                                        {
                                            <td class="text-right pr-3">
                                                <div class="d-inline-flex align-items-center">
                                                    <!-- AD DÜZENLEME BUTONU -->
                                                    @if (isLockedRename)
                                                    {
                                                        <button type="button" class="btn btn-xs btn-outline-secondary mr-1" disabled
                                                                title="@(item.IsSystemDefault ? "Sistem varsayılanı seçeneklerin adı değiştirilemez." : "Kullanımda olan (" + item.UsageCount + " kayıt) seçeneğin adı değiştirilemez, yalnızca pasife alınabilir.")">
                                                            <i class="fa fa-lock mr-1"></i> Düzenle
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="btn btn-xs btn-outline-primary mr-1 edit-option-btn"
                                                                data-id="@item.Id"
                                                                data-name="@item.Name"
                                                                data-category="@item.CategoryKey"
                                                                data-toggle="modal"
                                                                data-target="#editOptionNameModal"
                                                                title="Seçenek adını düzenle">
                                                            <i class="fa fa-pencil mr-1"></i> Düzenle
                                                        </button>
                                                    }

                                                    <!-- AKTİF / PASİF BUTONU -->
                                                    <form method="post" action="/SystemDefinition/ToggleStatus" class="d-inline m-0">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <input type="hidden" name="categoryKey" value="@item.CategoryKey" />

                                                        @if (item.IsActive)
                                                        {
                                                            @if (isLastActive)
                                                            {
                                                                <button type="button" class="btn btn-xs btn-outline-secondary" disabled
                                                                        title="Kategorideki son aktif seçenek pasife alınamaz. En az bir aktif seçenek bulunmalıdır.">
                                                                    <i class="fa fa-ban mr-1"></i> Pasife Al
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <button type="submit" class="btn btn-xs btn-outline-warning"
                                                                        onclick="return confirm('\'@item.Name\' seçeneğini pasife almak istediğinize emin misiniz? (Pasife alınan seçenek yeni formlarda seçilemez; eski kayıtlarda görünmeye devam eder)');"
                                                                        title="Seçeneği pasife al">
                                                                    <i class="fa fa-pause mr-1"></i> Pasife Al
                                                                </button>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <button type="submit" class="btn btn-xs btn-outline-success"
                                                                    title="Seçeneği tekrar aktifleştir">
                                                                <i class="fa fa-play mr-1"></i> Aktifleştir
                                                            </button>
                                                        }
                                                    </form>

                                                    <!-- SİL BUTONU (Yalnızca Özel Tanımlar İçin) -->
                                                    @if (!item.IsSystemDefault)
                                                    {
                                                        if (item.UsageCount > 0)
                                                        {
                                                            <button type="button" class="btn btn-xs btn-outline-secondary ml-1" disabled
                                                                    title="Kullanımda olan (@item.UsageCount kayıt) seçenek silinemez, yalnızca pasife alınabilir.">
                                                                <i class="fa fa-trash mr-1"></i> Sil
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <form method="post" action="/SystemDefinition/Delete" class="d-inline m-0 ml-1">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="id" value="@item.Id" />
                                                                <input type="hidden" name="categoryKey" value="@item.CategoryKey" />
                                                                <button type="submit" class="btn btn-xs btn-outline-danger"
                                                                        onclick="return confirm('\'@item.Name\' seçeneğini kalıcı olarak silmek istediğinize emin misiniz?');"
                                                                        title="Seçeneği sil">
                                                                    <i class="fa fa-trash mr-1"></i> Sil
                                                                </button>
                                                            </form>
                                                        }
                                                    }
                                                </div>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODALLAR (Nested Backdrop ve Kilitlenmeyi Önlemek İçin En Dışta Tanımlandı) -->
<!-- ========================================================================= -->

@if (!isReadOnly)
{
    <!-- 1. YENİ SEÇENEK EKLEME MODALI -->
    <div class="modal fade" id="createOptionModal" tabindex="-1" role="dialog" aria-labelledby="createOptionModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow" style="border-radius: 10px;">
                <div class="modal-header bg-primary text-white" style="border-radius: 10px 10px 0 0;">
                    <h5 class="modal-title font-weight-bold" id="createOptionModalLabel">
                        <i class="fa fa-plus-circle mr-1"></i> Yeni Seçenek Ekle
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Kapat">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form method="post" action="/SystemDefinition/Create">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="CategoryKey" value="@Model.SelectedCategory.Key" />

                    <div class="modal-body p-4">
                        <div class="form-group mb-3">
                            <label class="font-weight-bold text-dark">Kategori</label>
                            <input type="text" class="form-control bg-light font-weight-bold" value="@Model.SelectedCategory.DisplayName" readonly />
                            <small class="form-text text-muted">Seçenek bu kategori altına eklenecektir.</small>
                        </div>

                        <div class="form-group mb-3">
                            <label class="font-weight-bold text-dark">Seçenek Adı <span class="text-danger">*</span></label>
                            <input type="text" name="Name" class="form-control" placeholder="Örn: Çivili Lastik, Plug-in Hibrit, Ağır Bakım..." required maxlength="100" autocomplete="off" />
                            <small class="form-text text-muted">Aynı kategoride aynı isim (büyük/küçük harf duyarsız) ikinci kez eklenemez.</small>
                        </div>

                        <div class="form-group mb-0">
                            <label class="font-weight-bold text-dark">Görüntüleme Sırası</label>
                            <input type="number" name="DisplayOrder" class="form-control" value="0" min="0" max="9999" />
                            <small class="form-text text-muted">Küçük numaralar dropdown listesinde daha üstte görünür.</small>
                        </div>
                    </div>

                    <div class="modal-footer bg-light" style="border-radius: 0 0 10px 10px;">
                        <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Vazgeç</button>
                        <button type="submit" class="btn btn-primary font-weight-bold px-4">
                            <i class="fa fa-save mr-1"></i> Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- 2. SEÇENEK ADI DÜZENLEME MODALI -->
    <div class="modal fade" id="editOptionNameModal" tabindex="-1" role="dialog" aria-labelledby="editOptionNameModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow" style="border-radius: 10px;">
                <div class="modal-header bg-warning text-dark" style="border-radius: 10px 10px 0 0;">
                    <h5 class="modal-title font-weight-bold" id="editOptionNameModalLabel">
                        <i class="fa fa-pencil-square-o mr-1"></i> Seçenek Adını Düzenle
                    </h5>
                    <button type="button" class="close text-dark" data-dismiss="modal" aria-label="Kapat">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form method="post" action="/SystemDefinition/EditName">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" id="editOptionId" value="" />
                    <input type="hidden" name="CategoryKey" id="editOptionCategoryKey" value="@Model.SelectedCategory.Key" />

                    <div class="modal-body p-4">
                        <div class="alert alert-warning small mb-3">
                            <i class="fa fa-info-circle mr-1"></i>
                            Yalnızca hiçbir kayıtta kullanılmayan seçeneklerin adı serbestçe değiştirilebilir.
                        </div>

                        <div class="form-group mb-0">
                            <label class="font-weight-bold text-dark">Yeni Seçenek Adı <span class="text-danger">*</span></label>
                            <input type="text" name="NewName" id="editOptionNewName" class="form-control" required maxlength="100" autocomplete="off" />
                            <small class="form-text text-muted">Aynı kategoride aynı isim ikinci kez kullanılamaz.</small>
                        </div>
                    </div>

                    <div class="modal-footer bg-light" style="border-radius: 0 0 10px 10px;">
                        <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Vazgeç</button>
                        <button type="submit" class="btn btn-warning font-weight-bold px-4 text-dark">
                            <i class="fa fa-save mr-1"></i> Güncelle
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.edit-option-btn').on('click', function () {
                var id = $(this).data('id');
                var name = $(this).data('name');
                var category = $(this).data('category');

                $('#editOptionId').val(id);
                $('#editOptionNewName').val(name);
                $('#editOptionCategoryKey').val(category);
            });
        });
    </script>
}
