<!-- File: Views/Surucu/ChangePassword.cshtml -->
@model aractakipsys.Models.ViewModels.Surucu.DriverChangePasswordViewModel
@{
    Layout = "_SurucuLayout";
    ViewData["Title"] = "Şifre Değiştir";
}

<div class="d-flex justify-content-between align-items-center mb-3 pt-1">
    <h5 class="font-weight-bold mb-0 text-dark" style="font-size: 1.05rem;">
        <i class="fa fa-key text-primary mr-2"></i>Şifre Değiştir
    </h5>
    <a href="/Surucu" class="btn btn-outline-secondary btn-sm px-3" style="border-radius: 6px; font-size: 0.82rem; height: 34px; display: inline-flex; align-items: center;">
        <i class="fa fa-arrow-left mr-1"></i> Görevlerime Dön
    </a>
</div>

<div class="card card-custom p-3 p-sm-4 shadow-sm border" style="border-color: #e2e8f0 !important; border-radius: 8px;">
    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="alert alert-danger py-2 px-3 mb-3 rounded" role="alert" style="font-size: 0.85rem;">
            <i class="fa fa-exclamation-circle mr-1"></i>
            @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
            {
                <span class="d-block">@error.ErrorMessage</span>
            }
        </div>
    }

    <form method="post" action="/Surucu/ChangePassword">
        @Html.AntiForgeryToken()

        <div class="form-group mb-3">
            <label asp-for="CurrentPassword" class="font-weight-bold text-dark small mb-1">
                Mevcut Şifre <span class="text-danger">*</span>
            </label>
            <div class="input-group">
                <input asp-for="CurrentPassword" class="form-control" placeholder="Mevcut şifrenizi giriniz" required 
                       style="height: 38px; font-size: 0.88rem;" />
            </div>
            <span asp-validation-for="CurrentPassword" class="text-danger small font-weight-bold"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="NewPassword" class="font-weight-bold text-dark small mb-1">
                Yeni Şifre <span class="text-danger">*</span>
            </label>
            <div class="input-group">
                <input asp-for="NewPassword" class="form-control" placeholder="Yeni şifrenizi giriniz" required 
                       style="height: 38px; font-size: 0.88rem;" />
            </div>
            <span asp-validation-for="NewPassword" class="text-danger small font-weight-bold"></span>
            <small class="form-text text-muted mt-1" style="font-size: 0.78rem;">
                <i class="fa fa-info-circle mr-1 text-primary"></i>En az 10 karakter; büyük harf, küçük harf ve rakam içermelidir.
            </small>
        </div>

        <div class="form-group mb-4">
            <label asp-for="ConfirmPassword" class="font-weight-bold text-dark small mb-1">
                Yeni Şifre (Tekrar) <span class="text-danger">*</span>
            </label>
            <div class="input-group">
                <input asp-for="ConfirmPassword" class="form-control" placeholder="Yeni şifrenizi tekrar giriniz" required 
                       style="height: 38px; font-size: 0.88rem;" />
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-danger small font-weight-bold"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-block font-weight-bold shadow-sm" style="height: 38px; border-radius: 6px; font-size: 0.88rem;">
            <i class="fa fa-check mr-1"></i> Şifremi Güncelle
        </button>
    </form>
</div>
