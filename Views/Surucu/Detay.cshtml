                <div class="form-group mb-3">
                    <label for="inputRouteReason" class="font-weight-bold text-dark">
                        Değişiklik Gerekçesi / Açıklaması <span class="text-danger">*</span>
                    </label>
                    <textarea class="form-control" id="inputRouteReason" rows="3" maxlength="500" 
                              placeholder="Güzergahın neden değiştirildiğini açıklayınız (örn: Rektörlük acil evrak sevki, yol çalışması)..." required></textarea>
