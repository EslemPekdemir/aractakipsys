                    <textarea class="form-control" id="inputReturnNotes" rows="3" 
                              maxlength="500" placeholder="Araç durumu, yakıt seviyesi veya yaşanan bir aksaklık varsa belirtebilirsiniz..."></textarea>
                </div>

                <div id="endErrorAlert" class="alert alert-danger d-none p-2 mb-0" style="font-size: 0.9rem;"></div>
            </div>
