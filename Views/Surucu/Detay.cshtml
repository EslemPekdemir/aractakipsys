                    </div>
                    <div class="custom-control custom-checkbox mb-2">
                        <input type="checkbox" class="custom-control-input" id="endCheckWater" @(Model.CheckWater ? "checked" : "")>
                        <label class="custom-control-label font-weight-600 text-dark" for="endCheckWater">Radyatör / Cam Suyu Kontrolünü Yaptım</label>
                    </div>
                    <div class="custom-control custom-checkbox mb-2">
                        <input type="checkbox" class="custom-control-input" id="endCheckFuel" @(Model.CheckFuel ? "checked" : "")>
                        <label class="custom-control-label font-weight-600 text-dark" for="endCheckFuel">Yakıt Seviyesini Kontrol Ettim</label>
                    </div>
                    <div class="custom-control custom-checkbox mb-2">
