<div class="modal fade" id="changeRouteModal" tabindex="-1" role="dialog" aria-labelledby="changeRouteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content" style="border-radius: 12px; border: none; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
            <div class="modal-header bg-warning text-white" style="border-radius: 12px 12px 0 0; background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%) !important;">
