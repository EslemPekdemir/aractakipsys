@Html.AntiForgeryToken()

@section Scripts {
<script>
    $(document).ready(function () {
        $('#vehicleChecksModal, #faultReportModal, #startAssignmentModal, #endAssignmentModal, #changeRouteModal').appendTo('body');
        const assignmentId = @Model.AssignmentId;
        const token = $('input[name="__RequestVerificationToken"]').val();
        const startKmValForTrip = @(Model.StartKm ?? Model.CurrentVehicleKm);
        const tripDistanceThreshold = 200;

        // KM Gerçek Zamanlı Eşik Kontrolü (>200 km kırmızı ünlem uyarısı)
        $('#inputEndKm').on('input change keyup', function () {
            const currentEndKm = parseInt($(this).val(), 10) || 0;
            const distance = currentEndKm - startKmValForTrip;
            if (distance > tripDistanceThreshold) {
                $('#tripDistanceValue').text(distance.toLocaleString('tr-TR'));
                $('#tripDistanceExceededAlert').removeClass('d-none');
            } else {
                $('#tripDistanceExceededAlert').addClass('d-none');
            }
        });

        // 1. BAŞLANGICI BİLDİR AJAX
        $('#btnConfirmStart').on('click', function () {
            const startKmVal = parseInt($('#inputStartKm').val(), 10);
            const minKm = @Model.CurrentVehicleKm;
            const $btn = $(this);
            const $errorDiv = $('#startErrorAlert');

            $errorDiv.addClass('d-none').text('');

            if (isNaN(startKmVal) || startKmVal < 0) {
                $errorDiv.removeClass('d-none').text('Lütfen geçerli bir başlangıç kilometresi giriniz.');
                return;
            }

            if (startKmVal < minKm) {
                $errorDiv.removeClass('d-none').text('Başlangıç KM (' + startKmVal + '), kayıtlı son kilometreden (' + minKm + ') küçük olamaz.');
                return;
            }

            $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin mr-1"></i> Bildiriliyor...');

            fetch('/Surucu/Baslat/' + assignmentId, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ startKm: startKmVal })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showNativeToast(data.message || 'Bilgileriniz kaydedildi, Şef onayı bekleniyor.', true);
                    $('#startAssignmentModal').modal('hide');
                    setTimeout(() => {
                        window.location.reload();
                    }, 1000);
                } else {
                    $errorDiv.removeClass('d-none').text(data.message || 'Bir hata oluştu.');
                    showNativeToast(data.message || 'Bildirim iletilemedi.', false);
                    $btn.prop('disabled', false).html('<i class="fa fa-check mr-1"></i> Başlangıcı Bildir');
                }
            })
            .catch(err => {
                console.error(err);
                $errorDiv.removeClass('d-none').text('Sunucuyla iletişim kurulurken bir hata oluştu.');
                showNativeToast('Bağlantı hatası.', false);
                $btn.prop('disabled', false).html('<i class="fa fa-check mr-1"></i> Başlangıcı Bildir');
            });
        });

        // 2. BİTİŞİ BİLDİR AJAX
        $('#btnConfirmEnd').on('click', function () {
            const endKmVal = parseInt($('#inputEndKm').val(), 10);
            const minEndKm = @(Model.StartKm ?? Model.CurrentVehicleKm);
            const returnNotesVal = $('#inputReturnNotes').val();
            const $btn = $(this);
            const $errorDiv = $('#endErrorAlert');

            $errorDiv.addClass('d-none').text('');

            if (isNaN(endKmVal) || endKmVal < 0) {
                $errorDiv.removeClass('d-none').text('Lütfen geçerli bir bitiş kilometresi giriniz.');
                return;
            }

            if (endKmVal < minEndKm) {
                $errorDiv.removeClass('d-none').text('Bitiş KM (' + endKmVal + '), başlangıç kilometresinden (' + minEndKm + ') küçük olamaz.');
                return;
            }

            $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin mr-1"></i> Bildiriliyor...');

            fetch('/Surucu/Bitir/' + assignmentId, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({
                    endKm: endKmVal,
                    driverReturnNotes: returnNotesVal,
                    checkOil: $('#endCheckOil').is(':checked'),
                    checkWater: $('#endCheckWater').is(':checked'),
                    checkFuel: $('#endCheckFuel').is(':checked'),
                    checkHydraulic: $('#endCheckHydraulic').is(':checked'),
                    checkTires: $('#endCheckTires').is(':checked')
                })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showNativeToast(data.message || 'Bilgileriniz kaydedildi, Şef onayı bekleniyor.', true);
                    $('#endAssignmentModal').modal('hide');
                    setTimeout(() => {
                        window.location.reload();
                    }, 1000);
                } else {
                    $errorDiv.removeClass('d-none').text(data.message || 'Bir hata oluştu.');
                    showNativeToast(data.message || 'Bildirim iletilemedi.', false);
                    $btn.prop('disabled', false).html('<i class="fa fa-check mr-1"></i> Bitişi Bildir');
                }
            })
            .catch(err => {
                console.error(err);
                $errorDiv.removeClass('d-none').text('Sunucuyla iletişim kurulurken bir hata oluştu.');
                showNativeToast('Bağlantı hatası.', false);
                $btn.prop('disabled', false).html('<i class="fa fa-check mr-1"></i> Bitişi Bildir');
            });
        });

        // 3. KONTROLLERİ KAYDET AJAX
        $('#btnSaveVehicleChecks').on('click', function () {
            const $btn = $(this);
            const $errorDiv = $('#checksErrorAlert');
            $errorDiv.addClass('d-none').text('');

            $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin mr-1"></i> Kaydediliyor...');

            fetch('/Surucu/SaveVehicleChecks', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({
                    assignmentId: assignmentId,
                    checkOil: $('#modalCheckOil').is(':checked'),
                    checkWater: $('#modalCheckWater').is(':checked'),
                    checkFuel: $('#modalCheckFuel').is(':checked'),
                    checkHydraulic: $('#modalCheckHydraulic').is(':checked'),
                    checkTires: $('#modalCheckTires').is(':checked')
                })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showNativeToast(data.message || 'Araç kontrolleri başarıyla kaydedildi.', true);
                    $('#vehicleChecksModal').modal('hide');
                    setTimeout(() => {
                        window.location.reload();
                    }, 800);
                } else {
                    $errorDiv.removeClass('d-none').text(data.message || 'Kontroller kaydedilemedi.');
                    showNativeToast(data.message || 'Hata oluştu.', false);
                    $btn.prop('disabled', false).html('<i class="fa fa-save mr-1"></i> Kontrolleri Kaydet');
                }
            })
            .catch(err => {
                console.error(err);
                $errorDiv.removeClass('d-none').text('Sunucuyla iletişim kurulurken bir hata oluştu.');
                showNativeToast('Bağlantı hatası.', false);
                $btn.prop('disabled', false).html('<i class="fa fa-save mr-1"></i> Kontrolleri Kaydet');
            });
        });

        // 4. KART ÜZERİNDEN DOĞRUDAN DOKUNMATİK TİKLEME (INLINE TOGGLE - FAZ 3 / 2-A)
        $('.clickable-check-item').on('click', function () {
            const $item = $(this);
            if ($item.data('submitting') === true) return;

            const isCurrentlyChecked = $item.attr('data-checked') === 'true';
            const newChecked = !isCurrentlyChecked;
            $item.attr('data-checked', newChecked ? 'true' : 'false');

            // UI'ı anında iyimser (optimistic) olarak güncelle
            const $icon = $item.find('.check-icon');
            const $label = $item.find('.check-label');
            if (newChecked) {
                $icon.removeClass('fa-circle-o text-muted').addClass('fa-check-circle text-success');
                $label.removeClass('text-muted').addClass('text-dark');
                $item.css('background-color', '#e8f8f5');
            } else {
                $icon.removeClass('fa-check-circle text-success').addClass('fa-circle-o text-muted');
                $label.removeClass('text-dark').addClass('text-muted');
                $item.css('background-color', '#fff');
            }

            // Modal içindeki checkbox'ları da eşle
            const field = $item.attr('data-field');
            if (field === 'CheckOil') $('#modalCheckOil').prop('checked', newChecked);
            if (field === 'CheckWater') $('#modalCheckWater').prop('checked', newChecked);
            if (field === 'CheckFuel') $('#modalCheckFuel').prop('checked', newChecked);
            if (field === 'CheckHydraulic') $('#modalCheckHydraulic').prop('checked', newChecked);
            if (field === 'CheckTires') $('#modalCheckTires').prop('checked', newChecked);

            // Tüm tikleri topla
            const payload = {
                assignmentId: assignmentId,
                checkOil: $('[data-field="CheckOil"]').attr('data-checked') === 'true',
                checkWater: $('[data-field="CheckWater"]').attr('data-checked') === 'true',
                checkFuel: $('[data-field="CheckFuel"]').attr('data-checked') === 'true',
                checkHydraulic: $('[data-field="CheckHydraulic"]').attr('data-checked') === 'true',
                checkTires: $('[data-field="CheckTires"]').attr('data-checked') === 'true'
            };

            $item.data('submitting', true);

            fetch('/Surucu/SaveVehicleChecks', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(data => {
                $item.data('submitting', false);
                if (data.success) {
                    const allDone = payload.checkOil && payload.checkWater && payload.checkFuel && payload.checkHydraulic && payload.checkTires;
                    const $badge = $('#vehicleChecksStatusBadge');
                    if (allDone) {
                        $badge.removeClass('badge-warning').addClass('badge-success').html('<i class="fa fa-check mr-1"></i> Tamamlandı');
                    }
                    showNativeToast('Kontrol kaydedildi', true);
                } else {
                    // Geri al
                    $item.attr('data-checked', isCurrentlyChecked ? 'true' : 'false');
                    showNativeToast(data.message || 'Hata oluştu.', false);
                }
            })
            .catch(err => {
                $item.data('submitting', false);
                $item.attr('data-checked', isCurrentlyChecked ? 'true' : 'false');
                showNativeToast('Bağlantı hatası.', false);
            });
        });

        // 4. GÜZERGAH DEĞİŞTİR AJAX (FAZ 2 - B)
        $('#btnConfirmChangeRoute').on('click', function () {
            const newRouteVal = $('#inputNewRoute').val().trim();
            const newDestVal = $('#inputNewDestination').val().trim();
            const reasonVal = $('#inputRouteReason').val().trim();
            const $btn = $(this);
            const $errorDiv = $('#changeRouteErrorAlert');

            $errorDiv.addClass('d-none').text('');

            if (!newRouteVal) {
                $errorDiv.removeClass('d-none').text('Lütfen yeni güzergah / rota bilgisini giriniz.');
                return;
            }

            if (!reasonVal) {
                $errorDiv.removeClass('d-none').text('Lütfen güzergah değişikliği gerekçesini giriniz.');
                return;
            }

            $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin mr-1"></i> Güncelleniyor...');

            fetch('/Surucu/GuzergahDegistir/' + assignmentId, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({
                    assignmentId: assignmentId,
                    newRoute: newRouteVal,
                    newDestination: newDestVal,
                    reason: reasonVal
                })
            })
            .then(res => {
                if (res.status === 403) {
                    throw new Error('Bu görevde güzergah değişikliği yapma yetkiniz bulunmamaktadır (Yalnızca göreve atanmış şoförler yapabilir).');
                }
                return res.json();
            })
            .then(data => {
                if (data.success) {
                    showNativeToast(data.message || 'Güzergah değişikliği başarıyla kaydedildi.', true);
                    $('#changeRouteModal').modal('hide');
                    setTimeout(() => {
                        window.location.reload();
                    }, 1000);
                } else {
                    $errorDiv.removeClass('d-none').text(data.message || 'Güzergah güncellenemedi.');
                    showNativeToast(data.message || 'İşlem başarısız.', false);
                    $btn.prop('disabled', false).html('<i class="fa fa-save mr-1"></i> Güzergahı Güncelle');
                }
            })
            .catch(err => {
                console.error(err);
                $errorDiv.removeClass('d-none').text(err.message || 'Sunucuyla iletişim kurulurken bir hata oluştu.');
                showNativeToast(err.message || 'Bağlantı hatası.', false);
                $btn.prop('disabled', false).html('<i class="fa fa-save mr-1"></i> Güzergahı Güncelle');
            });
        });
    });
</script>
}
