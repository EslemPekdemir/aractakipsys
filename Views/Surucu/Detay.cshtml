                <button type="button" class="btn btn-outline-secondary" data-dismiss="modal" style="border-radius: 8px;">İptal</button>
                <button type="button" class="btn btn-primary font-weight-bold px-4" id="btnConfirmEnd" style="border-radius: 8px;">
