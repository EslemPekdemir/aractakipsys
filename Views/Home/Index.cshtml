        // FAZ 9: Aylık Takvim & Günlük Detay JavaScript Mantığı
        (function () {
            let currentYear = new Date().getFullYear();
            let currentMonth = new Date().getMonth() + 1;
            let monthCalendarData = null;
            let calendarInitialized = false;

            function escapeHtml(text) {
                if (!text) return '';
                return String(text)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            function loadCalendarData(year, month) {
                $('#calendarLoadingOverlay').css('display', 'flex');
                $('#calendarErrorMessage').hide();

                $.ajax({
                    url: '/Home/CalendarData',
                    type: 'GET',
                    data: { year: year, month: month },
                    dataType: 'json',
                    success: function (res) {
                        $('#calendarLoadingOverlay').hide();
                        if (res && res.success && res.data) {
                            monthCalendarData = res.data;
                            currentYear = res.data.year;
                            currentMonth = res.data.month;
                            $('#lblCurrentMonth').text(res.data.monthName);
                            renderCalendarGrid(res.data);
                        } else {
                            $('#calendarErrorMessage').text('Takvim yüklenemedi.').show();
                            console.error('Takvim verisi alınamadı veya geçersiz format:', res);
                            if (typeof toastr !== 'undefined') {
                                toastr.error('Takvim yüklenemedi.', 'Hata');
                            }
                        }
                    },
                    error: function (xhr, status, error) {
                        $('#calendarLoadingOverlay').hide();
                        $('#calendarErrorMessage').text('Takvim yüklenemedi. Sunucu hatası oluştu.').show();
                        console.error('Takvim AJAX isteği başarısız:', status, error, xhr);
                        if (typeof toastr !== 'undefined') {
                            toastr.error('Takvim yüklenemedi.', 'Hata');
                        }
                    }
                });
            }

            function renderCalendarGrid(data) {
                const $container = $('#dashboardCalendarDaysContainer');
                $container.empty();

                // Seçili gün detay panelini sıfırla
                $('#calendarDetailEmptyPrompt').show();
                $('#calendarDetailContentContainer').hide();
                $('#calendarDetailDateTitle').text('Seçili Gün Detayı');
                $('#calendarDetailStatusBadge').text('Gün Seçiniz').removeClass().addClass('badge badge-light border text-muted px-2 py-1 font-11');

                if (!data.days || data.days.length === 0) return;

                data.days.forEach(function (day) {
                    const otherMonthClass = day.isCurrentMonth ? '' : 'other-month';
                    const todayClass = day.isToday ? 'is-today' : '';
                    
                    let occupancyBadge = '';
                    if (day.activeVehicleCount > 0) {
                        occupancyBadge = `<span class="calendar-occupancy-badge busy" title="${day.activeVehicleCount} araç görevde / planlı"><i class="fa fa-car"></i> ${day.activeVehicleCount} Araç</span>`;
                    } else if (day.isCurrentMonth) {
                        occupancyBadge = `<span class="calendar-occupancy-badge empty">Boşta</span>`;
                    }

                    // Gösterge noktaları (Bakım, Belge, Ehliyet)
                    let dotIndicators = '<div class="calendar-dot-indicators">';
                    if (day.maintenanceVehicleCount > 0) {
                        dotIndicators += `<span class="calendar-mini-dot" style="background:#f8ac59;" title="${day.maintenanceVehicleCount} araç bakımda"></span>`;
                    }
                    if (day.expiringDocumentCount > 0) {
                        dotIndicators += `<span class="calendar-mini-dot" style="background:#ed5565;" title="${day.expiringDocumentCount} belge son günü"></span>`;
                    }
                    if (day.expiringLicenseCount > 0) {
                        dotIndicators += `<span class="calendar-mini-dot" style="background:#23c6c8;" title="${day.expiringLicenseCount} ehliyet süresi"></span>`;
                    }
                    dotIndicators += '</div>';

                    const dayHtml = `
                        <div class="calendar-day-cell ${otherMonthClass} ${todayClass}" data-date="${day.date}">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="calendar-day-num">${day.day}</span>
                                ${day.isToday ? '<span class="badge badge-primary py-0 px-1 font-10">Bugün</span>' : ''}
                            </div>
                            <div class="my-auto py-1">
                                ${occupancyBadge}
                            </div>
                            <div class="mt-auto pt-1 d-flex justify-content-between align-items-center">
                                ${dotIndicators}
                            </div>
                        </div>
                    `;
                    $container.append(dayHtml);
                });
            }

            // Güne tıklanınca modalın sağındaki entegre detay bölümünü doldur
            $(document).on('click', '.calendar-day-cell', function () {
                const dateKey = $(this).data('date');
                if (!monthCalendarData || !monthCalendarData.detailsByDate || !monthCalendarData.detailsByDate[dateKey]) {
                    return;
                }

                $('.calendar-day-cell').removeClass('selected-day');
                $(this).addClass('selected-day');

                const detail = monthCalendarData.detailsByDate[dateKey];
                renderDayDetailPanel(detail);
            });

            function renderDayDetailPanel(detail) {
                $('#calendarDetailEmptyPrompt').hide();
                $('#calendarDetailContentContainer').show();

                $('#calendarDetailDateTitle').text(detail.formattedDate);
                $('#calendarDetailStatusBadge')
                    .text((detail.activeVehicleCount > 0 ? (detail.activeVehicleCount + ' Araç Görevde') : 'Tüm Araçlar Boşta'))
                    .removeClass()
                    .addClass(detail.activeVehicleCount > 0 ? 'badge badge-primary text-white px-2 py-1 font-11' : 'badge badge-light border text-muted px-2 py-1 font-11');

                // Sayaçlar
                const totalAssignments = detail.assignments ? detail.assignments.length : 0;
                const totalMaintenances = detail.maintenances ? detail.maintenances.length : 0;
                const totalDocs = detail.expiringDocuments ? detail.expiringDocuments.length : 0;
                const totalLicenses = detail.expiringLicenses ? detail.expiringLicenses.length : 0;

                $('#modalCountAssignments').text(totalAssignments);
                $('#modalCountMaintenances').text(totalMaintenances);
                $('#modalCountDocs').text(totalDocs);
                $('#modalCountLicenses').text(totalLicenses);

                $('#modalBadgeAssignments').text(totalAssignments + ' Görev');
                $('#modalBadgeMaintenances').text(totalMaintenances + ' Bakım');
                $('#modalBadgeDocs').text(totalDocs + ' Belge');
                $('#modalBadgeLicenses').text(totalLicenses + ' Ehliyet');

                // 1) Görevler Listesi
                const $assignBox = $('#modalAssignmentsContent');
                if (totalAssignments === 0) {
                    $assignBox.html('<div class="text-center text-muted py-2 small bg-light rounded"><i class="fa fa-info-circle mr-1"></i> Bu tarihte görev bulunmuyor.</div>');
                } else {
                    let html = '<div class="table-responsive"><table class="table table-sm table-hover mb-0 calendar-detail-table"><thead class="thead-light font-11"><tr><th style="width:28%;">Araç</th><th style="width:30%;">Şoför</th><th style="width:22%;">Saat</th><th style="width:20%;" class="text-right">İşlem</th></tr></thead><tbody>';
                    detail.assignments.forEach(function (a) {
                        html += `
                            <tr>
                                <td class="align-middle">
                                    <strong class="text-primary font-12">${escapeHtml(a.vehiclePlate)}</strong>
                                    <small class="text-muted d-block font-10 text-truncate" title="${escapeHtml(a.vehicleBrandModel)}">${escapeHtml(a.vehicleBrandModel)}</small>
                                </td>
                                <td class="align-middle">
                                    <span class="text-dark font-11 font-weight-600 text-truncate d-block" title="${escapeHtml(a.driverNames)}">${escapeHtml(a.driverNames)}</span>
                                    <small class="text-muted d-block font-10 text-truncate" title="${escapeHtml(a.destination)}">${escapeHtml(a.destination)}</small>
                                </td>
                                <td class="align-middle small font-weight-bold">
                                    ${escapeHtml(a.startTime)}-${escapeHtml(a.endTime)}
                                    <span class="badge ${a.statusBadgeClass} px-1 py-0 font-10 d-block mt-1">${escapeHtml(a.statusDisplayName)}</span>
                                </td>
                                <td class="align-middle text-right">
                                    <a href="/Assignment/Details/${a.id}" class="btn btn-xs btn-outline-info" target="_blank" title="Görev Detayı">
                                        <i class="fa fa-external-link"></i> Detay
                                    </a>
                                </td>
                            </tr>
                        `;
                    });
                    html += '</tbody></table></div>';
                    $assignBox.html(html);
                }

                // 2) Bakımlar Listesi
                const $maintBox = $('#modalMaintenancesContent');
                if (totalMaintenances === 0) {
                    $maintBox.html('<div class="text-center text-muted py-2 small bg-light rounded"><i class="fa fa-info-circle mr-1"></i> Bu tarihte bakımda araç bulunmuyor.</div>');
                } else {
                    let html = '<div class="table-responsive"><table class="table table-sm table-hover mb-0 calendar-detail-table"><thead class="thead-light font-11"><tr><th style="width:35%;">Araç</th><th style="width:35%;">Bakım</th><th style="width:30%;" class="text-right">İşlem</th></tr></thead><tbody>';
                    detail.maintenances.forEach(function (m) {
                        html += `
                            <tr>
                                <td class="align-middle">
                                    <strong class="text-primary font-12">${escapeHtml(m.vehiclePlate)}</strong>
                                    <small class="text-muted d-block font-10 text-truncate" title="${escapeHtml(m.vehicleBrandModel)}">${escapeHtml(m.vehicleBrandModel)}</small>
                                </td>
                                <td class="align-middle font-11 text-dark">
                                    <div class="font-weight-bold text-truncate" title="${escapeHtml(m.maintenanceType)}">${escapeHtml(m.maintenanceType)}</div>
                                    <small class="text-muted d-block text-truncate" title="${escapeHtml(m.description)}">${escapeHtml(m.description)}</small>
                                </td>
                                <td class="align-middle text-right">
                                    <a href="/Maintenance" class="btn btn-xs btn-outline-warning" target="_blank" title="Bakım Sayfası">
                                        <i class="fa fa-wrench"></i> Git
                                    </a>
                                </td>
                            </tr>
                        `;
                    });
                    html += '</tbody></table></div>';
                    $maintBox.html(html);
                }

                // 3) Belgeler Listesi
                const $docBox = $('#modalDocsContent');
                if (totalDocs === 0) {
                    $docBox.html('<div class="text-center text-muted py-2 small bg-light rounded"><i class="fa fa-check-circle text-success mr-1"></i> Süresi dolan belge yoktur.</div>');
                } else {
                    let html = '<div class="table-responsive"><table class="table table-sm table-hover mb-0 calendar-detail-table"><thead class="thead-light font-11"><tr><th style="width:35%;">Araç</th><th style="width:35%;">Belge</th><th style="width:30%;" class="text-right">İşlem</th></tr></thead><tbody>';
                    detail.expiringDocuments.forEach(function (d) {
                        html += `
                            <tr>
                                <td class="align-middle">
                                    <strong class="text-primary font-12">${escapeHtml(d.vehiclePlate)}</strong>
                                    <small class="text-muted d-block font-10 text-truncate" title="${escapeHtml(d.vehicleBrandModel)}">${escapeHtml(d.vehicleBrandModel)}</small>
                                </td>
                                <td class="align-middle">
                                    <span class="badge ${d.badgeClass} px-2 py-0 font-10">${escapeHtml(d.documentType)}</span>
                                    <small class="text-muted d-block font-10">${escapeHtml(d.expiryDate)}</small>
                                </td>
                                <td class="align-middle text-right">
                                    <a href="/Vehicle/Details/${d.vehicleId}" class="btn btn-xs btn-outline-info" target="_blank" title="Araç Detayı">
                                        <i class="fa fa-eye"></i> İncele
                                    </a>
                                </td>
                            </tr>
                        `;
                    });
                    html += '</tbody></table></div>';
                    $docBox.html(html);
                }

                // 4) Ehliyetler Listesi
                const $licBox = $('#modalLicensesContent');
                if (totalLicenses === 0) {
                    $licBox.html('<div class="text-center text-muted py-2 small bg-light rounded"><i class="fa fa-check-circle text-success mr-1"></i> Süresi dolan ehliyet yoktur.</div>');
                } else {
                    let html = '<div class="table-responsive"><table class="table table-sm table-hover mb-0 calendar-detail-table"><thead class="thead-light font-11"><tr><th style="width:40%;">Şoför</th><th style="width:30%;">Sınıf / Bitiş</th><th style="width:30%;" class="text-right">İşlem</th></tr></thead><tbody>';
                    detail.expiringLicenses.forEach(function (l) {
                        html += `
                            <tr>
                                <td class="align-middle font-weight-bold text-dark font-12">
                                    <span class="text-truncate d-block" title="${escapeHtml(l.driverFullName)}">${escapeHtml(l.driverFullName)}</span>
                                </td>
                                <td class="align-middle">
                                    <span class="badge bg-light text-dark border font-10">${escapeHtml(l.licenseClass)}</span>
                                    <small class="text-danger font-weight-bold d-block">${escapeHtml(l.expiryDate)}</small>
                                </td>
                                <td class="align-middle text-right">
                                    <a href="/Driver/Details/${l.driverId}" class="btn btn-xs btn-outline-info" target="_blank" title="Şoför Detayı">
                                        <i class="fa fa-id-card"></i> İncele
                                    </a>
                                </td>
                            </tr>
                        `;
                    });
                    html += '</tbody></table></div>';
                    $licBox.html(html);
                }
            }

            // Ay Değiştirme Butonları
            $('#btnPrevMonth').on('click', function () {
                currentMonth--;
                if (currentMonth < 1) {
                    currentMonth = 12;
                    currentYear--;
                }
                loadCalendarData(currentYear, currentMonth);
            });

            $('#btnNextMonth').on('click', function () {
                currentMonth++;
                if (currentMonth > 12) {
                    currentMonth = 1;
                    currentYear++;
                }
                loadCalendarData(currentYear, currentMonth);
            });

            $('#btnTodayMonth').on('click', function () {
                currentYear = new Date().getFullYear();
                currentMonth = new Date().getMonth() + 1;
                loadCalendarData(currentYear, currentMonth);
            });

            // LAZY LOAD: Sayfa açılışında değil, SADECE modal ilk açıldığında veriyi çek
            $('#dashboardCalendarModal').on('shown.bs.modal', function () {
                if (!calendarInitialized) {
                    loadCalendarData(currentYear, currentMonth);
                    calendarInitialized = true;
                }
            });
        })();
    </script>
}
