@section Scripts {
    <!-- INSPINIA BUNDLED CHART.JS SCRIPT -->
    <script src="~/js/plugins/chartJs/Chart.min.js"></script>
    <script>
        $(document).ready(function () {
            var totalVehicles = @Model.TotalVehicles;
            if (totalVehicles > 0) {
                var doughnutData = {
                    labels: ["Boşta", "Görevde", "Bakımda", "Hizmet Dışı", "Belgesi Geçersiz"],
                    datasets: [{
                        data: [@Model.ChartIdleCount, @Model.ChartOnDutyCount, @Model.ChartMaintenanceCount, @Model.ChartOutOfServiceCount, @Model.ChartDocumentExpiredCount],
                        backgroundColor: ["#1ab394", "#1c84c6", "#f8ac59", "#ed5565", "#721c24"],
                        hoverBackgroundColor: ["#18a689", "#1a7bb9", "#f7a54a", "#ec4758", "#501217"]
                    }]
                };

                // DOM'da tekil yüzen HTML Tooltip
                var $tooltip = $('#donutFloatingTooltip');
                if ($tooltip.length === 0) {
                    $tooltip = $('<div id="donutFloatingTooltip"></div>').css({
                        position: 'absolute',
                        display: 'none',
                        'z-index': 99999,
                        'pointer-events': 'none',
                        background: '#0f172a',
                        color: '#ffffff',
                        padding: '6px 12px',
                        'border-radius': '6px',
                        'font-size': '12px',
                        'font-weight': '600',
                        'box-shadow': '0 8px 24px rgba(15, 23, 42, 0.45)',
                        border: '1px solid rgba(255, 255, 255, 0.2)',
                        'white-space': 'nowrap',
                        'font-family': "'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif"
                    }).appendTo('body');
                }

                var doughnutOptions = {
                    responsive: true,
                    maintainAspectRatio: false,
                    legend: {
                        display: false
                    },
                    tooltips: {
                        enabled: false, // Canvas sınırından kesilmemesi için HTML tooltip kullanıyoruz
                        custom: function (tooltipModel) {
                            if (!tooltipModel || tooltipModel.opacity === 0) {
                                $tooltip.hide();
                                return;
                            }

                            // İçerik (Renkli nokta + Durum + Araç Sayısı + Yüzde)
                            if (tooltipModel.body && tooltipModel.body.length > 0) {
                                var line = tooltipModel.body[0].lines[0];
                                var color = (tooltipModel.labelColors && tooltipModel.labelColors[0]) 
                                    ? tooltipModel.labelColors[0].backgroundColor 
                                    : '#1ab394';

                                $tooltip.html('<span style="display:inline-block;width:9px;height:9px;border-radius:50%;background-color:' + color + ';margin-right:7px;vertical-align:middle;"></span><span style="vertical-align:middle;">' + line + '</span>');
                            }

                            // Canvas koordinatını güvenle al (this._chart yerine doğrudan ID üzerinden)
                            var canvasEl = document.getElementById('fleetDoughnutChart');
                            if (!canvasEl) return;
                            var rect = canvasEl.getBoundingClientRect();
                            var scrollLeft = window.pageXOffset || document.documentElement.scrollLeft;
                            var scrollTop = window.pageYOffset || document.documentElement.scrollTop;

                            var tipWidth = $tooltip.outerWidth() || 140;
                            var tipHeight = $tooltip.outerHeight() || 32;

                            var posX = rect.left + scrollLeft + tooltipModel.caretX - (tipWidth / 2);
                            var posY = rect.top + scrollTop + tooltipModel.caretY - tipHeight - 10;

                            if (tooltipModel.caretY < 40) {
                                posY = rect.top + scrollTop + tooltipModel.caretY + 14;
                            }

                            $tooltip.css({
                                left: posX + 'px',
                                top: posY + 'px'
                            }).show();
                        },
                        callbacks: {
                            label: function(tooltipItem, data) {
                                var dataset = data.datasets[tooltipItem.datasetIndex];
                                var total = dataset.data.reduce(function(prev, curr) { return prev + curr; }, 0);
                                var current = dataset.data[tooltipItem.index];
                                var percentage = total > 0 ? Math.round((current / total) * 100) : 0;
                                return data.labels[tooltipItem.index] + ': ' + current + ' Araç (%' + percentage + ')';
                            }
                        }
                    },
                    cutoutPercentage: 70,
                    animation: {
                        animateScale: true
                    }
                };

                var ctx = document.getElementById("fleetDoughnutChart").getContext("2d");
                new Chart(ctx, {
                    type: 'doughnut',
