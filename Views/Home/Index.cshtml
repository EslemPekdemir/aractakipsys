                                    <div>
                                        <div class="text-muted small font-11"><i class="fa fa-calendar-check-o text-success mr-1"></i> Muayene Bitiş</div>
                                        <strong class="text-dark font-13">${new Date(vehicle.inspectionExpiryDate).toLocaleDateString('tr-TR')}</strong>
                                    </div>
                                    <div>${inspBadge}</div>
                                </div>
                            </div>
                            <div class="col-12 col-md-4 mb-2">
                                <div class="p-2 border rounded bg-light d-flex justify-content-between align-items-center flex-wrap" style="gap: 4px;">
                                    <div>
                                        <div class="text-muted small font-11"><i class="fa fa-circle-o-notch text-primary mr-1"></i> Güncel Lastik</div>
                                        <strong class="text-dark font-13">${vehicle.currentTire ? escapeHtml(vehicle.currentTire.brand + (vehicle.currentTire.size ? ' (' + vehicle.currentTire.size + ')' : '')) : (escapeHtml(vehicle.tireBrand || 'Belirtilmedi'))}</strong>
                                    </div>
                                    <div>
                                        ${vehicle.currentTire 
                                            ? `<span class="badge ${vehicle.currentTire.statusBadgeClass || (vehicle.currentTire.isAlert ? 'badge-danger' : 'badge-secondary')} px-2 py-1">${escapeHtml(vehicle.currentTire.statusDisplayName || 'Normal')}</span>` 
                                            : `<span class="badge badge-secondary px-2 py-1">${escapeHtml(vehicle.tireSeason || '-')}</span>`}
                                    </div>
