                        const kmInfo = h.totalKm ? `<strong>${h.totalKm} km</strong> <small class="text-muted">(${h.startKm} - ${h.endKm})</small>` : (h.endKm ? `${h.endKm} km` : '-');
                        const phone = h.driverPhone ? `<div class="text-muted small font-11"><i class="fa fa-phone mr-1"></i>${escapeHtml(h.driverPhone)}</div>` : '';
                        
