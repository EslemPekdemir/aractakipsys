                $btnSearch.prop('disabled', true).html('<i class="fa fa-spinner fa-spin mr-1"></i> Aranıyor...');
                $resultContainer.removeClass('d-none').html(`
                    <div class="text-center py-4 text-muted">
                        <i class="fa fa-circle-o-notch fa-spin fa-2x text-primary mb-2"></i>
