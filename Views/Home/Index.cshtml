<!-- File: Views/Home/Index.cshtml -->
@model aractakipsys.Models.ViewModels.Dashboard.DashboardViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard - Filo Yönetim Paneli";
}

@section Styles {
    <style>
        .kpi-card-link {
            text-decoration: none !important;
            color: inherit !important;
            display: block;
            height: 100%;
        }
        .kpi-card-link:hover, .kpi-card-link:focus {
            text-decoration: none !important;
            color: inherit !important;
        }
        .kpi-card {
            transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
            cursor: pointer;
            border-radius: 8px;
            background: #ffffff;
        }
        .kpi-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 22px rgba(0, 0, 0, 0.12) !important;
        }
        .kpi-card:hover .kpi-arrow-icon {
            transform: translateX(4px);
        }
        .kpi-arrow-icon {
            transition: transform 0.2s ease-in-out;
            display: inline-block;
        }
        /* Dashboard KPI Kartları - Yalnızca Mobilde (max-width: 768px) Kompakt Düzen */
        @@media (max-width: 768px) {
            .dashboard-kpi-row .ibox-title {
                padding: 5px 8px 2px 8px !important;
            }
            .dashboard-kpi-row .kpi-title {
                font-size: 0.64rem !important;
            }
            .dashboard-kpi-row .kpi-badge {
                font-size: 0.55rem !important;
                padding: 1px 3px !important;
            }
            .dashboard-kpi-row .ibox-content {
                padding: 3px 8px 6px 8px !important;
            }
            .dashboard-kpi-row .kpi-number {
                font-size: 1.25rem !important;
                margin-bottom: 1px !important;
            }
            .dashboard-kpi-row .ibox-content small {
                font-size: 0.60rem !important;
            }
            .dashboard-kpi-row .kpi-status-badges {
                display: none !important;
            }
            /* Hızlı Operasyonel Eylemler & Şoför Kutusu Mobil Şıklaştırılması */
            .quick-actions-btn {
                padding: 6px 6px !important;
                font-size: 0.70rem !important;
                border-radius: 6px !important;
            }
            .quick-actions-btn i {
                font-size: 0.75rem !important;
            }
            .driver-availability-box {
                padding: 6px 8px !important;
                margin-bottom: 8px !important;
            }
            .driver-availability-box h5 {
                font-size: 0.88rem !important;
            }
            /* Donut Grafik ve Legend Mobil Uyumu */
            .fleet-donut-wrapper {
                height: 120px !important;
                max-width: 120px !important;
            }
            .fleet-donut-center-num {
                font-size: 18px !important;
            }
            .fleet-donut-center-lbl {
                font-size: 8px !important;
            }
            .fleet-legend-list li {
                padding-top: 2px !important;
                padding-bottom: 2px !important;
                font-size: 11px !important;
            }
        }

        /* Donut Grafik ile Birebir Eşleşen Belge Uyarı Renk Sistemi */
        .badge-doc-expired {
            background-color: #721c24 !important;
            color: #ffffff !important;
        }
        .badge-doc-warning {
            background-color: #d97706 !important;
            color: #ffffff !important;
        }
        .border-doc-expired {
            border-left: 4px solid #721c24 !important;
        }
        .border-doc-warning {
            border-left: 4px solid #d97706 !important;
        }

        /* Kurumsal Tipografi ve Boyut Hizalamaları */
        .font-10 { font-size: 10px !important; }
        .font-11 { font-size: 11px !important; }
        .font-12 { font-size: 12px !important; }
        .font-13 { font-size: 13px !important; }
        .font-14 { font-size: 14px !important; }
        .font-weight-600 { font-weight: 600 !important; }

        /* 1. Görevler Tablosu İçin Tam 6 Satırlık Sabit Yükseklik & Kaydırma Çubuğu */
        .tasks-table-scroll {
            max-height: 390px;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: #cbd5e1 #f8fafc;
        }
        .tasks-table-scroll::-webkit-scrollbar {
            width: 6px;
        }
        .tasks-table-scroll::-webkit-scrollbar-track {
            background: #f8fafc;
            border-radius: 4px;
        }
        .tasks-table-scroll::-webkit-scrollbar-thumb {
            background-color: #cbd5e1;
            border-radius: 4px;
        }
        .tasks-table-scroll::-webkit-scrollbar-thumb:hover {
            background-color: #94a3b8;
        }
        .tasks-table-scroll thead th {
            position: sticky;
            top: 0;
            z-index: 2;
            background-color: #f8f9fa !important;
            box-shadow: inset 0 -1px 0 #dee2e6;
        }

        /* 2. Belge Süresi Uyarıları İçin Tam 5 Satırlık Sabit Yükseklik & Kaydırma Çubuğu */
        .doc-alerts-table-scroll {
            max-height: 355px;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: #cbd5e1 #f8fafc;
        }
        .doc-alerts-table-scroll::-webkit-scrollbar {
            width: 6px;
        }
        .doc-alerts-table-scroll::-webkit-scrollbar-track {
            background: #f8fafc;
            border-radius: 4px;
        }
        .doc-alerts-table-scroll::-webkit-scrollbar-thumb {
            background-color: #cbd5e1;
            border-radius: 4px;
        }
        .doc-alerts-table-scroll::-webkit-scrollbar-thumb:hover {
            background-color: #94a3b8;
        }
        .doc-alerts-table-scroll thead th {
            position: sticky;
            top: 0;
            z-index: 2;
            background-color: #f8f9fa !important;
            box-shadow: inset 0 -1px 0 #dee2e6;
        }

        /* 3. Devam Eden Bakımlar Tablosu İçin Tam 6-7 Satırlık Sabit Yükseklik & Kaydırma Çubuğu */
        .maintenances-table-scroll {
            max-height: 385px;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: #cbd5e1 #f8fafc;
        }
        .maintenances-table-scroll::-webkit-scrollbar {
            width: 6px;
        }
        .maintenances-table-scroll::-webkit-scrollbar-track {
            background: #f8fafc;
            border-radius: 4px;
        }
        .maintenances-table-scroll::-webkit-scrollbar-thumb {
            background-color: #cbd5e1;
            border-radius: 4px;
        }
        .maintenances-table-scroll::-webkit-scrollbar-thumb:hover {
            background-color: #94a3b8;
        }
        .maintenances-table-scroll thead th {
            position: sticky;
            top: 0;
            z-index: 2;
            background-color: #f8f9fa !important;
            box-shadow: inset 0 -1px 0 #dee2e6;
        }

        /* Dashboard Araç Tıklama Efekti */
        .clickable-vehicle {
            cursor: pointer !important;
            transition: all 0.15s ease-in-out;
            border-radius: 4px;
            padding: 2px 4px;
            margin: -2px -4px;
        }
        .clickable-vehicle:hover {
            background-color: #f0f7fd !important;
        }
        .clickable-vehicle:hover .vehicle-plate-text {
            color: #0d6efd !important;
            text-decoration: underline !important;
        }

        /* FAZ 9: Büyük Takvim Modalı Boyut & Yerleşim Kuralları */
        .calendar-modal-dialog {
            width: 95vw !important;
            max-width: 1600px !important;
            margin: 2vh auto !important;
        }
        .calendar-modal-content {
            max-height: 92vh !important;
            height: 92vh !important;
            display: flex !important;
            flex-direction: column !important;
        }
        .calendar-modal-body {
            overflow-x: hidden !important;
            overflow-y: hidden !important;
            display: flex !important;
            flex-direction: column !important;
            flex: 1 1 auto !important;
            padding: 10px 14px !important;
        }
        .calendar-columns-row {
            display: flex !important;
            flex: 1 1 auto !important;
            min-height: 0 !important;
            margin-left: -6px !important;
            margin-right: -6px !important;
        }
        .calendar-col-left {
            flex: 0 0 65% !important;
            max-width: 65% !important;
            padding-left: 6px !important;
            padding-right: 6px !important;
            display: flex !important;
            flex-direction: column !important;
            min-height: 0 !important;
            min-width: 0 !important;
        }
        .calendar-col-right {
            flex: 0 0 35% !important;
            max-width: 35% !important;
            padding-left: 6px !important;
            padding-right: 6px !important;
            display: flex !important;
            flex-direction: column !important;
            min-height: 0 !important;
            min-width: 0 !important;
        }
        .calendar-left-scroll-pane {
            flex: 1 1 auto !important;
            overflow-y: auto !important;
            overflow-x: hidden !important;
            min-height: 0 !important;
        }
        .calendar-right-scroll-pane {
            flex: 1 1 auto !important;
            overflow-y: auto !important;
            overflow-x: hidden !important;
            min-height: 0 !important;
        }

        /* 7 Eşit Sütunlu Aylık Takvim Izgarası */
        .dashboard-calendar-grid {
            display: grid !important;
            grid-template-columns: repeat(7, minmax(0, 1fr)) !important;
            gap: 4px !important;
            width: 100% !important;
            box-sizing: border-box !important;
        }
        .calendar-day-header {
            text-align: center;
            font-weight: 700;
            font-size: 0.80rem;
            color: #475569;
            padding: 5px 0;
            background: #f8fafc;
            border-radius: 4px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .calendar-day-cell {
            min-height: 76px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            padding: 3px 4px;
            cursor: pointer;
            transition: all 0.18s ease-in-out;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            overflow: hidden;
            min-width: 0 !important;
            box-sizing: border-box !important;
        }
        .calendar-day-cell:hover {
            border-color: #1ab394;
            box-shadow: 0 4px 12px rgba(26, 179, 148, 0.18);
            transform: translateY(-2px);
            z-index: 2;
        }
        .calendar-day-cell.other-month {
            background-color: #f8fafc;
            opacity: 0.45;
        }
        .calendar-day-cell.is-today {
            border: 2px solid #1ab394 !important;
            background-color: #f0fdf9 !important;
        }
        .calendar-day-cell.selected-day {
            border: 2px solid #1c84c6 !important;
            background-color: #f0f7fd !important;
        }
        .calendar-day-num {
            font-size: 0.78rem;
            font-weight: 700;
            color: #1e293b;
            line-height: 1;
        }
        .calendar-occupancy-badge {
            font-size: 0.68rem;
            font-weight: 700;
            padding: 2px 3px;
            border-radius: 8px;
            display: block;
            text-align: center;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            max-width: 100%;
            line-height: 1.2;
        }
        .calendar-occupancy-badge.busy {
            background-color: #1c84c6;
            color: #ffffff;
        }
        .calendar-occupancy-badge.empty {
            background-color: #f1f5f9;
            color: #94a3b8;
        }
        .calendar-dot-indicators {
            display: flex;
            gap: 2px;
            align-items: center;
            flex-wrap: wrap;
            max-width: 100%;
        }
        .calendar-mini-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            display: inline-block;
            flex-shrink: 0;
        }

        /* Detay Paneli Tablo Sığdırma */
        .calendar-detail-table {
            table-layout: fixed !important;
            width: 100% !important;
        }
        .calendar-detail-table th, .calendar-detail-table td {
            overflow: hidden !important;
            text-overflow: ellipsis !important;
            white-space: nowrap !important;
            padding: 4px 6px !important;
        }

        /* Responsive Medya Kuralları */
        @@media (max-width: 1199.98px) {
            .calendar-col-left {
                flex: 0 0 60% !important;
                max-width: 60% !important;
            }
            .calendar-col-right {
                flex: 0 0 40% !important;
                max-width: 40% !important;
            }
        }

        @@media (max-width: 991.98px) {
            .calendar-modal-dialog {
                width: 98vw !important;
                max-width: 98vw !important;
                margin: 1vh auto !important;
            }
            .calendar-modal-content {
                max-height: 98vh !important;
                height: 98vh !important;
            }
            .calendar-modal-body {
                overflow-y: auto !important;
                display: block !important;
                padding: 8px !important;
            }
            .calendar-columns-row {
                flex-direction: column !important;
                display: block !important;
                margin-left: 0 !important;
                margin-right: 0 !important;
            }
            .calendar-col-left, .calendar-col-right {
                flex: 0 0 100% !important;
                max-width: 100% !important;
                padding-left: 0 !important;
                padding-right: 0 !important;
                display: block !important;
                margin-bottom: 12px !important;
            }
            .calendar-left-scroll-pane, .calendar-right-scroll-pane {
                overflow-y: visible !important;
                max-height: none !important;
            }
            .calendar-day-cell {
                min-height: 54px;
                padding: 2px;
            }
            .calendar-day-num {
                font-size: 0.68rem;
            }
            .calendar-occupancy-badge {
                font-size: 0.56rem;
                padding: 1px 2px;
            }
            .calendar-day-header {
                font-size: 0.68rem;
                padding: 3px 0;
            }
            .calendar-header-toolbar {
                flex-direction: column !important;
                align-items: stretch !important;
                gap: 6px !important;
            }
            .calendar-header-toolbar > div {
                justify-content: center !important;
            }
        }

        @@media (max-width: 576px) {
            .calendar-modal-body {
                padding: 4px !important;
            }
            .dashboard-calendar-grid {
                gap: 2px !important;
            }
            .calendar-day-cell {
                min-height: 48px;
                padding: 1px;
                border-radius: 4px;
            }
            .calendar-day-num {
                font-size: 0.62rem;
            }
            .calendar-occupancy-badge {
                font-size: 0.50rem;
                padding: 1px 1px;
                border-radius: 4px;
            }
            .calendar-day-header {
                font-size: 0.60rem;
                padding: 2px 0;
            }
            .calendar-mini-dot {
                width: 4px;
                height: 4px;
            }
        }
    </style>
}

<!-- OTOMATİK SİSTEM UYARISI TOAST BİLDİRİMİ (NATIVE BOOTSTRAP TOAST) -->
@if (User.IsInRole("Admin") || User.IsInRole("Kullanici") || User.IsInRole("DaireBaskani") || User.IsInRole("GenelSekreter"))
{
    <div aria-live="polite" aria-atomic="true" class="position-fixed" style="top: 25px; right: 25px; z-index: 99999; width: 380px; max-width: calc(100vw - 40px); pointer-events: none;">
        <div id="dashboardAlertToast" class="toast shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" data-delay="3000" data-autohide="true"
             style="background: #ffffff; border-radius: 10px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.18) !important; border-left: 5px solid #ed5565 !important; display: none; pointer-events: auto;">
            <div class="toast-header bg-light d-flex justify-content-between align-items-center py-2 px-3 border-bottom">
                <div class="d-flex align-items-center">
                    <span class="badge badge-danger p-1 mr-2 text-white" style="border-radius: 6px;">
                        <i class="fa fa-bell"></i>
                    </span>
                    <strong class="mr-auto text-dark font-13 font-weight-bold">Sistem Uyarısı</strong>
                </div>
                <div class="d-flex align-items-center">
                    <small class="text-muted mr-2 font-11">Şimdi</small>
                    <button type="button" class="close ml-1 text-muted" data-dismiss="toast" aria-label="Kapat" style="outline: none; opacity: 0.7; font-size: 1.3rem;">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            </div>
            <div class="toast-body p-2" id="dashboardToastItemsContainer">
                <!-- Son gelen bildirimlerden 2 tanesi tıklanabilir kart olarak _AdminLayout.cshtml tarafından yerleştirilir -->
            </div>
        </div>
    </div>
}

<!-- SAYFA BAŞLIĞI -->
<div class="row wrapper border-bottom white-bg page-heading mb-4 align-items-center" style="padding: 14px 20px !important;">
    <div class="col-sm-7 col-md-8">
        <h2 class="font-weight-bold mb-1 mt-0" style="font-size: 1.5rem; line-height: 1.2;">Filo Operasyon Yönetim Paneli</h2>
        <ol class="breadcrumb mb-0 p-0" style="background: transparent; font-size: 0.85rem;">
            <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
            <li class="breadcrumb-item active"><strong>Dashboard</strong></li>
        </ol>
    </div>
    <div class="col-sm-5 col-md-4 text-right d-flex align-items-center justify-content-start justify-content-sm-end flex-wrap mt-2 mt-sm-0" style="gap: 10px;">
        <span class="text-muted small mb-0 d-inline-flex align-items-center d-none d-lg-inline-flex" style="font-size: 0.85rem; white-space: nowrap;">
            <i class="fa fa-calendar text-primary mr-2"></i> @DateTime.Now.ToString("dd MMMM yyyy, dddd")
        </span>
        <button type="button" class="btn btn-outline-primary font-weight-bold shadow-sm mb-0 d-inline-flex align-items-center" id="btnOpenDashboardCalendar" data-toggle="modal" data-target="#dashboardCalendarModal" style="height: 36px; padding: 0 14px; border-radius: 6px; font-size: 0.85rem; white-space: nowrap;">
            <i class="fa fa-calendar mr-2"></i> Takvim
        </button>
        <a href="/Assignment/Create" class="btn btn-primary font-weight-bold shadow-sm mb-0 d-inline-flex align-items-center" style="height: 36px; padding: 0 16px; border-radius: 6px; font-size: 0.85rem; white-space: nowrap;">
            <i class="fa fa-plus-circle mr-2"></i> Yeni Görev Ata
        </a>
    </div>
</div>



@if (User.IsInRole("Admin") || User.IsInRole("Kullanici") || User.IsInRole("DaireBaskani") || User.IsInRole("GenelSekreter"))
{
    <!-- HIZLI PLAKA ARAMA ÇUBUĞU (AŞAMA D) -->
    <div class="ibox float-e-margins mb-3 shadow-sm border" style="border-radius: 8px; border-color: #e7eaec !important; background: #ffffff;">
        <div class="ibox-content p-2 px-3 border-0" style="border-radius: 8px;">
            <div class="row align-items-center">
                <div class="col-12 col-md-8 col-lg-6">
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-light text-primary border-right-0" style="border-top-left-radius: 6px; border-bottom-left-radius: 6px; height: 36px; padding: 0 10px;">
                                <i class="fa fa-search"></i>
                            </span>
                        </div>
                        <input type="text" id="dashboardPlateSearchInput" class="form-control text-uppercase font-weight-bold" 
                               placeholder="Plaka (örn: 81 DU 001)..." 
                               style="height: 36px; font-size: 0.88rem; letter-spacing: 0.8px; border-left: 0;">
                        <div class="input-group-append">
                            <button type="button" id="btnDashboardPlateSearch" class="btn btn-primary font-weight-bold px-3" style="height: 36px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; font-size: 0.82rem;">
                                <i class="fa fa-search mr-1"></i> Plaka Ara
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- DİNAMİK ARAMA SONUCU PANELİ -->
            <div id="dashboardPlateSearchResultContainer" class="mt-2 d-none"></div>
        </div>
    </div>
}

<!-- 1. SIRA: 4 ÖZET KPI KARTI (MOBİLDE 2x2 KOMPAKT DÜZEN, MASAÜSTÜNDE 4 SÜTUN) -->
<div class="row mb-3 dashboard-kpi-row">
    <!-- KART 1: TOPLAM ARAÇ & DURUM DAĞILIMI -->
    <div class="col-6 col-md-6 col-xl-3 mb-2 mb-xl-0 px-1 px-sm-3">
        <a href="/Vehicle" class="kpi-card-link" title="Tüm araç filosu listesini görüntüle">
            <div class="ibox float-e-margins mb-0 h-100 shadow-sm border-left border-primary kpi-card d-flex flex-column justify-content-between" style="border-left-width: 4px !important;">
                <div class="ibox-title pb-1 border-0 d-flex justify-content-between align-items-center">
                    <h5 class="text-muted text-uppercase mb-0 font-weight-bold kpi-title">Toplam Araç</h5>
                    <span class="label label-primary font-weight-bold kpi-badge">Filo</span>
                </div>
                <div class="ibox-content pt-1 pt-sm-2 d-flex flex-column justify-content-between flex-grow-1">
                    <div>
                        <h1 class="no-margins font-weight-bold text-dark mb-1 kpi-number">@Model.TotalVehicles</h1>
                        <small class="text-muted font-11 text-truncate d-block d-md-none">@Model.IdleVehicles müsait &bull; @Model.OnDutyVehicles görevde</small>
                        <div class="d-none d-md-flex flex-wrap gap-1 mt-1 mb-1 kpi-status-badges">
                            <span class="badge badge-success px-1 px-sm-2 py-0 mr-1 mb-1 font-11" title="Boşta / Müsait">
                                <i class="fa fa-check mr-1"></i> @Model.IdleVehicles Müsait
                            </span>
                            <span class="badge badge-primary px-1 px-sm-2 py-0 mr-1 mb-1 font-11" title="Görevde / Seyirde">
                                <i class="fa fa-road mr-1"></i> @Model.OnDutyVehicles Görevde
                            </span>
                            <span class="badge badge-warning text-dark px-1 px-sm-2 py-0 mr-1 mb-1 font-11" title="Bakımda / Serviste">
                                <i class="fa fa-wrench mr-1"></i> @Model.MaintenanceVehicles Bakımda
                            </span>
                            @if (Model.DocumentExpiredVehicles > 0)
                            {
                                <span class="badge badge-danger px-1 px-sm-2 py-0 mr-1 mb-1 font-11" title="Belgesi Geçersiz" style="background-color: #721c24 !important;">
                                    <i class="fa fa-exclamation-triangle mr-1"></i> @Model.DocumentExpiredVehicles Belgesi Geçersiz
                                </span>
                            }
                            @if (Model.OutOfServiceVehicles > 0)
                            {
                                <span class="badge badge-danger px-1 px-sm-2 py-0 mr-1 mb-1 font-11" title="Hizmet Dışı">
                                    <i class="fa fa-ban mr-1"></i> @Model.OutOfServiceVehicles Hizmet Dışı
                                </span>
                            }
                        </div>
                    </div>
                    <div class="pt-2 border-top mt-auto d-none d-md-flex align-items-center justify-content-between kpi-footer">
                        <span class="small font-weight-bold text-primary">
                            Araçları Listele <i class="fa fa-arrow-right ml-1 kpi-arrow-icon"></i>
                        </span>
                        <small class="text-muted font-11">Tüm Filo</small>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- KART 2: AKTİF GÖREVLER (INPROGRESS) -->
    <div class="col-6 col-md-6 col-xl-3 mb-2 mb-xl-0 px-1 px-sm-3">
        <a href="/Assignment?Status=InProgress" class="kpi-card-link" title="Seyir halindeki görevleri görüntüle">
            <div class="ibox float-e-margins mb-0 h-100 shadow-sm border-left border-info kpi-card d-flex flex-column justify-content-between" style="border-left-width: 4px !important;">
                <div class="ibox-title pb-1 border-0 d-flex justify-content-between align-items-center">
                    <h5 class="text-muted text-uppercase mb-0 font-weight-bold kpi-title">Aktif Görevler</h5>
                    <span class="label label-info font-weight-bold kpi-badge">Canlı</span>
                </div>
                <div class="ibox-content pt-1 pt-sm-2 d-flex flex-column justify-content-between flex-grow-1">
                    <div>
                        <h1 class="no-margins font-weight-bold text-info mb-1 kpi-number">@Model.ActiveAssignmentsCount</h1>
                        <small class="text-muted font-11 text-truncate d-block">Şu an seyir halindeki araçlar</small>
                    </div>
                    <div class="pt-2 border-top mt-auto d-none d-md-flex align-items-center justify-content-between kpi-footer">
                        <span class="small font-weight-bold text-info">
                            Detayları Gör <i class="fa fa-arrow-right ml-1 kpi-arrow-icon"></i>
                        </span>
                        <small class="text-muted font-11">Seyirde</small>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- KART 3: PLANLANAN GÖREVLER -->
    <div class="col-6 col-md-6 col-xl-3 mb-2 mb-xl-0 px-1 px-sm-3">
        <a href="/Assignment?Status=Planned" class="kpi-card-link" title="Başlamayı bekleyen planlı görevleri görüntüle">
            <div class="ibox float-e-margins mb-0 h-100 shadow-sm border-left border-warning kpi-card d-flex flex-column justify-content-between" style="border-left-width: 4px !important;">
                <div class="ibox-title pb-1 border-0 d-flex justify-content-between align-items-center">
                    <h5 class="text-muted text-uppercase mb-0 font-weight-bold kpi-title">Planlanan Görevler</h5>
                    <span class="label label-warning font-weight-bold kpi-badge">Planlı</span>
                </div>
                <div class="ibox-content pt-1 pt-sm-2 d-flex flex-column justify-content-between flex-grow-1">
                    <div>
                        <h1 class="no-margins font-weight-bold text-warning mb-1 kpi-number">@Model.TodayPlannedAssignmentsCount</h1>
                        <small class="text-muted font-11 text-truncate d-block">Bugün bekleyen planlı görevler</small>
                    </div>
                    <div class="pt-2 border-top mt-auto d-none d-md-flex align-items-center justify-content-between kpi-footer">
                        <span class="small font-weight-bold text-warning">
                            Planları Listele <i class="fa fa-arrow-right ml-1 kpi-arrow-icon"></i>
                        </span>
                        <small class="text-muted font-11">Beklemede</small>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- KART 4: BAKIMDAKİ ARAÇLAR -->
    <div class="col-6 col-md-6 col-xl-3 mb-2 mb-xl-0 px-1 px-sm-3">
        <a href="/Maintenance?IsOngoing=true" class="kpi-card-link" title="Devam eden açık bakım kayıtlarını görüntüle">
            <div class="ibox float-e-margins mb-0 h-100 shadow-sm border-left border-danger kpi-card d-flex flex-column justify-content-between" style="border-left-width: 4px !important;">
                <div class="ibox-title pb-1 border-0 d-flex justify-content-between align-items-center">
                    <h5 class="text-muted text-uppercase mb-0 font-weight-bold kpi-title">Bakımdaki Araçlar</h5>
                    <span class="label label-danger font-weight-bold kpi-badge">Servis</span>
                </div>
                <div class="ibox-content pt-1 pt-sm-2 d-flex flex-column justify-content-between flex-grow-1">
                    <div>
                        <h1 class="no-margins font-weight-bold text-danger mb-1 kpi-number">@Model.OngoingMaintenancesCount</h1>
                        <small class="text-muted font-11 text-truncate d-block">Serviste devam eden kayıtlar</small>
                    </div>
                    <div class="pt-2 border-top mt-auto d-none d-md-flex align-items-center justify-content-between kpi-footer">
                        <span class="small font-weight-bold text-danger">
                            Bakımları İncele <i class="fa fa-arrow-right ml-1 kpi-arrow-icon"></i>
                        </span>
                        <small class="text-muted font-11">Açık Servis</small>
                    </div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- 2. SIRA: GÖRSEL KÖPRÜ & İKİ SÜTUNLU OPERASYONEL TABLOLAR (SOL: 7, SAĞ: 5) -->
<div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between p-2 px-3 mb-3 bg-white border rounded shadow-sm">
    <div class="d-flex align-items-center mb-1 mb-sm-0">
        <span class="badge badge-primary px-2 py-1 mr-2 text-white font-weight-bold" style="border-radius: 6px; font-size: 0.78rem;">
            <i class="fa fa-dashboard mr-1"></i> Canlı Operasyon
        </span>
        <strong class="text-dark" style="font-size: 0.95rem;">
            Canlı Filo Durumu & Belge Takip Masası
        </strong>
    </div>
    <div class="text-muted small" style="font-size: 0.8rem;">
        <i class="fa fa-circle text-info mr-1" style="font-size: 8px;"></i> Anlık görev seyri ve kritik belge geçerlilik bildirimleri
    </div>
</div>

<div class="row mb-4">
    <!-- SOL: DEVAM EDEN VE PLANLANAN GÖREVLER (GENİŞLİK: 7 - ANLIK GERÇEK ZAMANLI BİLGİ) -->
    <div class="col-lg-7 mb-4 mb-lg-0">
        <div class="ibox float-e-margins shadow-sm mb-0 h-100 border-left border-info" style="border-left-width: 4px !important;">
            <div class="ibox-title d-flex justify-content-between align-items-center">
                <h5>
                    <i class="fa fa-road mr-1 text-info"></i> Devam Eden & Planlanan Görevler
                </h5>
                <a href="/Assignment" class="btn btn-xs btn-outline-secondary font-weight-bold">
                    Tüm Görevleri Gör (@Model.ActiveAssignments.Count) <i class="fa fa-chevron-right ml-1"></i>
                </a>
            </div>
            <div class="ibox-content p-0">
                @if (Model.ActiveAssignments.Count == 0)
                {
                    <div class="text-center py-5">
                        <i class="fa fa-check-circle text-muted mb-2" style="font-size: 2.2rem; opacity: 0.4;"></i>
                        <h6 class="font-weight-bold text-secondary">Aktif Görev Bulunmuyor</h6>
                        <p class="text-muted small mb-3">Bugün devam eden veya planlanan görev yoktur.</p>
                        <a href="/Assignment/Create" class="btn btn-sm btn-primary">
                            <i class="fa fa-plus-circle mr-1"></i> Görev Oluştur
                        </a>
                    </div>
                }
                else
                {
                    <div class="table-responsive tasks-table-scroll">
                        <table class="table table-hover mb-0">
                            <thead class="bg-light text-dark font-12">
                                <tr>
                                    <th>Araç</th>
                                    <th>Şoför</th>
                                    <th>Saat</th>
                                    <th>Hedef / Görev</th>
                                    <th class="text-center">Durum</th>
                                    <th class="text-right">İşlem</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in Model.ActiveAssignments)
                                {
                                    <tr class="@(a.Status == AssignmentStatus.InProgress ? "table-info font-weight-600" : "")">
                                        <td class="align-middle">
                                            <div class="clickable-vehicle d-inline-block" data-plate="@a.VehiclePlate" role="button" title="Araç Özellik & Bilgi Kartını Aç (@a.VehiclePlate)">
                                                <span class="font-weight-bold text-primary font-13 vehicle-plate-text">@a.VehiclePlate</span>
                                                <small class="text-muted d-block font-11">@a.VehicleBrandModel</small>
                                            </div>
                                        </td>
                                        <td class="align-middle">
                                            <span class="font-weight-bold text-dark font-12">@a.DriverFullName</span>
                                            @if (!string.IsNullOrWhiteSpace(a.DriverPhone))
                                            {
                                                <small class="text-muted d-block font-11">@a.DriverPhone</small>
                                            }
                                        </td>
                                        <td class="align-middle small">
                                            @if (a.ActualStartTime.HasValue)
                                            {
                                                <span class="text-success font-weight-bold font-12">@a.ActualStartTime.Value.ToString("HH:mm")</span>
                                                <small class="text-muted d-block font-10">Başladı</small>
                                            }
                                            else
                                            {
                                                if (a.PlannedStartTime.Date != DateTime.Today)
                                                {
                                                    <span class="text-dark font-weight-bold font-12">@a.PlannedStartTime.ToString("dd.MM HH:mm")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-dark font-weight-bold font-12">@a.PlannedStartTime.ToString("HH:mm")</span>
                                                }
                                                <small class="text-muted d-block font-10">Planlanan</small>
                                            }
                                        </td>
                                        <td class="align-middle small">
                                            <span class="font-weight-600 text-dark font-12 text-truncate d-inline-block" style="max-width: 140px;" title="@a.Purpose">
                                                @(string.IsNullOrWhiteSpace(a.Purpose) ? "-" : a.Purpose)
                                            </span>
                                            @if (!string.IsNullOrWhiteSpace(a.RequestedByDepartment))
                                            {
                                                <small class="text-muted d-block font-11">Birim: @a.RequestedByDepartment</small>
                                            }
                                        </td>
                                        <td class="align-middle text-center">
                                            @if (a.Status == AssignmentStatus.InProgress)
                                            {
                                                <span class="badge badge-primary bg-primary text-white px-2 py-1 font-11" style="border-radius: 10px;">
                                                    <i class="fa fa-spinner fa-spin mr-1"></i> Seyirde
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge @a.StatusBadgeClass px-2 py-1 font-11" style="border-radius: 10px;">
                                                    @a.StatusDisplayName
                                                </span>
                                            }
                                        </td>
                                        <td class="align-middle text-right">
                                            <a href="/Assignment/Details/@a.Id" class="btn btn-xs btn-outline-info font-weight-bold">
                                                <i class="fa fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- SAĞ: BELGE SÜRESİ YAKLAŞAN / GEÇEN ARAÇLAR (GENİŞLİK: 5 - GÜNLÜK TAKİP BİLGİSİ) -->
    <div class="col-lg-5">
        <div class="ibox float-e-margins shadow-sm mb-0 h-100 @(Model.DocumentAlertVehicles.Any(x => x.HasAnyExpired) ? "border-doc-expired" : "border-doc-warning")">
            <div class="ibox-title d-flex justify-content-between align-items-center">
                <h5>
                    <i class="fa fa-exclamation-triangle mr-1" style="color: @(Model.DocumentAlertVehicles.Any(x => x.HasAnyExpired) ? "#721c24" : "#d97706");"></i> 
                    Belge Süresi Uyarıları
                    @if (Model.DocumentAlertVehiclesCount > 0)
                    {
                        <span class="badge ml-2 font-12 text-white @(Model.DocumentAlertVehicles.Any(x => x.HasAnyExpired) ? "badge-doc-expired" : "badge-doc-warning")">
                            @Model.DocumentAlertVehiclesCount Araç
                        </span>
                    }
                </h5>
                <a href="/Vehicle" class="btn btn-xs btn-outline-secondary font-weight-bold">
                    Tüm Araçları Gör (@Model.DocumentAlertVehiclesCount) <i class="fa fa-chevron-right ml-1"></i>
                </a>
            </div>
            <div class="ibox-content p-0">
                @if (Model.DocumentAlertVehiclesCount == 0)
                {
                    <div class="text-center py-5">
                        <i class="fa fa-check-circle text-success mb-2" style="font-size: 2.2rem; opacity: 0.6;"></i>
                        <h6 class="font-weight-bold text-dark">Tüm Belgeler Geçerli</h6>
                        <p class="text-muted small mb-0">30 gün içinde muayene veya sigortası dolacak araç bulunmuyor.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive doc-alerts-table-scroll">
                        <table class="table table-hover mb-0">
                            <thead class="bg-light text-dark font-12">
                                <tr>
                                    <th>Araç</th>
                                    <th>Fenni Muayene</th>
                                    <th>Trafik Sigortası</th>
                                    <th class="text-center">Durum</th>
                                    <th class="text-right">İşlem</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.DocumentAlertVehicles)
                                {
                                    <tr class="@item.RowClass">
                                        <td class="align-middle">
                                            <div class="clickable-vehicle d-inline-block" data-plate="@item.PlateNumber" role="button" title="Araç Özellik & Bilgi Kartını Aç (@item.PlateNumber)">
                                                <span class="font-weight-bold text-primary font-13 vehicle-plate-text">@item.PlateNumber</span>
                                                <span class="badge text-white font-10 px-1 py-0 ml-1 @item.StatusBadgeClass" style="border-radius: 6px;">
                                                    @item.StatusDisplayName
                                                </span>
                                                <small class="text-muted d-block font-11">@item.BrandModel</small>
                                            </div>
                                        </td>
                                        <td class="align-middle">
                                            <div class="font-weight-bold text-dark font-12">@item.InspectionExpiryDate.ToString("dd.MM.yyyy")</div>
                                            @if (item.InspectionDaysRemaining < 0)
                                            {
                                                <span class="badge text-white px-2 py-0 font-10 badge-doc-expired">
                                                    <i class="fa fa-times-circle mr-1"></i>@(Math.Abs(item.InspectionDaysRemaining)) gün geçti
                                                </span>
                                            }
                                            else if (item.InspectionDaysRemaining <= 30)
                                            {
                                                <span class="badge text-white px-2 py-0 font-10 badge-doc-warning">
                                                    <i class="fa fa-clock-o mr-1"></i>@(item.InspectionDaysRemaining == 0 ? "Bugün!" : $"{item.InspectionDaysRemaining} gün")
                                                </span>
                                            }
                                            else
                                            {
                                                <small class="text-muted font-10">@item.InspectionDaysRemaining gün</small>
                                            }
                                        </td>
                                        <td class="align-middle">
                                            <div class="font-weight-bold text-dark font-12">@item.InsuranceExpiryDate.ToString("dd.MM.yyyy")</div>
                                            @if (item.InsuranceDaysRemaining < 0)
                                            {
                                                <span class="badge text-white px-2 py-0 font-10 badge-doc-expired">
                                                    <i class="fa fa-times-circle mr-1"></i>@(Math.Abs(item.InsuranceDaysRemaining)) gün geçti
                                                </span>
                                            }
                                            else if (item.InsuranceDaysRemaining <= 30)
                                            {
                                                <span class="badge text-white px-2 py-0 font-10 badge-doc-warning">
                                                    <i class="fa fa-clock-o mr-1"></i>@(item.InsuranceDaysRemaining == 0 ? "Bugün!" : $"{item.InsuranceDaysRemaining} gün")
                                                </span>
                                            }
                                            else
                                            {
                                                <small class="text-muted font-10">@item.InsuranceDaysRemaining gün</small>
                                            }
                                        </td>
                                        <td class="align-middle text-center">
                                            <span class="badge px-2 py-1 font-11 text-white @(item.HasAnyExpired ? "badge-doc-expired" : "badge-doc-warning")" style="border-radius: 10px;">
                                                <i class="fa @(item.HasAnyExpired ? "fa-exclamation-circle" : "fa-clock-o") mr-1"></i>
                                                @item.AlertStatusText
                                            </span>
                                        </td>
                                        <td class="align-middle text-right">
                                            <div class="btn-group">
                                                <a href="/Vehicle/Details/@item.VehicleId" class="btn btn-xs btn-outline-info" title="Araç Detayı">
                                                    <i class="fa fa-eye"></i>
                                                </a>
                                                <a href="/Vehicle/Edit/@item.VehicleId" class="btn btn-xs btn-outline-warning" title="Belge Tarihlerini Güncelle">
                                                    <i class="fa fa-pencil"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- FAZ 4: ŞOFÖR EHLİYET SÜRESİ UYARI KARTI -->
<div class="row mb-4">
    <div class="col-lg-12">
        <div class="ibox float-e-margins shadow-sm mb-0 @(Model.ExpiringDriverLicenses.Any(x => x.IsExpired) ? "border-doc-expired" : (Model.ExpiringDriverLicensesCount > 0 ? "border-doc-warning" : ""))" style="border-left-width: 4px !important;">
            <div class="ibox-title d-flex justify-content-between align-items-center">
                <h5>
                    <i class="fa fa-id-card mr-1" style="color: @(Model.ExpiringDriverLicenses.Any(x => x.IsExpired) ? "#721c24" : "#d97706");"></i>
                    Şoför Ehliyet Süresi Uyarıları
                    @if (Model.ExpiringDriverLicensesCount > 0)
                    {
                        <span class="badge ml-2 font-12 text-white @(Model.ExpiringDriverLicenses.Any(x => x.IsExpired) ? "badge-doc-expired" : "badge-doc-warning")">
                            @Model.ExpiringDriverLicensesCount Ehliyet
                        </span>
                    }
                </h5>
                <a href="/Driver" class="btn btn-xs btn-outline-secondary font-weight-bold">
                    Tüm Şoförleri Gör (@Model.TotalDrivers) <i class="fa fa-chevron-right ml-1"></i>
                </a>
            </div>
            <div class="ibox-content p-0">
                @if (Model.ExpiringDriverLicensesCount == 0)
                {
                    <div class="text-center py-4">
                        <i class="fa fa-check-circle text-success mb-2" style="font-size: 2.2rem; opacity: 0.6;"></i>
                        <h6 class="font-weight-bold text-dark">Tüm Şoför Ehliyetleri Geçerli</h6>
                        <p class="text-muted small mb-0">30 gün içinde geçerlilik süresi dolacak veya süresi geçmiş şoför ehliyeti bulunmuyor.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive doc-alerts-table-scroll">
                        <table class="table table-hover mb-0">
                            <thead class="bg-light text-dark font-12">
                                <tr>
                                    <th>Şoför</th>
                                    <th>Birim</th>
                                    <th>Ehliyet Sınıfı</th>
                                    <th>Son Geçerlilik Tarihi</th>
                                    <th class="text-center">Kalan Gün / Durum</th>
                                    <th class="text-right">İşlem</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.ExpiringDriverLicenses)
                                {
                                    <tr class="@item.RowClass">
                                        <td class="align-middle font-weight-bold text-dark font-13">
                                            <a href="/Driver/Details/@item.DriverId" class="text-primary font-weight-bold">
                                                <i class="fa fa-user mr-1"></i>@item.DriverFullName
                                            </a>
                                        </td>
                                        <td class="align-middle text-muted small">
                                            @(item.Department ?? "-")
                                        </td>
                                        <td class="align-middle font-weight-bold">
                                            <span class="badge bg-light text-dark border font-12">@item.LicenseClass</span>
                                        </td>
                                        <td class="align-middle font-weight-bold text-dark font-12">
                                            @item.LicenseExpiryDate.ToString("dd.MM.yyyy")
                                        </td>
                                        <td class="align-middle text-center">
                                            <span class="badge px-2 py-1 font-11 @item.BadgeClass" style="border-radius: 10px;">
                                                <i class="fa @(item.IsExpired ? "fa-exclamation-circle" : "fa-clock-o") mr-1"></i>
                                                @item.StatusText
                                            </span>
                                        </td>
                                        <td class="align-middle text-right">
                                            <a href="/Driver/Details/@item.DriverId" class="btn btn-xs btn-outline-info font-weight-bold" title="Şoför Detayını Gör">
                                                <i class="fa fa-eye mr-1"></i> İncele
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- 3. SIRA: DEVAM EDEN BAKIMLAR & HIZLI İŞLEMLER / ŞOFÖR DURUMU -->
<div class="row">
    <!-- SOL: DEVAM EDEN / AÇIK BAKIMLAR -->
    <div class="col-lg-7 mb-4 mb-lg-0">
        <div class="ibox float-e-margins shadow-sm mb-0 border-left border-warning" style="border-left-width: 4px !important;">
            <div class="ibox-title d-flex justify-content-between align-items-center">
                <h5>
                    <i class="fa fa-wrench mr-1 text-warning"></i> Devam Eden / Açık Bakımlar
                </h5>
                <a href="/Maintenance?IsOngoing=true" class="btn btn-xs btn-outline-secondary font-weight-bold">
                    Tüm Bakımları Gör (@Model.OngoingMaintenancesCount) <i class="fa fa-chevron-right ml-1"></i>
                </a>
            </div>
            <div class="ibox-content p-0">
                @if (Model.OngoingMaintenances.Count == 0)
                {
                    <div class="text-center py-4">
                        <i class="fa fa-shield text-success mb-2" style="font-size: 2.2rem; opacity: 0.6;"></i>
                        <h6 class="font-weight-bold text-dark">Bakımda Araç Bulunmuyor</h6>
                        <p class="text-muted small mb-0">Tüm araçların bakımları tamamlanmış durumdadır.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive maintenances-table-scroll">
                        <table class="table table-hover mb-0">
                            <thead class="bg-light text-dark font-12">
                                <tr>
                                    <th>Araç</th>
                                    <th>Bakım Türü</th>
                                    <th>Giriş Tarihi</th>
                                    <th>Süre</th>
                                    <th>Servis / Firma</th>
                                    <th class="text-right">İşlem</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in Model.OngoingMaintenances)
                                {
                                    <tr>
                                        <td class="align-middle">
                                            <div class="clickable-vehicle d-inline-block" data-plate="@m.VehiclePlate" role="button" title="Araç Özellik & Bilgi Kartını Aç (@m.VehiclePlate)">
                                                <span class="font-weight-bold text-primary font-13 vehicle-plate-text">@m.VehiclePlate</span>
                                                <small class="text-muted d-block font-11">@m.VehicleBrandModel</small>
                                            </div>
                                        </td>
                                        <td class="align-middle font-weight-600 text-dark">
                                            @m.MaintenanceType
                                        </td>
                                        <td class="align-middle small font-weight-bold">
                                            @m.StartDate.ToString("dd.MM.yyyy")
                                        </td>
                                        <td class="align-middle small">
                                            <span class="badge badge-warning text-dark px-2 py-1 font-11 font-weight-bold" style="border-radius: 10px;">
                                                @m.DurationDays gündür
                                            </span>
                                        </td>
                                        <td class="align-middle small text-muted">
                                            @(string.IsNullOrWhiteSpace(m.PerformedBy) ? "-" : m.PerformedBy)
                                        </td>
                                        <td class="align-middle text-right">
                                            <a href="/Maintenance/Details/@m.Id" class="btn btn-xs btn-outline-info font-weight-bold" title="Bakım Detayı">
                                                <i class="fa fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- SAĞ: FİLO DURUM DAĞILIMI VE HIZLI EYLEMLER -->
    <div class="col-lg-5">
        <!-- ARAÇ FİLO DURUM DAĞILIMI (CHART.JS DOUGHNUT) -->
        <div class="ibox float-e-margins shadow-sm mb-3">
            <div class="ibox-title d-flex justify-content-between align-items-center">
                <h5><i class="fa fa-pie-chart mr-1 text-primary"></i> Filo Durum Dağılımı</h5>
                <span class="badge badge-primary px-2 py-1 font-weight-bold font-11">@Model.TotalVehicles Araç</span>
            </div>
            <div class="ibox-content p-3">
                @{
                    int total = Model.TotalVehicles;
                    int idle = Model.IdleVehicles;
                    int onDuty = Model.OnDutyVehicles;
                    int maint = Model.MaintenanceVehicles;
                    int oos = Model.OutOfServiceVehicles;
                    int docExp = Model.DocumentExpiredVehicles;

                    int idlePct = total > 0 ? (int)Math.Round((double)idle * 100 / total) : 0;
                    int onDutyPct = total > 0 ? (int)Math.Round((double)onDuty * 100 / total) : 0;
                    int maintPct = total > 0 ? (int)Math.Round((double)maint * 100 / total) : 0;
                    int oosPct = total > 0 ? (int)Math.Round((double)oos * 100 / total) : 0;
                    int docExpPct = total > 0 ? (int)Math.Round((double)docExp * 100 / total) : 0;

                    int activeUsageCount = onDuty + maint;
                    int activeUsagePct = total > 0 ? (int)Math.Round((double)activeUsageCount * 100 / total) : 0;
                }
                @if (total == 0)
                {
                    <div class="py-5 text-center text-muted my-auto">
                        <i class="fa fa-car mb-2" style="font-size: 2rem;"></i>
                        <p class="small mb-0">Kayıtlı araç bulunamadı.</p>
                    </div>
                }
                else
                {

                    <div class="row align-items-center">
                        <!-- SOL: KÜÇÜK DONUT GRAFİĞİ -->
                        <div class="col-sm-5 col-12 text-center mb-3 mb-sm-0">
                            <div class="fleet-donut-wrapper" style="position: relative; height: 150px; max-width: 150px; margin: 0 auto;">
                                <canvas id="fleetDoughnutChart"></canvas>
                                <!-- DONUT MERKEZİNDE TOPLAM ARAÇ SAYISI -->
                                <div id="donutCenterText" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; pointer-events: none; line-height: 1.15; z-index: 10;">
                                    <div class="font-weight-bold text-dark fleet-donut-center-num" style="font-size: 24px; letter-spacing: -0.5px;">@total</div>
                                    <small class="text-muted font-weight-bold text-uppercase fleet-donut-center-lbl" style="font-size: 9.5px; letter-spacing: 0.5px; display: block; white-space: nowrap;">Toplam Araç</small>
                                </div>
                            </div>
                        </div>

                        <!-- SAĞ: DİKEY LEGEND LİSTESİ VE KULLANIM METRİĞİ -->
                        <div class="col-sm-7 col-12 pl-sm-2">
                            <ul class="list-unstyled mb-0 fleet-legend-list" style="font-size: 12px; line-height: 1.6;">
                                <li class="d-flex justify-content-between align-items-center py-1 px-2 border-bottom">
                                    <span><i class="fa fa-circle mr-1" style="color: #1ab394;"></i> <strong>Boşta:</strong></span>
                                    <span class="font-weight-bold text-dark">@idle <span class="text-muted font-weight-normal">(%@idlePct)</span></span>
                                </li>
                                <li class="d-flex justify-content-between align-items-center py-1 px-2 border-bottom">
                                    <span><i class="fa fa-circle mr-1" style="color: #1c84c6;"></i> <strong>Görevde:</strong></span>
                                    <span class="font-weight-bold text-dark">@onDuty <span class="text-muted font-weight-normal">(%@onDutyPct)</span></span>
                                </li>
                                <li class="d-flex justify-content-between align-items-center py-1 px-2 border-bottom">
                                    <span><i class="fa fa-circle mr-1" style="color: #f8ac59;"></i> <strong>Bakımda:</strong></span>
                                    <span class="font-weight-bold text-dark">@maint <span class="text-muted font-weight-normal">(%@maintPct)</span></span>
                                </li>
                                <li class="d-flex justify-content-between align-items-center py-1 px-2 border-bottom">
                                    <span><i class="fa fa-circle mr-1" style="color: #ed5565;"></i> <strong>Hizmet Dışı:</strong></span>
                                    <span class="font-weight-bold text-dark">@oos <span class="text-muted font-weight-normal">(%@oosPct)</span></span>
                                </li>
                                <li class="d-flex justify-content-between align-items-center py-1 px-2 rounded @(docExp > 0 ? "mt-1" : "")" @(docExp > 0 ? "style=\"background-color: #fdf2f2; border: 1px solid #f8b4b4;\"" : "")>
                                    <span class="@(docExp > 0 ? "text-danger" : "")">
                                        <i class="fa fa-circle mr-1" style="color: #721c24;"></i> <strong>Belgesi Geçersiz:</strong>
                                    </span>
                                    <span class="font-weight-bold @(docExp > 0 ? "text-danger" : "text-dark")">
                                        @docExp <span class="@(docExp > 0 ? "text-danger font-weight-bold" : "text-muted font-weight-normal")">(%@docExpPct)</span>
                                    </span>
                                </li>
                            </ul>

                            <!-- SAĞ ALT KÖŞE MİNİ METRİK: FİLO KULLANIM ORANI -->
                            <div class="mt-2 pt-2 border-top d-flex justify-content-between align-items-center flex-wrap" style="gap: 4px;">
                                <small class="text-muted font-weight-bold" style="font-size: 11px;">
