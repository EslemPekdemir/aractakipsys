                        <!-- ÜST SATIR: PLAKA, MARKA/MODEL VE KAPATMA BUTONU -->
                        <div class="d-flex justify-content-between align-items-start border-bottom pb-2 mb-2">
                            <div class="d-flex align-items-center flex-wrap" style="gap: 8px;">
                                <div class="px-2 py-1 font-weight-bold text-dark border border-dark rounded d-inline-flex align-items-center shadow-sm" 
                                     style="background: #ffffff; letter-spacing: 1.5px; font-size: 1.15rem; border-width: 2px !important;">
                                    <span class="text-white px-1 py-0 mr-1 rounded font-10" style="background-color: #003399;">TR</span>
                                    ${escapeHtml(vehicle.plateNumber)}
                                </div>
                                <div>
                                    <h4 class="font-weight-bold mb-0 text-dark font-15">${escapeHtml(vehicle.brandModel)}</h4>
                                    <div class="small text-muted font-11">
                                        <span>${vehicle.year} Model</span> &bull; 
                                        <span>${escapeHtml(vehicle.color)}</span> &bull; 
                                        <span><i class="fa fa-tachometer mr-1"></i>${vehicle.currentKm.toLocaleString('tr-TR')} KM</span>
