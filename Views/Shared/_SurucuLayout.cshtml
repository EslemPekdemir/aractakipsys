<!-- File: Views/Shared/_SurucuLayout.cshtml -->
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>@ViewData["Title"] - Şoför Paneli</title>

    <link href="~/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/font-awesome/css/font-awesome.css" rel="stylesheet">
    <style>
        *, ::before, ::after {
            box-sizing: border-box;
        }
        html, body {
            width: 100%;
            max-width: 100vw;
            overflow-x: hidden;
            margin: 0;
            padding: 0;
            -webkit-text-size-adjust: 100%;
        }
        body {
            background-color: #f3f4f6;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            color: #1f2937;
            padding-bottom: 70px;
            min-height: 100vh;
        }
        .driver-header {
            background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 100%);
            color: #ffffff;
            padding: 10px 14px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
            position: sticky;
            top: 0;
            z-index: 1000;
            width: 100%;
            box-sizing: border-box;
        }
        .driver-header-inner {
            max-width: 620px;
            margin: 0 auto;
            width: 100%;
        }
        .driver-container {
            width: 100%;
            max-width: 620px;
            margin: 0 auto;
            padding: 14px 12px;
            box-sizing: border-box;
        }
        .btn-touch {
            min-height: 50px;
            font-size: 1.1rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            transition: all 0.2s ease-in-out;
        }
        .btn-touch:active {
            transform: scale(0.98);
        }
        .card-custom {
            border: none;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
            background: #ffffff;
            margin-bottom: 14px;
            overflow: hidden;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }
        .card-custom:active {
            transform: scale(0.99);
        }
        .emergency-card-btn:active {
            transform: scale(0.98);
        }
        .badge-status {
            font-size: 0.8rem;
            padding: 5px 10px;
            border-radius: 20px;
            font-weight: 600;
            white-space: nowrap;
        }
        .btn-xs {
            padding: 4px 8px;
            font-size: 0.75rem;
            line-height: 1.4;
            border-radius: 6px;
        }
        .btn-primary {
            background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 100%) !important;
            border-color: #1e3a8a !important;
            color: #ffffff !important;
        }
        .btn-primary:hover, .btn-primary:focus, .btn-primary:active {
            background: linear-gradient(135deg, #172554 0%, #1e3a8a 100%) !important;
            border-color: #172554 !important;
            color: #ffffff !important;
        }
        .text-primary {
            color: #1e40af !important;
        }
        .bg-primary {
            background-color: #1e40af !important;
            color: #ffffff;
        }
        .border-primary {
            border-color: #1e40af !important;
        }
        .bg-success {
            background-color: #10b981 !important;
            color: #ffffff;
        }
        .bg-secondary {
            background-color: #6b7280 !important;
            color: #ffffff;
        }
        .bg-warning {
            background-color: #f59e0b !important;
            color: #ffffff;
        }
        .bg-danger {
            background-color: #ef4444 !important;
            color: #ffffff;
        }
        #nativeToastAlert {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 1050;
            min-width: 280px;
            max-width: 90%;
            display: none;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            border-radius: 10px;
        }
        @@media (max-width: 576px) {
            .driver-header {
                padding: 8px 10px;
            }
            .driver-container {
                padding: 10px 8px;
            }
            .card-custom {
                padding: 12px !important;
                margin-bottom: 12px;
                border-radius: 10px;
            }
            .modal-dialog {
                margin: 8px;
            }
            .modal-body {
                padding: 14px !important;
            }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- NATIVE TOAST BİLDİRİMİ -->
    <div id="nativeToastAlert" class="alert text-white text-center py-2 px-3 m-0" role="alert">
        <span id="nativeToastMessage"></span>
    </div>

    <!-- ÜST BİLGİ VE BAŞLIK ÇUBUĞU (MOBİL ÖNCELİKLİ) -->
    <header class="driver-header">
        <div class="driver-header-inner d-flex justify-content-between align-items-center">
            <div style="min-width: 0; flex: 1;">
                <h5 class="m-0 font-weight-bold text-truncate" style="letter-spacing: -0.3px; font-size: 1.05rem;">
                    <i class="fa fa-car mr-1 text-warning"></i> DÜ Araç Takip
                </h5>
                <small class="text-white-50 d-block text-truncate" style="font-size: 0.75rem;">Şoför Görevlendirme Portalı</small>
            </div>
            <div class="d-flex align-items-center flex-shrink-0 ml-2">
                <a href="/Surucu/ChangePassword" class="btn btn-outline-light btn-sm mr-1 px-2 py-1" style="border-radius: 6px; font-size: 0.8rem;" title="Şifre Değiştir">
                    <i class="fa fa-key"></i> <span class="d-none d-sm-inline ml-1">Şifre</span>
                </a>
                <a href="/Account/Logout" class="btn btn-outline-light btn-sm px-2 py-1" style="border-radius: 6px; font-size: 0.8rem;" title="Güvenli Çıkış">
                    <i class="fa fa-sign-out"></i> <span class="d-none d-sm-inline ml-1">Çıkış</span>
                </a>
            </div>
        </div>
    </header>

    <!-- TEK SÜTUN MOBİL AKIŞ İÇERİĞİ -->
    <main class="driver-container">
        @RenderBody()
    </main>

    <script src="~/js/jquery-3.1.1.min.js"></script>
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/bootstrap.js"></script>
    <script>
        // Native Toast Bildirim Fonksiyonu (Harici kütüphanesiz)
        function showNativeToast(message, isSuccess = true) {
            const $toast = $('#nativeToastAlert');
            $toast.removeClass('bg-success bg-danger')
                  .addClass(isSuccess ? 'bg-success' : 'bg-danger');
            $('#nativeToastMessage').html((isSuccess ? '<i class="fa fa-check-circle mr-1"></i> ' : '<i class="fa fa-exclamation-triangle mr-1"></i> ') + message);
            $toast.stop(true, true).fadeIn(200);
            setTimeout(() => {
                $toast.fadeOut(400);
            }, 3000);
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
